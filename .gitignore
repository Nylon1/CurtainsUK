# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Shopify Phase 4A source/working copies and upstream repository-only files
/shopify-theme/_exported-dawn-16/
/shopify-theme/_phase4a-preserve/
/shopify-theme/curtainsuk-dawn-16/.github/
/shopify-theme/curtainsuk-dawn-16/.prettierrc.json
/shopify-theme/curtainsuk-dawn-16/LICENSE.md
/shopify-theme/curtainsuk-dawn-16/README.md
/shopify-theme/curtainsuk-dawn-16/release-notes.md
/shopify-theme/curtainsuk-dawn-16/*.zip

# Local rehearsal output can include ephemeral signed request URLs.
/artifacts/phase5e/email-local-server.log

# Resumable supplier downloads; only sanitised reports belong in Git.
/artifacts/phase5f/*.html
/artifacts/phase5f/checkpoints/
/artifacts/phase5f/media/
