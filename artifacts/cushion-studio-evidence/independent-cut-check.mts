/** Independent geometric invariants. Commercial terms below are TEST FIXTURES ONLY. */
import assert from 'node:assert/strict';
import fs from 'node:fs';
import {buildSetCutPlan} from '../../lib/cushion-studio/cutting';
import {parseCushionSpec} from '../../lib/cushion-studio/domain';

const rows=JSON.parse(fs.readFileSync(new URL('./source-records.json',import.meta.url),'utf8'));
const evidence=JSON.parse(fs.readFileSync(new URL('../../config/cushion-studio-fabric-evidence.json',import.meta.url),'utf8')).fabrics;
const rules={version:'INDEPENDENT-TEST-ONLY',seamAllowanceMm:20,confirmed:true,pipingStripWidthMm:null,pipingJoinAllowanceMm:null,pipingCut:null,pipingConfirmed:false};
function facts(id:string){const f=rows.find((r:any)=>r.fabric.id===id).fabric,e=evidence[id];return{id,fullWidthMm:f.fullWidthMm,usableWidthMm:null,pattern:{kind:f.verticalRepeatMm===0&&f.horizontalRepeatMm===0?'plain':'straight',horizontalRepeatMm:f.horizontalRepeatMm,verticalRepeatMm:f.verticalRepeatMm},directional:e.directional??null,calibration:{imageUrl:e.originalImageUrl,physicalWidthMm:f.fullWidthMm,physicalHeightMm:1000,sourceHash:e.sourceHash,evidence:e.evidence,orientation:'upright',tileable:false},supplierCostMinorPerMetre:null,orderIncrementMetres:0.1,minimumOrderMetres:0,availableMetres:100};}
const checks:any[]=[];
function check(name:string,run:()=>void){try{run();checks.push({name,passed:true});}catch(e){checks.push({name,passed:false,error:(e as Error).message});}}
function spec(id:string,sizeId='square-50',quantity=1,x=20,y=20){return parseCushionSpec({version:1,id:'check-'+id,sizeId,fabricId:id,filling:'cover',edge:'unpiped',placementMm:{x,y},quantity});}
function validate(plan:any,expectedPieces:number,f:any){assert.equal(plan.fabrics.length,1);const p=plan.fabrics[0].pieces;assert.equal(p.length,expectedPieces);for(let i=0;i<p.length;i++){assert.ok(p[i].xMm>=0&&p[i].yMm>=0);assert.ok(p[i].xMm+p[i].widthMm<=f.fullWidthMm+0.001);for(let j=i+1;j<p.length;j++)assert.ok(p[i].xMm+p[i].widthMm<=p[j].xMm+0.001||p[j].xMm+p[j].widthMm<=p[i].xMm+0.001||p[i].yMm+p[i].heightMm<=p[j].yMm+0.001||p[j].yMm+p[j].heightMm<=p[i].yMm+0.001,'two cut pieces overlap');}for(const front of p.filter((p:any)=>p.role==='front')){const back=p.find((b:any)=>b.role==='back'&&b.unit===front.unit&&b.specId===front.specId);assert.ok(back);assert.deepEqual(front.sourcePlacementMm,back.sourcePlacementMm);assert.equal(front.rotation,0);assert.equal(back.rotation,0);if(f.pattern.kind!=='plain'){for(const [axis,repeat] of [['xMm',f.pattern.horizontalRepeatMm],['yMm',f.pattern.verticalRepeatMm]] as const){const n=Math.abs(front[axis]-back[axis])/repeat;assert.ok(Math.abs(n-Math.round(n))<1e-5,'matching cuts differ in pattern phase');}}}}
check('Plain 50 cm: two 54 cm cuts fit supplier full width; 0.54 m raw cloth',()=>{const f=facts('sdg-f1239-30'),p=buildSetCutPlan([{spec:spec(f.id),facts:f}] as any,rules as any);validate(p,2,f);assert.equal(p.fabrics[0].requiredMetres,0.54);});
for(const id of ['sdg-f1239-30','sdg-dstr237715','sdg-dmlf236846'])for(const [size,qty,x,y] of [['square-38',1,20,20],['square-50',2,100,80],['rectangle-30-45',3,300,160],['square-60',1,40,60]] as const){check(`${id} ${size} quantity ${qty}: complete, nonoverlap, equal phase`,()=>{const f=facts(id),p=buildSetCutPlan([{spec:spec(id,size,qty,x,y),facts:f}] as any,rules as any);validate(p,qty*2,f);assert.equal(p.matchingVerified,true);});}
check('No matching-cut success when supplier full width is missing',()=>{const f={...facts('sdg-dmlf236846'),fullWidthMm:null};const p=buildSetCutPlan([{spec:spec(f.id),facts:f}] as any,rules as any);assert.equal(p.ready,false);assert.equal(p.matchingVerified,false);});
check('Non-finite placement rejected',()=>assert.throws(()=>spec('sdg-dmlf236846','square-50',1,Infinity,20)));
const report={testScope:'Independent engineering checks. 20mm seam and purchasing terms are synthetic test-only values, not owner-approved rates or a supplier order.',checkedAt:new Date().toISOString(),passed:checks.every(c=>c.passed),checks};
fs.writeFileSync(new URL('./independent-cut-check.json',import.meta.url),JSON.stringify(report,null,2));console.log(JSON.stringify(report,null,2));if(!report.passed)process.exitCode=1;
