{{ 'curtainsuk-apex-specialist.css' | asset_url | stylesheet_tag }}
<script src="{{ 'curtainsuk-apex-specialist.js' | asset_url }}" defer></script>
<article class="cukapex" data-apex-page>
 <div class="cukapex__wrap"><nav class="cukapex__breadcrumb" aria-label="{{ 'apex_specialist.breadcrumb' | t | escape }}"><a href="{{ routes.root_url }}">{{ 'apex_specialist.home' | t }}</a><span aria-hidden="true">/</span><a href="/pages/solve-my-window">{{ 'apex_specialist.shop_window' | t }}</a><span aria-hidden="true">/</span><span>{{ 'apex_specialist.category' | t }}</span></nav></div>
 <header class="cukapex__hero cukapex__wrap">
  <div class="cukapex__hero-copy"><p class="cukapex__eyebrow">{{ 'apex_specialist.eyebrow' | t }}</p><h1>{{ 'apex_specialist.title' | t }}</h1><p class="cukapex__intro">{{ 'apex_specialist.intro' | t }}</p>{% render 'curtainsuk-apex-actions' %}<a class="cukapex__explore" href="#apex-shapes">{{ 'apex_specialist.explore' | t }} <span aria-hidden="true">↓</span></a></div>
  <figure class="cukapex__hero-photo">{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 1600 | image_tag: widths: '480, 900, 1200, 1600', sizes: '(min-width: 900px) 56vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.hero_alt }}{% else %}{% render 'curtainsuk-apex-image', name: 'hero', alt_key: 'apex_specialist.image_hero', eager: true, sizes: '(min-width: 900px) 50vw, 100vw' %}{% endif %}<figcaption>{{ 'apex_specialist.hero_caption' | t }}</figcaption></figure>
 </header>
 <div class="cukapex__promise"><div class="cukapex__wrap"><span>{{ 'apex_specialist.promise_shape' | t }}</span><span>{{ 'apex_specialist.promise_track' | t }}</span><span>{{ 'apex_specialist.promise_service' | t }}</span></div></div>
 <section class="cukapex__section cukapex__wrap" id="apex-shapes" aria-labelledby="apex-shapes-title-{{ section.id }}"><div class="cukapex__section-head"><div><p class="cukapex__eyebrow">{{ 'apex_specialist.shape_eyebrow' | t }}</p><h2 id="apex-shapes-title-{{ section.id }}">{{ 'apex_specialist.shape_title' | t }}</h2></div><p>{{ 'apex_specialist.shape_intro' | t }}</p></div><div class="cukapex__shape-buttons" data-apex-shape-controls hidden role="group" aria-label="{{ 'apex_specialist.shape_controls' | t | escape }}"><button type="button" data-apex-shape="apex" aria-pressed="true" aria-controls="apex-panel-{{ section.id }}-apex"><svg viewBox="0 0 100 84" fill="none" aria-hidden="true"><path d="M12 70V35L50 8L88 35V70Z" stroke="currentColor" stroke-width="2"/><path d="M50 8V70M12 46H88" stroke="currentColor" stroke-width="1" opacity=".45"/></svg><span>{{ 'apex_specialist.shape_apex' | t }}</span></button><button type="button" data-apex-shape="triangular" aria-pressed="false" aria-controls="apex-panel-{{ section.id }}-triangular"><svg viewBox="0 0 100 84" fill="none" aria-hidden="true"><path d="M12 70L50 8L88 70Z" stroke="currentColor" stroke-width="2"/><path d="M50 8V70M27 46H73" stroke="currentColor" stroke-width="1" opacity=".45"/></svg><span>{{ 'apex_specialist.shape_triangular' | t }}</span></button><button type="button" data-apex-shape="gable" aria-pressed="false" aria-controls="apex-panel-{{ section.id }}-gable"><svg viewBox="0 0 100 84" fill="none" aria-hidden="true"><path d="M12 76V35L50 6L88 35V76Z" stroke="currentColor" stroke-width="2"/><path d="M50 6V76M12 51H88M31 21V76M69 21V76" stroke="currentColor" stroke-width="1" opacity=".45"/></svg><span>{{ 'apex_specialist.shape_gable' | t }}</span></button><button type="button" data-apex-shape="angled" aria-pressed="false" aria-controls="apex-panel-{{ section.id }}-angled"><svg viewBox="0 0 100 84" fill="none" aria-hidden="true"><path d="M12 70V10L88 40V70Z" stroke="currentColor" stroke-width="2"/><path d="M50 25V70M12 50H88" stroke="currentColor" stroke-width="1" opacity=".45"/></svg><span>{{ 'apex_specialist.shape_angled' | t }}</span></button></div><div data-apex-panels><article class="cukapex__shape-panel" id="apex-panel-{{ section.id }}-apex" data-apex-panel="apex" aria-labelledby="apex-shape-title-{{ section.id }}-apex"><figure>{% render 'curtainsuk-apex-image', name: 'hero', alt_key: 'apex_specialist.shape_apex_alt', eager: false, sizes: '(min-width: 900px) 50vw, 100vw' %}<figcaption>{{ 'apex_specialist.shape_photo' | t }}</figcaption></figure><div class="cukapex__shape-copy"><p class="cukapex__eyebrow">{{ 'apex_specialist.shape_apex' | t }}</p><h3 id="apex-shape-title-{{ section.id }}-apex">{{ 'apex_specialist.shape_apex_title' | t }}</h3><p>{{ 'apex_specialist.shape_apex_copy' | t }}</p><p class="cukapex__note">{{ 'apex_specialist.opening_note' | t }}</p><a class="cukapex__text-link" href="https://www.apexcurtains.com/start-designing">{{ 'apex_specialist.shape_enquire' | t }} <span aria-hidden="true">↗</span></a></div></article><article class="cukapex__shape-panel" id="apex-panel-{{ section.id }}-triangular" data-apex-panel="triangular" aria-labelledby="apex-shape-title-{{ section.id }}-triangular"><figure>{% render 'curtainsuk-apex-image', name: 'triangular', alt_key: 'apex_specialist.shape_triangular_alt', eager: false, sizes: '(min-width: 900px) 50vw, 100vw' %}<figcaption>{{ 'apex_specialist.shape_photo' | t }}</figcaption></figure><div class="cukapex__shape-copy"><p class="cukapex__eyebrow">{{ 'apex_specialist.shape_triangular' | t }}</p><h3 id="apex-shape-title-{{ section.id }}-triangular">{{ 'apex_specialist.shape_triangular_title' | t }}</h3><p>{{ 'apex_specialist.shape_triangular_copy' | t }}</p><p class="cukapex__note">{{ 'apex_specialist.opening_note' | t }}</p><a class="cukapex__text-link" href="https://www.apexcurtains.com/start-designing">{{ 'apex_specialist.shape_enquire' | t }} <span aria-hidden="true">↗</span></a></div></article><article class="cukapex__shape-panel" id="apex-panel-{{ section.id }}-gable" data-apex-panel="gable" aria-labelledby="apex-shape-title-{{ section.id }}-gable"><figure>{% render 'curtainsuk-apex-image', name: 'gable', alt_key: 'apex_specialist.shape_gable_alt', eager: false, sizes: '(min-width: 900px) 50vw, 100vw' %}<figcaption>{{ 'apex_specialist.shape_photo' | t }}</figcaption></figure><div class="cukapex__shape-copy"><p class="cukapex__eyebrow">{{ 'apex_specialist.shape_gable' | t }}</p><h3 id="apex-shape-title-{{ section.id }}-gable">{{ 'apex_specialist.shape_gable_title' | t }}</h3><p>{{ 'apex_specialist.shape_gable_copy' | t }}</p><p class="cukapex__note">{{ 'apex_specialist.opening_note' | t }}</p><a class="cukapex__text-link" href="https://www.apexcurtains.com/start-designing">{{ 'apex_specialist.shape_enquire' | t }} <span aria-hidden="true">↗</span></a></div></article><article class="cukapex__shape-panel" id="apex-panel-{{ section.id }}-angled" data-apex-panel="angled" aria-labelledby="apex-shape-title-{{ section.id }}-angled"><figure>{% render 'curtainsuk-apex-image', name: 'gable', alt_key: 'apex_specialist.shape_angled_alt', eager: false, sizes: '(min-width: 900px) 50vw, 100vw' %}<figcaption>{{ 'apex_specialist.shape_photo' | t }}</figcaption></figure><div class="cukapex__shape-copy"><p class="cukapex__eyebrow">{{ 'apex_specialist.shape_angled' | t }}</p><h3 id="apex-shape-title-{{ section.id }}-angled">{{ 'apex_specialist.shape_angled_title' | t }}</h3><p>{{ 'apex_specialist.shape_angled_copy' | t }}</p><p class="cukapex__note">{{ 'apex_specialist.opening_note' | t }}</p><a class="cukapex__text-link" href="https://www.apexcurtains.com/start-designing">{{ 'apex_specialist.shape_enquire' | t }} <span aria-hidden="true">↗</span></a></div></article></div><p class="cukapex__note">{{ 'apex_specialist.diagram_note' | t }}</p></section>
 <section class="cukapex__service" aria-labelledby="apex-service-title-{{ section.id }}"><div class="cukapex__wrap"><p class="cukapex__eyebrow">{{ 'apex_specialist.service_eyebrow' | t }}</p><h2 id="apex-service-title-{{ section.id }}">{{ 'apex_specialist.service_title' | t }}</h2><p class="cukapex__service-intro">{{ 'apex_specialist.service_intro' | t }}</p><div class="cukapex__benefits"><div><span>01</span><h3>{{ 'apex_specialist.benefit_shape' | t }}</h3><p>{{ 'apex_specialist.benefit_shape_copy' | t }}</p></div><div><span>02</span><h3>{{ 'apex_specialist.benefit_track' | t }}</h3><p>{{ 'apex_specialist.benefit_track_copy' | t }}</p></div><div><span>03</span><h3>{{ 'apex_specialist.benefit_fit' | t }}</h3><p>{{ 'apex_specialist.benefit_fit_copy' | t }}</p></div></div><div class="cukapex__measure-note"><p>{{ 'apex_specialist.service_measure' | t }}</p><a class="cukapex__text-link" href="/pages/how-to-measure-for-apex-windows">{{ 'apex_specialist.service_measure_link' | t }} <span aria-hidden="true">↗</span></a></div></div></section>
 <section class="cukapex__section cukapex__wrap" id="apex-projects" aria-labelledby="apex-project-title-{{ section.id }}"><div class="cukapex__section-head"><div><p class="cukapex__eyebrow">{{ 'apex_specialist.gallery_eyebrow' | t }}</p><h2 id="apex-project-title-{{ section.id }}">{{ 'apex_specialist.gallery_title' | t }}</h2></div><p>{{ 'apex_specialist.gallery_intro' | t }}</p></div><div class="cukapex__gallery"><article class="cukapex__project"><a class="cukapex__project-photo" href="{{ 'cuk-apex-cambridge-1200.webp' | asset_url }}" data-apex-enlarge aria-label="{{ 'apex_specialist.enlarge_cambridge' | t | escape }}" data-caption="{{ 'apex_specialist.caption_cambridge' | t | escape }}">{% render 'curtainsuk-apex-image', name: 'cambridge', alt_key: 'apex_specialist.image_cambridge', eager: false, sizes: '(min-width: 900px) 25vw, (min-width: 600px) 50vw, 100vw' %}<span aria-hidden="true">+</span></a><p class="cukapex__eyebrow">{{ 'apex_specialist.place_cambridge' | t }}</p><h3>{{ 'apex_specialist.heading_cambridge' | t }}</h3><p>{{ 'apex_specialist.project_cambridge' | t }}</p><a class="cukapex__text-link" href="https://www.apexcurtains.com/gallery/cambridge-large-apex-bedroom-curtains-cambridge">{{ 'apex_specialist.project_story' | t }} <span aria-hidden="true">↗</span></a></article>
<article class="cukapex__project"><a class="cukapex__project-photo" href="{{ 'cuk-apex-cheshire-1200.webp' | asset_url }}" data-apex-enlarge aria-label="{{ 'apex_specialist.enlarge_cheshire' | t | escape }}" data-caption="{{ 'apex_specialist.caption_cheshire' | t | escape }}">{% render 'curtainsuk-apex-image', name: 'cheshire', alt_key: 'apex_specialist.image_cheshire', eager: false, sizes: '(min-width: 900px) 25vw, (min-width: 600px) 50vw, 100vw' %}<span aria-hidden="true">+</span></a><p class="cukapex__eyebrow">{{ 'apex_specialist.place_cheshire' | t }}</p><h3>{{ 'apex_specialist.heading_cheshire' | t }}</h3><p>{{ 'apex_specialist.project_cheshire' | t }}</p><a class="cukapex__text-link" href="https://www.apexcurtains.com/gallery/cheshire-apex-curtains-cheshire">{{ 'apex_specialist.project_story' | t }} <span aria-hidden="true">↗</span></a></article>
<article class="cukapex__project"><a class="cukapex__project-photo" href="{{ 'cuk-apex-wales-1200.webp' | asset_url }}" data-apex-enlarge aria-label="{{ 'apex_specialist.enlarge_wales' | t | escape }}" data-caption="{{ 'apex_specialist.caption_wales' | t | escape }}">{% render 'curtainsuk-apex-image', name: 'wales', alt_key: 'apex_specialist.image_wales', eager: false, sizes: '(min-width: 900px) 25vw, (min-width: 600px) 50vw, 100vw' %}<span aria-hidden="true">+</span></a><p class="cukapex__eyebrow">{{ 'apex_specialist.place_wales' | t }}</p><h3>{{ 'apex_specialist.heading_wales' | t }}</h3><p>{{ 'apex_specialist.project_wales' | t }}</p><a class="cukapex__text-link" href="https://www.apexcurtains.com/gallery/wales-apex-bedroom-blackout-curtains-wales">{{ 'apex_specialist.project_story' | t }} <span aria-hidden="true">↗</span></a></article>
<article class="cukapex__project"><a class="cukapex__project-photo" href="{{ 'cuk-apex-milton-1200.webp' | asset_url }}" data-apex-enlarge aria-label="{{ 'apex_specialist.enlarge_milton' | t | escape }}" data-caption="{{ 'apex_specialist.caption_milton' | t | escape }}">{% render 'curtainsuk-apex-image', name: 'milton', alt_key: 'apex_specialist.image_milton', eager: false, sizes: '(min-width: 900px) 25vw, (min-width: 600px) 50vw, 100vw' %}<span aria-hidden="true">+</span></a><p class="cukapex__eyebrow">{{ 'apex_specialist.place_milton' | t }}</p><h3>{{ 'apex_specialist.heading_milton' | t }}</h3><p>{{ 'apex_specialist.project_milton' | t }}</p><a class="cukapex__text-link" href="https://www.apexcurtains.com/gallery/wave-pleat-apex-curtains-milton-keynes">{{ 'apex_specialist.project_story' | t }} <span aria-hidden="true">↗</span></a></article></div></section>
 <section class="cukapex__adviser" id="apex-natalie" aria-labelledby="apex-natalie-title-{{ section.id }}"><div class="cukapex__wrap cukapex__adviser-inner"><figure><img src="{{ 'curtainsuk-adviser-natalie.webp' | asset_url }}" width="800" height="640" loading="lazy" alt="{{ 'apex_specialist.natalie_alt' | t | escape }}"><figcaption>{{ 'apex_specialist.natalie_identity' | t }}</figcaption></figure><div><p class="cukapex__eyebrow">{{ 'apex_specialist.natalie_eyebrow' | t }}</p><h2 id="apex-natalie-title-{{ section.id }}">{{ 'apex_specialist.natalie_title' | t }}</h2><p class="cukapex__role">{{ 'apex_specialist.natalie_role' | t }}</p><p>{{ 'apex_specialist.natalie_copy' | t }}</p><blockquote>{{ 'apex_specialist.natalie_question' | t }}</blockquote><a class="cukapex__button" href="/pages/meet-our-team?specialist_return=natalie">{{ 'apex_specialist.ask' | t }} <span aria-hidden="true">↗</span></a><p class="cukapex__note">{{ 'apex_specialist.natalie_note' | t }}</p></div></div></section>
 <section class="cukapex__section cukapex__wrap" aria-labelledby="apex-steps-title-{{ section.id }}"><p class="cukapex__eyebrow">{{ 'apex_specialist.steps_eyebrow' | t }}</p><h2 id="apex-steps-title-{{ section.id }}">{{ 'apex_specialist.steps_title' | t }}</h2><ol class="cukapex__steps"><li><span aria-hidden="true">01</span><h3>{{ 'apex_specialist.step_0_title' | t }}</h3><p>{{ 'apex_specialist.step_0_copy' | t }}</p></li><li><span aria-hidden="true">02</span><h3>{{ 'apex_specialist.step_1_title' | t }}</h3><p>{{ 'apex_specialist.step_1_copy' | t }}</p></li><li><span aria-hidden="true">03</span><h3>{{ 'apex_specialist.step_2_title' | t }}</h3><p>{{ 'apex_specialist.step_2_copy' | t }}</p></li><li><span aria-hidden="true">04</span><h3>{{ 'apex_specialist.step_3_title' | t }}</h3><p>{{ 'apex_specialist.step_3_copy' | t }}</p></li></ol></section>
 <section class="cukapex__faq cukapex__wrap" aria-labelledby="apex-faq-title-{{ section.id }}"><div><p class="cukapex__eyebrow">{{ 'apex_specialist.faq_eyebrow' | t }}</p><h2 id="apex-faq-title-{{ section.id }}">{{ 'apex_specialist.faq_title' | t }}</h2></div><div><details><summary>{{ 'apex_specialist.faq_0_q' | t }}<span aria-hidden="true">+</span></summary><p>{{ 'apex_specialist.faq_0_a' | t }}</p></details><details><summary>{{ 'apex_specialist.faq_1_q' | t }}<span aria-hidden="true">+</span></summary><p>{{ 'apex_specialist.faq_1_a' | t }}</p></details><details><summary>{{ 'apex_specialist.faq_2_q' | t }}<span aria-hidden="true">+</span></summary><p>{{ 'apex_specialist.faq_2_a' | t }}</p></details><details><summary>{{ 'apex_specialist.faq_3_q' | t }}<span aria-hidden="true">+</span></summary><p>{{ 'apex_specialist.faq_3_a' | t }}</p></details><details><summary>{{ 'apex_specialist.faq_4_q' | t }}<span aria-hidden="true">+</span></summary><p>{{ 'apex_specialist.faq_4_a' | t }}</p></details><details><summary>{{ 'apex_specialist.faq_5_q' | t }}<span aria-hidden="true">+</span></summary><p>{{ 'apex_specialist.faq_5_a' | t }}</p></details></div></section>
 <section class="cukapex__finish" aria-labelledby="apex-finish-title-{{ section.id }}"><figure>{% render 'curtainsuk-apex-image', name: 'triangular', alt_key: 'apex_specialist.shape_triangular_alt', eager: false, sizes: '(min-width: 900px) 50vw, 100vw' %}</figure><div><p class="cukapex__eyebrow">{{ 'apex_specialist.finish_eyebrow' | t }}</p><h2 id="apex-finish-title-{{ section.id }}">{{ 'apex_specialist.finish_title' | t }}</h2><p>{{ 'apex_specialist.finish_copy' | t }}</p>{% render 'curtainsuk-apex-actions' %}</div></section>
 <dialog class="cukapex__dialog" data-apex-dialog aria-labelledby="apex-photo-caption-{{ section.id }}"><button class="cukapex__close" type="button" data-apex-close>{{ 'apex_specialist.close' | t }} <span aria-hidden="true">×</span></button><img data-apex-dialog-image alt="" width="1200" height="1600"><p id="apex-photo-caption-{{ section.id }}" data-apex-dialog-caption></p></dialog>
</article>
