.canatomy__knowledge{padding-block:24px 32px}.canatomy__knowledge>summary{min-height:48px;display:flex;align-items:center;justify-content:space-between;font-size:14px}.canatomy__knowledge-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 48px}.canatomy__knowledge-item{border-top:1px solid var(--line);align-self:start}
