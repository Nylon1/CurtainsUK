.canatomy__spot[aria-pressed=true] span{background:var(--forest);color:var(--cream);border-color:var(--cream);box-shadow:0 0 0 5px #f5f2e94d}
.canatomy__spot--heading{left:23%;top:9%}.canatomy__spot--flow{left:35%;top:43%}.canatomy__spot--structure{left:78%;top:28%}.canatomy__spot--fabric{left:18%;top:68%}.canatomy__spot--room{left:54%;top:53%}.canatomy__spot--floor{left:78%;top:89%}
