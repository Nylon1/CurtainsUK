.canatomy a:focus-visible,.canatomy button:focus-visible,.canatomy summary:focus-visible{outline:3px solid #a66b2c;outline-offset:4px}
.canatomy__wrap{width:min(1440px,calc(100% - 96px));margin-inline:auto}.canatomy__intro{padding-block:70px 52px}.canatomy__eyebrow{font-size:11px;font-weight:600;letter-spacing:.16em;line-height:1.5;text-transform:uppercase}
.canatomy__intro-grid{display:grid;grid-template-columns:1.2fr 1fr;align-items:end;gap:60px;margin-top:20px}.canatomy__intro-grid>p{font-size:18px;max-width:480px;padding-bottom:6px}
.canatomy__hierarchy{margin-top:30px!important;font-size:11px;letter-spacing:.11em;text-transform:uppercase}
.canatomy__section-head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:26px}.canatomy__section-head>p{max-width:370px;font-size:14px}
.canatomy__forms{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid var(--line);margin-bottom:24px}
.canatomy__forms button{border:0;border-bottom:2px solid transparent;background:transparent;min-height:60px;padding:15px 10px;font-size:13px;letter-spacing:.04em}
