.canatomy__stage{min-width:0}.canatomy__controls{padding-top:20px}.canatomy__controls>p{font-size:12px;margin-bottom:14px}.canatomy__control-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px 20px}.canatomy__controls fieldset{min-width:0;border:0;padding:0;margin:0}.canatomy__controls legend{font-size:10px;letter-spacing:.08em;text-transform:uppercase;margin-bottom:7px}.canatomy__choices{display:flex;flex-wrap:wrap;gap:6px}.canatomy__choices button,.canatomy__reset{background:transparent;border:1px solid var(--line);padding:9px 12px;min-height:44px;min-width:44px;font-size:12px}.canatomy__choices button[aria-pressed=true]{background:var(--forest);color:var(--cream)}.canatomy button:disabled{opacity:.38;cursor:not-allowed}.canatomy__reset{margin-top:14px}.canatomy__changed{border-top:1px solid var(--line);margin-top:18px;padding-top:16px}.canatomy__changed h3{font-size:24px;margin-bottom:12px}.canatomy__changed p{font-size:13px;margin-top:8px}.canatomy__changed [data-current-study]{font-size:11px;line-height:1.7}.canatomy__changed [data-study-help]{font-size:12px;margin-top:12px}.canatomy__controls [data-study-message]{font-size:12px;min-height:1.6em}.canatomy__visual[data-image-error] .canatomy__master{visibility:hidden}
.canatomy__visual[data-loading] .canatomy__master{visibility:hidden}.canatomy__visual[data-loading] .canatomy__hotspots,.canatomy__visual[data-loading] .canatomy__focus,.canatomy__visual[data-loading] .canatomy__closeup{display:none}
.canatomy__panel[data-length=short] .canatomy__spot--floor{top:69%}.canatomy__panel[data-length=short][data-focus=floor] .canatomy__focus{inset:57% 5% 25% 5%}.canatomy__panel[data-vertical=window-led] .canatomy__spot--heading{top:18%}.canatomy__panel[data-vertical=window-led][data-focus=heading] .canatomy__focus{inset:10% 5% 71% 5%}.canatomy__panel[data-vertical=window-led][data-closeup=true] .canatomy__master{transform-origin:23% 16%}
