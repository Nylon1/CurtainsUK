.canatomy__section-head{display:block;margin-bottom:20px}.canatomy__section-head>p{font-size:13px;margin-top:12px}.canatomy__forms{margin-bottom:16px}.canatomy__forms button{font-size:11px;min-height:54px;padding:12px 4px;letter-spacing:0}
.canatomy__panel{display:block;margin-bottom:22px}.canatomy__visual{width:calc(100% + 36px);margin-inline:-18px}.canatomy__layers{margin-top:20px}.canatomy__selected{padding-bottom:12px}
.canatomy__layer summary{min-height:46px;font-size:13px}.canatomy__layer-copy{padding:2px 0 16px 27px}.canatomy__layer-copy h3{font-size:24px;margin-bottom:9px}.canatomy__layer-copy p{font-size:14px}
.canatomy__takeaway{display:block;padding-top:18px;border-top:1px solid var(--line);margin-top:4px}.canatomy__takeaway p+p{margin-top:14px}.canatomy__takeaway p{font-size:12px}
.canatomy__study-note{display:block;font-size:10px}.canatomy__swipe{margin-top:9px!important}.canatomy__knowledge{padding-top:20px}.canatomy__knowledge-grid{grid-template-columns:1fr}.canatomy__knowledge-item summary{min-height:58px;font-size:14px}.canatomy__control-grid{grid-template-columns:1fr;gap:12px}.canatomy__controls{padding-top:16px}
.canatomy__return{padding-block:46px}.canatomy__return .canatomy__wrap>p:not(.canatomy__eyebrow){font-size:14px}.canatomy__actions{display:grid;gap:12px}.canatomy__button{width:100%}.canatomy__already a{margin-left:5px}}
@media(prefers-reduced-motion:reduce){.canatomy *{transition:none!important;scroll-behavior:auto!important}}
{% endstylesheet %}

{% javascript %}
(() => {
  function initialise(scope) {
    scope.querySelectorAll('[data-curtain-anatomy]').forEach(root => {
      if (root.dataset.ready) return;
      const tabs = root.querySelector('[data-anatomy-tabs]');
      const buttons = [...tabs.querySelectorAll('button')];
      const panels = [...root.querySelectorAll('[data-anatomy-panel]')];
      if (buttons.length !== 4 || panels.length !== 4) return;
      let selected = 0;
      let focus = 'heading';
      let closeup = false;
      const evidence = JSON.parse(root.querySelector('[data-anatomy-evidence]').textContent);
      const copy = JSON.parse(root.querySelector('[data-study-copy]').textContent);
      const dimensions = Object.keys(evidence.baseline);
      let state = { heading: panels[0].dataset.form, ...evidence.baseline };
      let request = 0;
      const originalCopy = panels.map(panel => Object.fromEntries(
        [...panel.querySelectorAll('[data-anatomy-layer]')].map(detail => [
          detail.dataset.anatomyLayer, detail.querySelector('.canatomy__layer-copy p').textContent
        ])
      ));
      function assetFor(tuple) {
        return evidence.entries.find(entry => entry.tuple.heading === tuple.heading &&
          dimensions.every(key => entry.tuple[key] === tuple[key]));
      }
      function updateStudy() {
        const panel = panels[selected];
        const changed = dimensions.find(key => state[key] !== evidence.baseline[key]);
        const explanation = changed ? copy[changed + '_' + state[changed]] : copy.reference;
        const heading = copy['heading_' + state.heading];
        panel.dataset.length = state.length;
        panel.dataset.vertical = state.vertical;
        panel.dataset.studyTuple = JSON.stringify(state);
        panel.querySelector('[data-study-controls]').hidden = false;
        panel.querySelectorAll('[data-study-dimension]').forEach(button => {
          const dimension = button.dataset.studyDimension;
          const value = button.dataset.studyValue;
          button.disabled = !assetFor({ ...state, [dimension]: value });
          button.setAttribute('aria-pressed', String(state[dimension] === value));
        });
        buttons.forEach((button, index) => {
          button.disabled = !assetFor({ ...state, heading: panels[index].dataset.form });
        });
        panel.querySelector('[data-current-study]').textContent =
          [panel.querySelector('.canatomy__selected').textContent.trim(),
            ...dimensions.map(key => copy[state[key]])].join(' · ');
        panel.querySelector('[data-study-explanation]').textContent = heading + ' ' + explanation;
        panel.querySelector('[data-study-translation]').textContent = copy['translate_' + (changed || 'heading')];
        panel.querySelector('[data-heading-takeaway]').hidden = Boolean(changed);
        panel.querySelectorAll('[data-anatomy-layer]').forEach(detail => {
          const layer = detail.dataset.anatomyLayer;
          let text = originalCopy[selected][layer];
          if (layer === 'floor') text = copy['length_' + state.length];
          if (changed === 'presence' && ['flow', 'structure', 'fabric', 'room'].includes(layer)) text += ' ' + explanation;
          if (changed === 'length' && layer === 'room') text += ' ' + explanation;
          if (changed === 'vertical' && ['heading', 'room'].includes(layer)) text += ' ' + explanation;
          if (changed === 'state' && ['flow', 'fabric', 'room'].includes(layer)) text += ' ' + explanation;
          detail.querySelector('.canatomy__layer-copy p').textContent = text;
        });
        panel.querySelector('.canatomy__master').alt = copy.alt + ': ' +
          panel.querySelector('[data-current-study]').textContent;
      }
      async function changeStudy(next) {
        const entry = assetFor(next);
        if (!entry) return;
        const token = ++request;
        const panel = panels[selected];
        const message = panel.querySelector('[data-study-message]');
        root.dataset.studyPending = 'true';
        message.textContent = copy.loading;
        try {
          const image = new Image();
          image.src = entry.asset;
          await image.decode();
          if (token !== request) return;
          state = next;
          panel.querySelector('.canatomy__master').src = entry.asset;
          closeup = false;
          focusLayer(panel, focus);
          updateStudy();
          message.textContent = '';
        } catch {
          if (token === request) message.textContent = copy.failed;
        } finally {
          if (token === request) delete root.dataset.studyPending;
        }
      }
      function applyCloseup(panel) {
        panel.dataset.closeup = String(closeup);
        const button = panel.querySelector('[data-closeup]');
        button.hidden = focus !== 'heading';
        button.setAttribute('aria-pressed', String(closeup));
        button.textContent = closeup ? button.dataset.closeLabel : button.dataset.openLabel;
      }
      function focusLayer(panel, layer) {
        panel.dataset.focus = layer;
        if (layer !== 'heading') closeup = false;
        applyCloseup(panel);
        panel.querySelectorAll('[data-anatomy-layer]').forEach(detail => {
          detail.open = detail.dataset.anatomyLayer === layer;
        });
        panel.querySelectorAll('[data-layer]').forEach(button => {
          button.setAttribute('aria-pressed', String(button.dataset.layer === layer));
        });
      }
      function activate(index) {
        const nextIndex = (index + panels.length) % panels.length;
        const next = { ...state, heading: panels[nextIndex].dataset.form };
        const entry = assetFor(next);
        if (!entry) return;
        ++request;
        delete root.dataset.studyPending;
        root.querySelectorAll('[data-study-message]').forEach(el => { el.textContent = ''; });
        selected = nextIndex;
        state = next;
        buttons.forEach((button, i) => {
          button.setAttribute('aria-selected', String(i === selected));
          button.tabIndex = i === selected ? 0 : -1;
          panels[i].hidden = i !== selected;
        });
        const visual = panels[selected].querySelector('[data-anatomy-visual]');
        const image = visual.querySelector('.canatomy__master');
        if (image.getAttribute('src') !== entry.asset) {
          visual.dataset.loading = 'true';
          visual.querySelector('[data-image-loading]').hidden = false;
          image.src = entry.asset;
        }
        updateStudy();
        focusLayer(panels[selected], focus);
      }
      function nextAvailable(index, direction) {
        for (let count = 0; count < panels.length; count++) {
          const candidate = (index + count * direction + panels.length * 2) % panels.length;
          if (assetFor({ ...state, heading: panels[candidate].dataset.form })) return candidate;
        }
        return selected;
      }
      tabs.setAttribute('role', 'tablist');
      buttons.forEach((button, index) => {
        button.setAttribute('role', 'tab');
        panels[index].setAttribute('role', 'tabpanel');
        panels[index].setAttribute('aria-labelledby', button.id);
        button.addEventListener('click', () => activate(index));
        button.addEventListener('keydown', event => {
          let next;
          if (event.key === 'ArrowRight') next = selected + 1;
          else if (event.key === 'ArrowLeft') next = selected - 1;
          else if (event.key === 'Home') next = 0;
          else if (event.key === 'End') next = panels.length - 1;
          else return;
          event.preventDefault();
          activate(nextAvailable(next, event.key === 'ArrowLeft' || event.key === 'End' ? -1 : 1));
          buttons[selected].focus();
        });
      });
      panels.forEach(panel => {
        panel.querySelectorAll('[data-study-dimension]').forEach(button => {
          button.addEventListener('click', () => {
            if (!button.disabled) changeStudy({ ...state, [button.dataset.studyDimension]: button.dataset.studyValue });
          });
        });
        panel.querySelector('[data-study-reset]').addEventListener('click', () => {
          state = { heading: panels[0].dataset.form, ...evidence.baseline };
          focus = 'heading';
          closeup = false;
          activate(0);
          buttons[0].focus({ preventScroll: true });
        });
        const visual = panel.querySelector('[data-anatomy-visual]');
        const image = visual.querySelector('img');
        const error = visual.querySelector('.canatomy__image-error:not([data-image-loading])');
        panel.querySelector('[data-closeup]').addEventListener('click', () => {
          closeup = !closeup;
          applyCloseup(panel);
        });
        const endLoading = () => {
          delete visual.dataset.loading;
          visual.querySelector('[data-image-loading]').hidden = true;
        };
        const fail = () => { endLoading(); visual.dataset.imageError = 'true'; error.hidden = false; };
        image.addEventListener('error', fail);
        image.addEventListener('load', () => { endLoading(); delete visual.dataset.imageError; error.hidden = true; });
        if (image.complete && !image.naturalWidth) fail();
        panel.querySelectorAll('[data-layer]').forEach(button => {
          button.addEventListener('click', () => {
            focus = button.dataset.layer;
            focusLayer(panel, focus);
            const summary = panel.querySelector('[data-anatomy-layer="' + focus + '"] summary');
            summary.focus({ preventScroll: true });
          });
        });
        panel.querySelectorAll('[data-anatomy-layer]').forEach(detail => {
          detail.querySelector('summary').addEventListener('click', event => {
            event.preventDefault();
            focus = detail.dataset.anatomyLayer;
            focusLayer(panel, focus);
          });
        });
        let start = null;
        visual.addEventListener('pointerdown', event => {
          if (event.pointerType === 'mouse' || event.target.closest('button')) return;
          start = { x: event.clientX, y: event.clientY, id: event.pointerId };
        });
        visual.addEventListener('pointercancel', () => { start = null; });
        visual.addEventListener('pointerup', event => {
          if (!start || start.id !== event.pointerId) return;
          const dx = event.clientX - start.x;
          const dy = event.clientY - start.y;
          start = null;
          if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.4) {
            const direction = dx < 0 ? 1 : -1;
            activate(nextAvailable(selected + direction, direction));
            buttons[selected].focus({ preventScroll: true });
          }
        });
        panel.querySelector('.canatomy__hotspots').hidden = false;
      });
      root.dataset.ready = 'true';
      tabs.hidden = false;
      root.querySelector('.canatomy__swipe').hidden = false;
      activate(0);
    });
  }
  initialise(document);
  document.addEventListener('shopify:section:load', event => initialise(event.target));
})();
