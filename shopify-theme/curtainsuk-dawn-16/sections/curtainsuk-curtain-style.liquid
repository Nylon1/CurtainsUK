{% liquid
  assign forms = 'wave,double-pinch,pencil-pleat,eyelet' | split: ','
  assign layers = 'heading,flow,structure,fabric,room,floor' | split: ','
%}
<div class="canatomy" data-curtain-anatomy>
  {% render 'curtainsuk-anatomy-evidence' %}
  <script type="application/json" data-study-copy>{
    {% assign copy_keys = 'principle,presence,length,vertical,horizontal,state,less,balanced,more,short,floor,soft-break,puddle,window-led,higher,ceiling-led,frame,extend-beyond,wall-to-wall,open,closed,reset,changed,explore,availability,loading,failed,reference,heading_wave,heading_double-pinch,heading_pencil-pleat,heading_eyelet,presence_less,presence_more,length_short,length_floor,length_soft-break,length_puddle,vertical_window-led,state_closed,translate_heading,translate_presence,translate_length,translate_vertical,translate_state,alt' | split: ',' %}
    {% for key in copy_keys %}{% assign translation_key = 'curtain_compare.' | append: key %}{{ key | json }}:{{ translation_key | t | json }}{% unless forloop.last %},{% endunless %}{% endfor %}
  }</script>
  <header class="canatomy__intro canatomy__wrap">
    <p class="canatomy__eyebrow">{{ 'curtain_anatomy.eyebrow' | t }}</p>
    <div class="canatomy__intro-grid"><h1>{{ 'curtain_anatomy.title' | t }}</h1><p>{{ 'curtain_anatomy.intro' | t }}</p></div>
    <p class="canatomy__hierarchy">{{ 'curtain_anatomy.hierarchy' | t }}</p>
  </header>
  <section class="canatomy__experience canatomy__wrap" aria-labelledby="anatomy-title-{{ section.id }}">
    <div class="canatomy__section-head"><h2 id="anatomy-title-{{ section.id }}">{{ 'curtain_anatomy.anatomy' | t }}</h2><p>{{ 'curtain_anatomy.instruction' | t }}</p></div>
    <div class="canatomy__forms" data-anatomy-tabs hidden aria-label="{{ 'curtain_anatomy.form_controls' | t }}">
      {% for form in forms %}{% assign label_key = 'curtain_anatomy.' | append: form | append: '_label' %}
        <button type="button" id="anatomy-tab-{{ section.id }}-{{ form }}" aria-controls="anatomy-panel-{{ section.id }}-{{ form }}">{{ label_key | t }}</button>
      {% endfor %}
    </div>
    {% for form in forms %}
      {% assign form_key = 'curtain_anatomy.' | append: form %}
      {% assign label_key = form_key | append: '_label' %}
      {% assign full_label_key = form_key | append: '_name' %}
      {% assign image_name = 'cuk-anatomy-' | append: form | append: '.png' %}
      <div class="canatomy__panel" id="anatomy-panel-{{ section.id }}-{{ form }}" data-anatomy-panel data-form="{{ form }}" data-focus="heading">
        <div class="canatomy__stage">
        <div class="canatomy__visual" data-anatomy-visual>
          {% assign alt_key = form_key | append: '_alt' %}
          <img class="canatomy__master" src="{{ image_name | asset_url }}" alt="{{ alt_key | t }}" width="1448" height="1086" {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
          <div class="canatomy__focus" aria-hidden="true"></div>
          <div class="canatomy__hotspots" hidden>
            {% for layer in layers %}{% assign layer_key = 'curtain_anatomy.' | append: layer %}
              <button type="button" class="canatomy__spot canatomy__spot--{{ layer }}" data-layer="{{ layer }}" aria-label="{{ layer_key | t }}" aria-controls="anatomy-{{ section.id }}-{{ form }}-{{ layer }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"><span aria-hidden="true">0{{ forloop.index }}</span></button>
            {% endfor %}
          </div>
          <p class="canatomy__image-error" hidden>{{ 'curtain_anatomy.image_error' | t }}</p>
          <p class="canatomy__image-error" data-image-loading hidden>{{ 'curtain_compare.loading' | t }}</p>
          <span class="canatomy__visual-name">{{ full_label_key | t }}</span>
          <button class="canatomy__closeup" type="button" data-closeup aria-pressed="false" data-open-label="{{ 'curtain_anatomy.look_closer' | t }}" data-close-label="{{ 'curtain_anatomy.whole_curtain' | t }}" hidden>{{ 'curtain_anatomy.look_closer' | t }}</button>
        </div>
        {% render 'curtainsuk-anatomy-controls', form: form, section_id: section.id %}
        </div>
        <div class="canatomy__layers">
          <p class="canatomy__eyebrow canatomy__selected">{{ full_label_key | t }}</p>
          {% for layer in layers %}
            {% assign layer_key = 'curtain_anatomy.' | append: layer %}
            {% assign body_key = form_key | append: '_' | append: layer %}
            {% assign intro_key = layer_key | append: '_intro' %}
            <details class="canatomy__layer" data-anatomy-layer="{{ layer }}" id="anatomy-{{ section.id }}-{{ form }}-{{ layer }}" {% if forloop.first %}open{% endif %}>
              <summary><span class="canatomy__number">0{{ forloop.index }}</span><span>{{ layer_key | t }}</span><span class="canatomy__plus" aria-hidden="true">+</span></summary>
              <div class="canatomy__layer-copy"><h3>{{ intro_key | t }}</h3><p>{{ body_key | t }}</p></div>
            </details>
          {% endfor %}
        </div>
        <div class="canatomy__takeaway" data-heading-takeaway>
          {% assign gives_key = form_key | append: '_gives' %}{% assign consider_key = form_key | append: '_consider' %}
          <p><span>{{ 'curtain_anatomy.gives' | t }}</span>{{ gives_key | t }}</p>
          <p><span>{{ 'curtain_anatomy.consider' | t }}</span>{{ consider_key | t }}</p>
        </div>
      </div>
    {% endfor %}
    <div class="canatomy__study-note"><p>{{ 'curtain_anatomy.study_note' | t }}</p><p class="canatomy__swipe" hidden>{{ 'curtain_anatomy.swipe' | t }}</p></div>
  <details class="canatomy__knowledge">
    <summary>{{ 'curtain_compare.explore' | t }}<span aria-hidden="true"> +</span></summary>
    <div class="canatomy__knowledge-grid">
      <details class="canatomy__knowledge-item"><summary>{{ 'curtain_anatomy.pattern_fold' | t }}<span aria-hidden="true">+</span></summary><div><p>{{ 'curtain_anatomy.pattern_body' | t }}</p><div class="canatomy__links"><a href="/pages/fabric-library?view=browse-fabrics&amp;activity=low">{{ 'curtain_anatomy.quieter' | t }}</a><a href="/pages/fabric-library?view=browse-fabrics&amp;activity=statement">{{ 'curtain_anatomy.expressive' | t }}</a><a href="/pages/fabric-library?view=browse-fabrics&amp;pattern=stripe">{{ 'curtain_anatomy.stripe' | t }}</a><a href="/pages/fabric-library?view=browse-fabrics&amp;pattern=geometric">{{ 'curtain_anatomy.geometric' | t }}</a><a href="/pages/fabric-library?view=browse-fabrics&amp;pattern=botanical">{{ 'curtain_anatomy.botanical' | t }}</a></div><aside><p>{{ 'curtain_anatomy.pattern_question' | t }}</p><a href="/apps/curtainsuk-decision/consultation?experience=premium&amp;entry=match">{{ 'curtain_anatomy.fi' | t }}</a></aside></div></details>
      <details class="canatomy__knowledge-item"><summary>{{ 'curtain_anatomy.texture_fold' | t }}<span aria-hidden="true">+</span></summary><div><p>{{ 'curtain_anatomy.texture_body' | t }}</p><div class="canatomy__links"><a href="/pages/fabric-library?view=browse-fabrics&amp;texture=visible-weave">{{ 'curtain_anatomy.weave' | t }}</a><a href="/pages/fabric-library?view=browse-fabrics&amp;texture=relief">{{ 'curtain_anatomy.raised' | t }}</a></div><aside><p>{{ 'curtain_anatomy.texture_question' | t }}</p><a href="/apps/curtainsuk-decision/consultation?experience=premium&amp;entry=match">{{ 'curtain_anatomy.fi_texture' | t }}</a></aside></div></details>
      <details class="canatomy__knowledge-item"><summary>{{ 'curtain_anatomy.presence_form' | t }}<span aria-hidden="true">+</span></summary><div><p>{{ 'curtain_anatomy.presence_body' | t }}</p><div class="canatomy__links"><a href="/pages/fabric-library?view=browse-fabrics&amp;presence=light">{{ 'curtain_anatomy.light' | t }}</a><a href="/pages/fabric-library?view=browse-fabrics&amp;presence=substantial">{{ 'curtain_anatomy.substantial' | t }}</a></div><aside><p>{{ 'curtain_anatomy.presence_question' | t }}</p><a href="/apps/curtainsuk-decision/consultation?experience=premium&amp;entry=match">{{ 'curtain_anatomy.fi_presence' | t }}</a></aside></div></details>
    </div>
  </details>
  </section>
  <section class="canatomy__return"><div class="canatomy__wrap">
    <p class="canatomy__eyebrow">{{ 'curtain_anatomy.return_label' | t }}</p><h2>{{ 'curtain_anatomy.return_title' | t }}</h2><p>{{ 'curtain_anatomy.return_body' | t }}</p>
    <div class="canatomy__actions"><a class="canatomy__button" href="/apps/curtainsuk-decision/consultation?experience=premium&amp;entry=match">{{ 'curtain_anatomy.fi' | t }}</a><a class="canatomy__button canatomy__button--outline" href="/pages/fabric-library?view=browse-fabrics">{{ 'curtain_anatomy.browse' | t }}</a></div>
    <p class="canatomy__already">{{ 'curtain_anatomy.already' | t }} <a href="/pages/curtain-visualiser">{{ 'curtain_anatomy.make' | t }}</a></p>
  </div></section>
</div>

{% stylesheet %}
.canatomy{--cream:#f5f2e9;--forest:#173d35;--line:#173d3530;background:var(--cream);color:var(--forest);font-family:var(--font-body-family);font-size:16px;line-height:1.6}
.canatomy *{box-sizing:border-box}.canatomy [hidden]{display:none!important}
.canatomy h1,.canatomy h2,.canatomy h3,.canatomy p,.canatomy figure{margin:0}
.canatomy h1,.canatomy h2,.canatomy h3{font-family:var(--font-heading-family);font-weight:400;letter-spacing:-.035em;line-height:1.12;color:inherit}
.canatomy h1{font-size:clamp(48px,5.4vw,80px);max-width:630px}.canatomy h2{font-size:clamp(31px,3.2vw,45px)}.canatomy h3{font-size:25px}
