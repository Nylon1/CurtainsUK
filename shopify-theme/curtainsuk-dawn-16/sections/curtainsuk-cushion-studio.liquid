{% comment %}
  Customer entry for the protected Cushion Studio release.
  Server-side product readiness and checkout checks remain authoritative.
{% endcomment %}
{% if section.settings.enabled %}
  <section class="cuk-cushion-studio" aria-label="Cushion Studio">
    <header class="page-width cuk-cushion-studio__intro">
      <h1>{{ section.settings.heading | escape }}</h1>
      <p>{{ section.settings.introduction | escape }}</p>
    </header>
    <iframe
      data-cuk-cushion-frame
      data-source="/apps/curtainsuk-decision/cushion-studio"
      title="Cushion Configurator and Cushion Layout"
      class="cuk-cushion-studio__frame"
      loading="eager"
      allow="fullscreen"
    ></iframe>
    <noscript><p class="page-width">Enable JavaScript to configure cushions. You can still <a href="/pages/fabric-library">browse fabrics and order samples</a>.</p></noscript>
  </section>
{% elsif request.design_mode %}
  <div class="page-width">
    <h2>Cushion Studio · unpublished candidate</h2>
    <p>Enable only after the protected backend release, manufacturing rules, pricing, persistence and checkout checks have been approved.</p>
  </div>
{% endif %}
{% stylesheet %}
  .cuk-cushion-studio__intro { padding-top: 3rem; padding-bottom: 2rem; }
  .cuk-cushion-studio__intro h1 { margin-bottom: 1rem; }
  .cuk-cushion-studio__frame { display: block; width: 100%; height: max(880px, 85vh); border: 0; background: #f5f1e9; }
  @media (max-width: 749px) { .cuk-cushion-studio__frame { height: 1250px; } }
{% endstylesheet %}
{% javascript %}
  document.querySelectorAll('[data-cuk-cushion-frame]').forEach(function (frame) {
    var source = new URL(frame.dataset.source, window.location.origin);
    var fabric = new URLSearchParams(window.location.search).get('fabric');
    if (fabric && /^[A-Za-z0-9][A-Za-z0-9_-]{0,149}$/.test(fabric)) source.searchParams.set('fabric', fabric);
    var params = new URLSearchParams(window.location.search);
    var roomId = params.get('room_id');
    if (roomId && /^[0-9a-f-]{36}$/i.test(roomId)) source.searchParams.set('room_id', roomId);
    var orderItem = params.get('order_item');
    if (orderItem && /^[0-9a-f-]{36}$/i.test(orderItem)) source.searchParams.set('order_item', orderItem);
    if (params.get('new_order_product') === '1') source.searchParams.set('new_order_product', '1');
    frame.src = source.pathname + source.search;
    // The app proxy frame is served on this storefront origin. Keep only its
    // visual preview in view on mobile while the editor scrolls underneath.
    // The service's product geometry and camera controls remain unchanged.
    var mobilePreviewShift = 0;
    var fitMobilePreview = function (top, availableHeight) {
      var doc;
      try { doc = frame.contentDocument; } catch (error) { return; }
      if (!doc || !doc.body) return;
      var stage = doc.querySelector('.scene-stage');
      var actions = doc.querySelector('.scene-actions');
      var workspace = doc.querySelector('.workspace');
      if (!stage || !actions || !workspace) return;
      var detailButton = doc.querySelector('[data-camera="close"]');
      if (detailButton && detailButton.textContent.trim() === 'The details') detailButton.textContent = 'Closer details';
      var mobile = window.matchMedia('(max-width: 749px)').matches && availableHeight >= 430;
      if (!mobile) {
        doc.body.classList.remove('cuk-mobile-sticky-preview');
        doc.body.style.removeProperty('--cuk-mobile-preview-shift');
        doc.body.style.removeProperty('--cuk-mobile-scene-height');
        mobilePreviewShift = 0;
        return;
      }
      if (!doc.getElementById('cuk-mobile-sticky-style')) {
        var style = doc.createElement('style');
        style.id = 'cuk-mobile-sticky-style';
        style.textContent = '@media(max-width:760px){' +
          'body.cuk-mobile-sticky-preview #scene{height:var(--cuk-mobile-scene-height)!important;min-height:0!important}' +
          'body.cuk-mobile-sticky-preview .visual{z-index:4}' +
          'body.cuk-mobile-sticky-preview .scene-top,' +
          'body.cuk-mobile-sticky-preview .scene-stage,' +
          'body.cuk-mobile-sticky-preview .scene-actions{transform:translate3d(0,var(--cuk-mobile-preview-shift),0)}' +
          'body.cuk-mobile-sticky-preview .scene-top{z-index:6}' +
          'body.cuk-mobile-sticky-preview .scene-stage,' +
          'body.cuk-mobile-sticky-preview .scene-actions{z-index:5}' +
          'body.cuk-mobile-sticky-preview .scene-stage{box-shadow:0 8px 24px rgba(31,36,31,.12)}' +
          '}';
        doc.head.appendChild(style);
      }
      doc.body.classList.add('cuk-mobile-sticky-preview');
      doc.body.style.setProperty('--cuk-mobile-scene-height', Math.max(195, Math.min(265, Math.floor(availableHeight * .42))) + 'px');
      var stageTop = stage.getBoundingClientRect().top - mobilePreviewShift;
      var workspaceBottom = workspace.getBoundingClientRect().bottom;
      var previewHeight = stage.offsetHeight + actions.offsetHeight;
      var desired = top - frame.getBoundingClientRect().top - stageTop;
      var limit = Math.max(0, workspaceBottom - stageTop - previewHeight - 8);
      mobilePreviewShift = Math.min(limit, Math.max(0, desired));
      doc.body.style.setProperty('--cuk-mobile-preview-shift', mobilePreviewShift + 'px');
    };
    var sendViewport = function () {
      if (!frame.contentWindow) return;
      var header = document.querySelector('.section-cuk-header');
      var headerBottom = header ? Math.max(0, header.getBoundingClientRect().bottom) : 0;
      var viewportHeight = window.visualViewport ? window.visualViewport.height : window.innerHeight;
      var top = headerBottom + 12;
      frame.contentWindow.postMessage({
        type: 'cuk-cushion-viewport',
        offset: top - frame.getBoundingClientRect().top,
        availableHeight: Math.max(300, viewportHeight - top - 12)
      }, window.location.origin);
      fitMobilePreview(top, Math.max(0, viewportHeight - top - 12));
    };
    var pending = false;
    var scheduleViewport = function () {
      if (pending) return;
      pending = true;
      requestAnimationFrame(function () { pending = false; sendViewport(); });
    };
    frame.addEventListener('load', scheduleViewport);
    window.addEventListener('scroll', scheduleViewport, { passive: true });
    window.addEventListener('resize', scheduleViewport);
    if (window.visualViewport) window.visualViewport.addEventListener('resize', scheduleViewport);
    window.addEventListener('message', function (event) {
      if (event.origin !== window.location.origin || event.source !== frame.contentWindow) return;
      if (event.data && event.data.type === 'cuk-cushion-height' && Number.isFinite(event.data.height)) {
        frame.style.height = Math.min(20000, Math.max(700, Math.ceil(event.data.height))) + 'px';
        scheduleViewport();
      }
    });
  });
{% endjavascript %}
{% schema %}
{
  "name": "Cushion Studio",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable approved Cushion Studio", "default": false },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cushion Studio" },
    { "type": "textarea", "id": "introduction", "label": "Introduction", "default": "Create your cushion first, then arrange your collection on a sofa or bed." }
  ],
  "presets": [{ "name": "Cushion Studio" }]
}
{% endschema %}
