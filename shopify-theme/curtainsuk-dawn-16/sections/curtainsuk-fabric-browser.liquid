{{ 'curtainsuk-storefront.css' | asset_url | stylesheet_tag }}
<script src="{{ 'curtainsuk-storefront.js' | asset_url }}" defer="defer"></script>

<section class="cuk-shell cuk-section cuk-section--tint" data-cuk-fabric-browser data-engine-base="{{ section.settings.engine_base | escape }}">
  <div class="cuk-wrap">
    <div class="cuk-section__head"><div><p class="cuk-eyebrow">FabricSpec-backed staging browser</p><h1>Choose fabric and colour</h1></div><p>Exact width, repeat, composition and sample links stay tied to the colourway record.</p></div>
    <div class="cuk-error" data-cuk-error hidden></div>
    <div class="cuk-fabrics" data-cuk-fabric-grid aria-live="polite"><p>Loading staging fabrics…</p></div>
  </div>
</section>

{% schema %}
{
  "name": "CurtainsUK fabric browser",
  "tag": "section",
  "class": "section",
  "settings": [{ "type": "text", "id": "engine_base", "label": "Decision engine app-proxy base", "default": "/apps/curtainsuk-decision" }],
  "presets": [{ "name": "CurtainsUK fabric browser" }]
}
{% endschema %}
