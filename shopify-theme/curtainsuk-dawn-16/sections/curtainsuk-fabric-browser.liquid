{{ 'curtainsuk-storefront.css' | asset_url | stylesheet_tag }}
{{ 'curtainsuk-premium.css' | asset_url | stylesheet_tag }}

{% if page.handle == 'shop-by-fabric' or page.handle == 'fabric-library' %}
<script src="{{ 'curtainsuk-premium.js' | asset_url }}" defer="defer"></script>
{% if template.suffix == 'browse-fabrics' and section.settings.jane_handoff_enabled %}<script src="{{ 'curtainsuk-jane-fabric-entry.js' | asset_url }}" defer="defer"></script>{% endif %}
{% if template.suffix == 'browse-fabrics' %}<script src="{{ 'curtainsuk-fabric-experience.js' | asset_url }}" defer="defer"></script>{% endif %}
{% if template.suffix == 'browse-fabrics' %}<script src="{{ 'curtainsuk-browse-filters.js' | asset_url }}" defer="defer"></script>{% endif %}
{% if template.suffix == 'browse-fabrics' %}<script src="{{ 'curtainsuk-making-picker.js' | asset_url }}" defer="defer"></script>{% endif %}
{%- if template.suffix == 'browse-fabrics' and section.settings.naila_enabled -%}
{{ 'curtainsuk-naila.css' | asset_url | stylesheet_tag }}
<script src="{{ 'curtainsuk-naila.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
<script src="{{ 'curtainsuk-storefront.js' | asset_url }}" defer="defer"></script>
{% if template.suffix == 'browse-fabrics' %}{{ 'curtainsuk-browse.css' | asset_url | stylesheet_tag }}{{ 'curtainsuk-browse-filters.css' | asset_url | stylesheet_tag }}{% endif %}
{% assign engine_base = settings.curtainsuk_staging_api_base | default: section.settings.engine_base %}
{% render 'curtainsuk-fabric-discovery' %}
<section class="cuk-shell cuk-section cuk-section--tint" data-cuk-fabric-browser {% if template.suffix == 'browse-fabrics' %}data-cuk-shopping{% if section.settings.naila_enabled %} data-naila-enabled="true"{% endif %}{% endif %} data-engine-base="{{ engine_base | escape }}">
  <div class="cuk-wrap">
    {% if template.suffix == 'browse-fabrics' %}
    <div class="cuk-section__head cuk-browse-hero">
      <img class="cuk-browse-hero__room" src="{{ 'cuk-home-room-inspiration.webp' | asset_url }}" width="1400" height="700" alt="Sunlit living room with full-length curtains, warm oak and soft natural textures" fetchpriority="high" decoding="async">
      <div class="cuk-browse-hero__copy">
        <p class="cuk-eyebrow">THE CURTAINSUK FABRIC COLLECTION</p>
        <h1>Browse fabrics.<br><em>Imagine your room.</em></h1>
        <p>Find your colour. Fall for a texture.<br>Make something beautifully yours.</p>
        <a class="cuk-button" href="#cuk-fabric-library-search">Explore the collection <span aria-hidden="true">↓</span></a>
        <p class="cuk-browse-hero__note">Look closer. Feel a sample. Create your curtains.</p>
      </div>
      <div class="cuk-browse-hero__fabrics" aria-label="A glimpse of the fabric collection">
        <p class="cuk-browse-hero__swatch-title">A little inspiration</p>
        <figure><img src="https://cdn.shopify.com/s/files/1/0256/4551/4861/files/cuk-fabric-4da277b295418b33e5bb02a88a5c0eaf642999fb8804bc748dd47e2f38f3d5e2.jpg?width=360" width="360" height="460" alt="Acanthus fabric in Apple/Sage" decoding="async"><figcaption>Expressive pattern</figcaption></figure>
        <figure><img src="https://cdn.shopify.com/s/files/1/0256/4551/4861/files/cuk-fabric-b23b645e3ad944f65c582c6a761e85618fb1e475c9aed01220c634575b82b7ad.jpg?width=360" width="360" height="460" alt="Acanthus Jacquard fabric in Linen" decoding="async"><figcaption>Beautiful texture</figcaption></figure>
        <figure><img src="https://cdn.shopify.com/s/files/1/0256/4551/4861/files/cuk-fabric-14da30cf9a04fd3b9b12bf643ee2862b452e1d8a44b901996c2efc7bfe05341b.jpg?width=360" width="360" height="460" alt="Abeja fabric in Blush" decoding="async"><figcaption>Colour to love</figcaption></figure>
      </div>
      <span class="cuk-browse-hero__scene-note">Room inspiration · Fabrics shown separately</span>
    </div>
    {% else %}<div class="cuk-section__head"><div><p class="cuk-eyebrow">Find your fabric</p><h1>Choose fabric and colour</h1></div><p>Explore colour, pattern and texture. Find a fabric to make your room feel like home.</p></div>{% endif %}
    {%- if template.suffix == 'browse-fabrics' and section.settings.naila_enabled -%}<div class="cuk-naila-entry" data-cuk-naila></div>{%- endif -%}
    <form class="cuk-fabric-filters" data-cuk-fabric-filters role="search" id="cuk-fabric-library-search">
      {% render 'curtainsuk-sample-credit' %}
      {% if template.suffix == 'browse-fabrics' %}
      <div class="cuk-browse-filter-help">
        <p class="cuk-eyebrow">YOUR ROOM. YOUR PALETTE.</p>
        <h2>Find your fabric.</h2>
        <p>Start with a colour you love. Refine by price, pattern and texture.</p>
        <details class="cuk-browse-filter-tips"><summary>How to use the filters</summary><p>Choose one or more colours, then a fabric price range. Open More filters for pattern, texture and style. Tap a selected choice to remove it, or use Clear all.</p><p>Matches depend on available fabric information. Screen colours can vary. Prices are guides until you choose your curtain measurements and options.</p></details>
      </div>
      {% endif %}
      <div class="cuk-field"><label for="CukFabricSearch-{{ section.id }}">Search fabrics</label><input id="CukFabricSearch-{{ section.id }}" type="search" name="query" placeholder="Search design, colourway, brand, collection or SKU"></div>
      {% if template.suffix == 'browse-fabrics' %}
      <input type="hidden" name="guidePrice"><div data-cuk-discovery></div>
      <div class="cuk-browse-filter-state" data-cuk-filter-state><div class="cuk-filter-chips" data-cuk-active-filters aria-live="polite"></div><button type="reset" class="cuk-text-link" data-cuk-clear-all hidden>Clear all</button></div>
      {% else %}
      <details class="cuk-filter-options" data-cuk-filter-options open><summary>Filters · colour, pattern, texture &amp; character</summary><div class="cuk-filter-options__grid">
      <div class="cuk-field"><label for="CukFabricBrand-{{ section.id }}">Brand</label><select id="CukFabricBrand-{{ section.id }}" name="brand"><option value="">All brands</option></select></div>
      <div class="cuk-field"><label for="CukFabric-collection-{{ section.id }}">Collections</label><select id="CukFabric-collection-{{ section.id }}" name="collection"><option value="">All collections</option></select></div>
      <div class="cuk-field"><label for="CukFabric-colour-{{ section.id }}">Colour families</label><select id="CukFabric-colour-{{ section.id }}" name="colour"><option value="">All colour families</option></select></div>
      <div class="cuk-field"><label for="CukFabric-pattern-{{ section.id }}">Patterns</label><select id="CukFabric-pattern-{{ section.id }}" name="pattern"><option value="">All patterns</option></select></div>
      <div class="cuk-field"><label for="CukFabric-style-{{ section.id }}">Styles</label><select id="CukFabric-style-{{ section.id }}" name="style"><option value="">All styles</option></select></div>
      <div class="cuk-field"><label for="CukFabric-character-{{ section.id }}">Texture &amp; character</label><select id="CukFabric-character-{{ section.id }}" name="character"><option value="">All fabric characters</option></select></div>
      <div class="cuk-field"><label for="CukFabricAvailability-{{ section.id }}">Availability</label><select id="CukFabricAvailability-{{ section.id }}" name="availability"><option value="">All availability</option><option value="CURRENT">Current range</option><option value="CONFIRM">To be confirmed</option></select></div>
      <div class="cuk-field"><label for="CukFabricSample-{{ section.id }}">Samples</label><select id="CukFabricSample-{{ section.id }}" name="sample"><option value="">All fabrics</option><option value="AVAILABLE">Sample available</option><option value="UNAVAILABLE">Sample unavailable</option></select></div>
      </div></details>{% endif %}
    </form>
    <p class="cuk-hint" data-cuk-fabric-count aria-live="polite"></p>
    <p class="cuk-browse-loading" data-cuk-browse-status role="status" aria-live="polite"></p>
    <div class="cuk-error cuk-browse-error" data-cuk-error role="alert" hidden><p data-cuk-error-message></p><button class="cuk-button cuk-button--secondary" data-cuk-retry type="button">Try again</button></div>
    <div class="cuk-fabrics" data-cuk-fabric-grid aria-live="polite"><p>Loading fabrics…</p></div>
    <nav class="cuk-pagination" data-cuk-pagination aria-label="Fabric pages"><button class="cuk-button cuk-button--secondary" data-cuk-previous type="button" disabled>Previous</button><button class="cuk-button cuk-button--secondary" data-cuk-next type="button" disabled>Next</button></nav>
    {% if template.suffix == 'browse-fabrics' %}<aside class="cuk-browse-assistance" data-cuk-browse-assistance><div><h2>Too much choice?</h2><p>Let Fabric Intelligence narrow the collection using your room and taste.</p></div><a class="cuk-button" href="/apps/curtainsuk-decision/consultation?experience=premium&amp;entry=match">Find my fabric direction →</a></aside>{% endif %}
    <div data-cuk-fabric-detail hidden></div>
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "CurtainsUK fabric browser",
  "tag": "section",
  "class": "section",
  "settings": [{ "type": "checkbox", "id": "naila_enabled", "label": "Enable Fiona owner review", "default": false, "info": "Requires the existing consultation gateway flag. Leave disabled until owner review is complete." }, { "type": "checkbox", "id": "jane_handoff_enabled", "label": "Enable Ask Jane fabric handoff", "default": false, "info": "Requires the separately released Jane consultation. Leave disabled until the signed customer journey is verified." }, { "type": "text", "id": "engine_base", "label": "Decision engine app-proxy base", "default": "/apps/curtainsuk-decision" }, { "type": "url", "id": "browse_preview_endpoint", "label": "Unpublished browse preview API", "info": "Candidate-only read-only catalogue endpoint. Ignored on the live theme." }],
  "presets": [{ "name": "CurtainsUK fabric browser" }]
}
{% endschema %}
