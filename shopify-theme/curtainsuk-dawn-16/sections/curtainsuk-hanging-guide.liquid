<section class="cuk-hanging-mount" aria-label="How to hang your curtains">
  <iframe title="CurtainsUK hanging guides" src="/apps/curtainsuk-decision/hanging/index.html" loading="eager" allow="fullscreen"></iframe>
  <p class="cuk-hanging-open"><a href="/apps/curtainsuk-decision/hanging/index.html" target="_blank" rel="noopener">Open the hanging guide in its own window</a></p>
  <noscript><p>Enable JavaScript to use the personal hanging guide.</p></noscript>
</section>
<style>
  html.cuk-hanging-viewport,html.cuk-hanging-viewport body{overflow:hidden;height:100dvh}
  html.cuk-hanging-viewport body{position:fixed;inset:0;width:100%}
  html.cuk-hanging-viewport body>.shopify-section-group-header-group,
  html.cuk-hanging-viewport body>.shopify-section-group-footer-group{display:none}
  html.cuk-hanging-viewport #MainContent{height:100dvh;overflow:hidden;margin:0;padding:0}
  .cuk-hanging-mount{width:100%;max-width:none;margin:0;padding:0}
  .cuk-hanging-mount iframe{display:block;width:100%;height:100dvh;border:0;background:#faf9f5}
  .cuk-hanging-open{position:absolute;left:-9999px}
  .cuk-hanging-open:focus-within{position:static;padding:12px 20px}
</style>
<script>document.documentElement.classList.add('cuk-hanging-viewport');</script>
