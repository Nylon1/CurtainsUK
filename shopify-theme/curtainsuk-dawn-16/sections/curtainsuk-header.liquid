{{ 'component-search.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'curtainsuk-header.css' | asset_url | stylesheet_tag }}
{% if settings.curtainsuk_rooms_enabled %}
  <script src="{{ 'curtainsuk-rooms-store.js' | asset_url }}" defer></script>
{% endif %}
<script src="{{ 'curtainsuk-header.js' | asset_url }}" defer="defer"></script>
{% liquid
  assign room_url = '/apps/curtainsuk-decision/consultation?experience=premium&entry=match'
  assign home_url = routes.root_url
  assign campaign_date = 'now' | date: '%Y%m%d' | plus: 0
%}
<curtainsuk-header class="cuknav{% if page.handle == 'room-visualiser' or page.handle == 'cushion-studio' or page.handle == 'hotel-design-studio' or page.handle == 'smart-track-studio' %} cuknav--visualiser{% endif %}" data-section-id="{{ section.id }}">
  <header class="cuknav__header">
    <div class="cuknav__bar">
      <a class="cuknav__icon cuknav__menu-toggle" href="#CukMenu-{{ section.id }}" aria-label="Open menu" aria-controls="CukMenu-{{ section.id }}" aria-expanded="false" data-open="menu">
        {{ 'icon-hamburger.svg' | inline_asset_content }}
      </a>
      <a href="{{ home_url }}" class="cuknav__brand" aria-label="CurtainsUK home">
        {% if settings.logo != blank %}
          {% assign configured_logo_url = settings.logo | image_url: width: 420 %}
          {% if configured_logo_url contains 'logo_curtainsuk_1.svg' %}
            <img src="{{ 'curtainsuk-header-logo-transparent.png' | asset_url }}" width="1774" height="887" loading="eager" alt="">
          {% else %}
            {{ settings.logo | image_url: width: 420 | image_tag: widths: '180, 280, 420', sizes: '180px', loading: 'eager', alt: 'CurtainsUK' }}
          {% endif %}
        {% else %}
          <span>Curtains<span class="cuknav__brand-light">UK</span></span>
        {% endif %}
      </a>
      <div class="cuknav__campaign">
        <span class="cuknav__campaign-eyebrow">MADE TO MEASURE · MADE FOR LIVING</span>
        <nav class="cuknav__product-links{% if settings.curtainsuk_smart_track_enabled %} cuknav__product-links--four{% endif %}" aria-label="Shop our products">
          <a href="/pages/fabric-library?view=browse-fabrics"><span class="cuknav__product-number" aria-hidden="true">01</span><span class="cuknav__product-name">Curtains</span><span class="cuknav__product-arrow" aria-hidden="true">↗</span></a>
          <a href="/apps/curtainsuk-decision/roman/roman.html" aria-label="Roman Blinds"><span class="cuknav__product-number" aria-hidden="true">02</span><span class="cuknav__product-name"><span class="cuknav__desktop-label">Roman Blinds</span><span class="cuknav__mobile-label" aria-hidden="true">Romans</span></span><span class="cuknav__product-arrow" aria-hidden="true">↗</span></a>
          <a href="/pages/cushion-studio"><span class="cuknav__product-number" aria-hidden="true">03</span><span class="cuknav__product-name">Cushions</span><span class="cuknav__product-arrow" aria-hidden="true">↗</span></a>
          {% if settings.curtainsuk_smart_track_enabled %}<a href="/pages/smart-track-studio" aria-label="Motorised Tracks"><span class="cuknav__product-number" aria-hidden="true">04</span><span class="cuknav__product-name"><span class="cuknav__desktop-label">Motorised Tracks</span><span class="cuknav__mobile-label" aria-hidden="true">Tracks</span></span><span class="cuknav__product-arrow" aria-hidden="true">↗</span></a>{% endif %}
        </nav>
        <div class="cuknav__campaign-support">
          {% if campaign_date <= 20261119 %}
            <a class="cuknav__christmas" href="/pages/fabric-library?view=browse-fabrics" aria-label="Home for Christmas, estimated delivery before Christmas">
              <svg class="cuknav__christmas-star" width="16" height="22" viewBox="0 0 30 48" fill="none" aria-hidden="true" focusable="false"><path d="M15 0v10" stroke="currentColor" opacity=".6"/><path d="m15 12 3.5 10.5L29 26l-10.5 3.5L15 40l-3.5-10.5L1 26l10.5-3.5L15 12Z" stroke="currentColor"/><path d="m15 19 1.8 5.2L22 26l-5.2 1.8L15 33l-1.8-5.2L8 26l5.2-1.8L15 19Z" fill="currentColor"/></svg>
              <span class="cuknav__christmas-copy"><strong><span class="cuknav__desktop-label">Home for Christmas</span><span class="cuknav__mobile-label" aria-hidden="true">Christmas</span></strong><span>Estimated delivery before Christmas</span></span>
            </a>
          {% endif %}
          <div class="cuknav__campaign-links">
            <a class="cuknav__room-action" href="{{ room_url }}" aria-label="Let us read your room"><span class="cuknav__desktop-label">Let us read your room</span><span class="cuknav__mobile-label" aria-hidden="true">Room advice</span> <span aria-hidden="true">→</span></a>
            <a class="cuknav__price-promise" href="/pages/price-promise">Price match <span aria-hidden="true">↗</span></a>
          </div>
          <a class="cuknav__help-call" href="tel:+448007720367" aria-label="Need help? Call CurtainsUK on 0800 772 0367, Monday to Friday, 9am to 5pm">
            <span>Need help? <strong>Call us</strong></span>
            <small>0800 772 0367 · Mon–Fri 9am–5pm</small>
          </a>
        </div>
      </div>
      <nav class="cuknav__secondary" aria-label="More from CurtainsUK">
        {% render 'curtainsuk-advisory-navigation', as_link: true %}
        <a href="{{ routes.root_url }}#curtainsuk-help">Contact</a>
      </nav>
      <div class="cuknav__tools">
        {% if page.handle == 'room-visualiser' or page.handle == 'cushion-studio' or page.handle == 'hotel-design-studio' or page.handle == 'smart-track-studio' %}<a class="cuknav__call-mini" href="tel:+448007720367" aria-label="Call CurtainsUK on 0800 772 0367, Monday to Friday, 9am to 5pm">Call</a>{% endif %}
        <a href="{{ routes.search_url }}" class="cuknav__icon" aria-label="Search" aria-controls="CukSearch-{{ section.id }}" aria-expanded="false" data-open="search">
          {{ 'icon-search.svg' | inline_asset_content }}
        </a>
      {%- if shop.customer_accounts_enabled and settings.curtainsuk_purchase_controls_enabled == true -%}
        <shopify-account
          menu="{{ settings.customer_account_menu | default: 'customer-account-main-menu' }}"
          class="cuknav__icon cuknav__account"
        >
          <span slot="signed-out-avatar" class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
          <span slot="signed-out-avatar" class="visually-hidden">{{ 'customer.log_in' | t }}</span>
        </shopify-account>
      {%- endif -%}


        {% if settings.curtainsuk_purchase_controls_enabled == true %}<a href="{{ routes.cart_url }}" class="cuknav__icon cuknav__cart cuknav__samples-cart" id="cart-icon-bubble" aria-label="Fabric samples cart">
          <svg viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false"><path d="M7 4.5h18v23H7z" stroke="currentColor" stroke-width="1.6"/><path d="M10 8h12v12H10z" fill="currentColor" fill-opacity=".16" stroke="currentColor" stroke-width="1.2"/><path d="M10 23h12" stroke="currentColor" stroke-width="1.2"/></svg>
          <span class="cuknav__tool-label" aria-hidden="true">Samples</span>
          {% if cart != empty %}
            <div class="cart-count-bubble"><span aria-hidden="true">{{ cart.item_count }}</span><span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span></div>
          {% endif %}
        </a>
        {% endif %}
        {% if settings.curtainsuk_rooms_enabled %}<a href="/pages/build-my-rooms" class="cuknav__icon cuknav__order-cart" aria-label="Shopping Cart, your saved made-to-measure order" data-cuk-order-shortcut>
          <svg viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false"><path d="M6 11h20l-1.5 16h-17L6 11Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M11 12V9a5 5 0 0 1 10 0v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
          <span class="cuknav__tool-label" aria-hidden="true">Order</span><span class="cuknav__order-count" data-cuk-order-count hidden></span>
        </a>{% endif %}
        {% for block in section.blocks %}{% render block %}{% endfor %}
      </div>
    </div>
    <nav class="cuknav__desktop" aria-label="Main navigation">
      {% render 'curtainsuk-header-navigation', location: 'desktop', section_id: section.id %}
    </nav>
  </header>
  <dialog class="cuknav__dialog cuknav__mobile" id="CukMenu-{{ section.id }}" aria-labelledby="CukMenuTitle-{{ section.id }}" data-dialog="menu">
    <div class="cuknav__dialog-top"><span class="cuknav__dialog-brand" id="CukMenuTitle-{{ section.id }}">CurtainsUK</span><button type="button" class="cuknav__icon" aria-label="Close menu" data-close>{{ 'icon-close.svg' | inline_asset_content }}</button></div>
    <div class="cuknav__mobile-body">
      <nav aria-label="Mobile navigation">{% render 'curtainsuk-header-navigation', location: 'mobile', section_id: section.id %}</nav>
      {% if shop.customer_accounts_enabled and settings.curtainsuk_purchase_controls_enabled == true %}<a class="cuknav__mobile-account" href="{{ routes.account_url }}">{{ 'customer.account.title' | t }} <span aria-hidden="true">→</span></a>{% endif %}
    </div>
  </dialog>
  <dialog class="cuknav__dialog cuknav__search" id="CukSearch-{{ section.id }}" aria-labelledby="CukSearchTitle-{{ section.id }}" data-dialog="search">
    <div class="cuknav__dialog-top"><span class="cuknav__dialog-brand" id="CukSearchTitle-{{ section.id }}">Search CurtainsUK</span><button type="button" class="cuknav__icon" aria-label="Close search" data-close>{{ 'icon-close.svg' | inline_asset_content }}</button></div>
        {%- if settings.predictive_search_enabled -%}
          <predictive-search class="search-modal__form" data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- else -%}
          <search-form class="search-modal__form">
        {%- endif -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="search search-modal__form">
          <div class="field">
            <input
              class="search__input field__input"
              id="CukSearchInput-{{ section.id }}"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ 'general.search.search' | t }}"
              {%- if settings.predictive_search_enabled -%}
                role="combobox"
                aria-expanded="false"
                aria-owns="predictive-search-results"
                aria-controls="predictive-search-results"
                aria-haspopup="listbox"
                aria-autocomplete="list"
                autocorrect="off"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
              {%- endif -%}
            >
            <label class="field__label" for="CukSearchInput-{{ section.id }}">{{ 'general.search.search' | t }}</label>
            <input type="hidden" name="options[prefix]" value="last">
            <button
              type="reset"
              class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
              aria-label="{{ 'general.search.reset' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-reset.svg' | inline_asset_content -}}
              </span>
            </button>
            <button class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
              <span class="svg-wrapper">
                {{- 'icon-search.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          {%- if settings.predictive_search_enabled -%}
            <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
              {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
            </div>

            <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
          {%- endif -%}
        </form>
        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- else -%}
          </search-form>
        {%- endif -%}

  </dialog>
  <noscript><nav class="cuknav__no-js" aria-label="Mobile navigation">{% render 'curtainsuk-header-navigation', location: 'fallback', section_id: section.id %}</nav></noscript>
</curtainsuk-header>
{% if settings.cart_type == 'notification' and settings.curtainsuk_purchase_controls_enabled == true %}
  {{ 'component-cart-notification.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>
  {% render 'cart-notification', color_scheme: section.settings.color_scheme, desktop_menu_type: 'dropdown' %}
{% endif %}
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

{% schema %}
{"name": "CurtainsUK studio header", "class": "section-cuk-header section-header", "enabled_on": {"groups": ["header"]}, "settings": [{"type": "color_scheme", "id": "color_scheme", "label": "Cart notification colour scheme", "default": "scheme-1"}], "blocks": [{"type": "@app"}], "presets": [{"name": "CurtainsUK studio header"}]}
{% endschema %}
