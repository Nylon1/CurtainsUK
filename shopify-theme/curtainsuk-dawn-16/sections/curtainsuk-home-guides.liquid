{{ 'curtainsuk-home-features.css' | asset_url | stylesheet_tag }}
<section class="cukfeature cukfeature--guides" id="homepage-guides" aria-labelledby="cukguides-title-{{ section.id }}">
  <div class="cukfeature__wrap">
    <div class="cukfeature__heading"><div><p class="cukfeature__eyebrow">{{ 'homepage_features.guides.eyebrow' | t }}</p><h2 id="cukguides-title-{{ section.id }}">{{ 'homepage_features.guides.title' | t }}</h2></div><p class="cukfeature__guide-intro">{{ 'homepage_features.guides.copy' | t }}</p></div>
    <div class="cukfeature__guide-grid">
      {% assign guides = 'use,measure,fit' | split: ',' %}
      {% for guide in guides %}
        {% liquid
          assign title_key = guide | prepend: 'homepage_features.guides.' | append: '_title'
          assign text_key = guide | prepend: 'homepage_features.guides.' | append: '_copy'
          assign alt_key = guide | prepend: 'homepage_features.guides.' | append: '_alt'
          assign cta_key = guide | prepend: 'homepage_features.guides.' | append: '_cta'
          case guide
            when 'use'
              assign destination = '/pages/how-to-use'
              assign artwork = 'cuk-home-living-daylight.webp'
              assign image_width = 1026
              assign image_height = 642
            when 'measure'
              assign destination = '/pages/how-to-measure'
              assign artwork = 'cuk-home-track-room.webp'
              assign image_width = 1536
              assign image_height = 1024
            when 'fit'
              assign destination = '/pages/how-to-fit'
              assign artwork = 'cuk-home-heading-wave.webp'
              assign image_width = 750
              assign image_height = 562
          endcase
        %}
        <a class="cukfeature__guide-card" href="{{ destination }}">
          <div class="cukfeature__guide-image"><img src="{{ artwork | asset_url }}" width="{{ image_width }}" height="{{ image_height }}" loading="lazy" decoding="async" alt="{{ alt_key | t | escape }}"><span class="cukfeature__guide-number" aria-hidden="true">0{{ forloop.index }}</span><span class="cukfeature__image-arrow" aria-hidden="true">↗</span></div>
          <div class="cukfeature__guide-copy"><h3>{{ title_key | t }}</h3><p>{{ text_key | t }}</p><span class="cukfeature__guide-link">{{ cta_key | t }} <span aria-hidden="true">→</span></span></div>
        </a>
      {% endfor %}
    </div>
    <a class="cukfeature__hanging-feature" href="/pages/how-to-hang-curtains" aria-label="Explore How to Hang Your Curtains">
      <span class="cukfeature__hanging-image"><img src="{{ 'cuk-home-heading-wave.webp' | asset_url }}" width="750" height="562" loading="lazy" decoding="async" alt="Wave curtains hanging in soft, even folds"></span>
      <span class="cukfeature__hanging-copy"><span class="cukfeature__hanging-eyebrow">After delivery · The hanging guide</span><strong>Hang them beautifully.</strong><span>Watch the film, choose your heading and make a plan with your measurements.</span><span class="cukfeature__hanging-link">Explore the hanging guides <span aria-hidden="true">↗</span></span></span>
    </a>
    <a class="cukfeature__hanging-feature cukfeature__roman-feature" href="/apps/curtainsuk-decision/roman/roman.html" aria-label="Explore CurtainsUK Roman blinds">
      <span class="cukfeature__hanging-image"><img src="{{ 'cuk-home-roman-lounge.jpg' | asset_url }}" width="1280" height="1280" loading="lazy" decoding="async" alt="Textured Roman blind in a softly lit lounge"></span>
      <span class="cukfeature__hanging-copy"><span class="cukfeature__hanging-eyebrow">Roman blinds · Made for your window</span><strong>Beautiful from every angle.</strong><span>Explore the folds, see your fabric in the room, and choose your exact size.</span><span class="cukfeature__hanging-link">Explore Roman blinds <span aria-hidden="true">↗</span></span></span>
    </a>
  </div>
</section>
<style>
  .cukfeature__hanging-feature{display:grid;grid-template-columns:1.1fr .9fr;min-height:360px;margin-top:clamp(40px,5vw,70px);background:#173d35;color:#f8f6ef!important;text-decoration:none;overflow:hidden}
  .cukfeature__hanging-image{display:block;min-height:360px;overflow:hidden}
  .cukfeature__hanging-image img{width:100%;height:100%;min-height:360px;object-fit:cover;transition:transform .5s}
  .cukfeature__hanging-feature:hover img{transform:scale(1.025)}
  .cukfeature__hanging-copy{display:flex;flex-direction:column;justify-content:center;align-items:flex-start;gap:20px;padding:clamp(30px,5vw,74px)}
  .cukfeature__hanging-eyebrow{font-size:10px;font-weight:600;letter-spacing:.17em;text-transform:uppercase;color:#d0d8ca}
  .cukfeature__hanging-copy strong{font:400 clamp(38px,4.4vw,65px)/1.05 Georgia,serif;letter-spacing:-.04em;max-width:11ch}
  .cukfeature__hanging-copy>span:nth-child(3){font-size:15px;line-height:1.7;max-width:28em;color:#e1e8de}
  .cukfeature__hanging-link{display:inline-flex;align-items:center;gap:25px;border-bottom:1px solid #e1e8de;padding-bottom:8px;margin-top:10px;font-size:12px;font-weight:600}
  .cukfeature__hanging-feature:focus-visible{outline:3px solid #173d35;outline-offset:5px}
  .cukfeature__roman-feature{background:#244038}
  @media(max-width:749px){.cukfeature__hanging-feature{grid-template-columns:1fr}.cukfeature__hanging-image,.cukfeature__hanging-image img{min-height:0;aspect-ratio:1.45}.cukfeature__hanging-copy{padding:30px 25px 36px}}
  @media(prefers-reduced-motion:reduce){.cukfeature__hanging-image img{transition:none}}
</style>
{% schema %}
{"name":"Homepage visual guides","tag":"section","class":"section","enabled_on":{"templates":["index"]},"settings":[],"presets":[{"name":"Homepage visual guides"}]}
{% endschema %}
