{% capture cuk_environment %}{% render 'curtainsuk-environment' %}{% endcapture %}
{{ 'curtainsuk-storefront.css' | asset_url | stylesheet_tag }}
{{ 'curtainsuk-premium.css' | asset_url | stylesheet_tag }}
<section class="cuk-shell cuk-editorial-hero">
  <div class="cuk-editorial-hero__copy">
    <p class="cuk-eyebrow">A home that feels like you</p>
    <h1>Beautiful curtains.<br><em>Considered for you.</em></h1>
    <p class="cuk-lede">The right fabric changes how a room feels. Discover your favourites, find your finish, and make something entirely your own.</p>
    <a class="cuk-button" href="#cuk-fabric-discovery">Help me find the perfect curtains <span aria-hidden="true">↗</span></a>
    {% unless cuk_environment contains 'production' %}<p class="cuk-editorial-note">Private preview · Our guided consultation is currently for internal review.</p>{% endunless %}
    <a class="cuk-text-link" href="#cuk-shop-your-way">I know what I want <span aria-hidden="true">↓</span></a>
  </div>
  <figure class="cuk-editorial-hero__image">
    <img src="https://cdn.shopify.com/s/files/1/0256/4551/4861/files/cuk-fabric-89269d7f5a0afea8751ad4b927605c077bd71460e879dafbaf96c2dba1092a44.jpg?width=1200" width="1200" height="1200" alt="Painterly flowers and garden vases in Sanderson Painters Garden, Violet/Crimson" fetchpriority="high" sizes="(max-width:749px) 100vw, 55vw">
    <figcaption>THE FABRIC EDIT <span>Sanderson · Painters Garden</span></figcaption>
  </figure>
</section>
<div id="cuk-fabric-discovery">{% render 'curtainsuk-fabric-discovery' %}</div>
<section id="cuk-shop-your-way" class="cuk-shell cuk-shop-your-way cuk-wrap">
  <div><p class="cuk-eyebrow">Your home. Your starting point.</p><h2>Find your own way in.</h2></div>
  <a href="/pages/solve-my-window"><span class="cuk-route-number">01</span><h3>Start with your window</h3><p>From a simple pair to a beautiful bay.</p><span class="cuk-text-link">Shop by Window ↗</span></a>
  <a href="/pages/fabric-library"><span class="cuk-route-number">02</span><h3>Fall for a fabric</h3><p>Explore colour, texture and pattern from the brands you love.</p><span class="cuk-text-link">Shop by Fabric ↗</span></a>
</section>
<section class="cuk-shell cuk-reassurance cuk-wrap" aria-label="Made for your home"><span>Made to your measurements</span><span>Sample in your own light</span><span>Specialist help when you need it</span></section>
