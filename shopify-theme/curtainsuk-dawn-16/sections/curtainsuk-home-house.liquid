{% if settings.curtainsuk_rooms_enabled %}
  {{ 'curtainsuk-home-house.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'curtainsuk-home-house.js' | asset_url }}" defer></script>
  <section class="cukhouse-home" data-cuk-home-house data-house-hero="{{ 'cuk-rooms-editorial-hero-v1.png' | asset_url }}">
    <div class="cukhouse-home__wrap">
      <div class="cukhouse-home__copy">
        <p class="cukhouse-home__eyebrow">Design My Home</p>
        <h2>Real Homes. Room by Room.</h2>
        <p>Start with one cushion or a pair of curtains. Bring your choices together in one order, with rooms whenever you need them.</p>
        <a class="cukhouse-home__button" href="/pages/build-my-rooms">Design My Home</a>
      </div>
      <div class="cukhouse-home__visual">
        <img src="{{ 'cuk-rooms-editorial-hero-v1.png' | asset_url }}" width="1536" height="1024" loading="lazy" alt="Room inspiration with neutral curtains">
        <p>Room inspiration</p>
      </div>
    </div>
  </section>
{% endif %}
{% schema %}
{"name":"Design My Home","settings":[],"presets":[{"name":"Design My Home"}]}
{% endschema %}
