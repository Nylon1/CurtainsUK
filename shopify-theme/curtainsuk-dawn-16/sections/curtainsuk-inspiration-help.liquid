{{ 'curtainsuk-home-features.css' | asset_url | stylesheet_tag }}
<section class="cukfeature cukfeature--windows" id="curtainsuk-inspiration" aria-labelledby="cukwindows-title-{{ section.id }}">
  <div class="cukfeature__wrap cukfeature__split">
    <div class="cukfeature__visual">
      <a class="cukfeature__image-link cukfeature__window-image" href="/pages/solve-my-window" aria-label="{{ 'homepage_features.windows.cta' | t | escape }}">
        {% assign window_alt = 'homepage_features.windows.image_alt' | t %}
        {{ images['curtainsuk-modern-luxury-interior.jpg'] | image_url: width: 1100 | image_tag: widths: '360, 540, 750, 1100', sizes: '(min-width: 1000px) 52vw, 100vw', loading: 'lazy', alt: window_alt }}
        <span class="cukfeature__image-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="cukfeature__copy">
      <p class="cukfeature__eyebrow">{{ 'homepage_features.windows.eyebrow' | t }}</p>
      <h2 id="cukwindows-title-{{ section.id }}">{{ 'homepage_features.windows.title' | t }}</h2>
      <p class="cukfeature__intro">{{ 'homepage_features.windows.copy' | t }}</p>
      <a class="cukfeature__button" href="/pages/solve-my-window">{{ 'homepage_features.windows.cta' | t }} <span aria-hidden="true">↗</span></a>
      <p class="cukfeature__consultation-note">{{ 'homepage_features.windows.note' | t }}</p>
    </div>
  </div>
</section>
{% schema %}
{"name":"Shop by window feature","tag":"section","class":"section","settings":[],"presets":[{"name":"Shop by window feature"}]}
{% endschema %}
