{{ 'curtainsuk-storefront.css' | asset_url | stylesheet_tag }}

{% if page.handle == 'measure' or page.handle == 'measure-guide' %}
<section class="cuk-shell cuk-section">
  <div class="cuk-wrap">
    <p class="cuk-eyebrow">Measure once, describe the basis</p>
    <h1 class="cuk-title">Measure the window, not the curtain</h1>
    <p class="cuk-lede">Use centimetres and enter the full coverage width from either the fitted track or the usable span of the pole. The decision engine calculates finished curtain requirements.</p>
    <div class="cuk-grid cuk-section">
      <article class="cuk-card"><span class="cuk-card__shape">1</span><span><h3>Choose the basis</h3><p>Track width or pole usable width is stored explicitly.</p></span></article>
      <article class="cuk-card"><span class="cuk-card__shape">2</span><span><h3>Record width</h3><p>Measure the complete span the curtains must cover.</p></span></article>
      <article class="cuk-card"><span class="cuk-card__shape">3</span><span><h3>Record drop</h3><p>Measure from the chosen fixing point to the intended finished level.</p></span></article>
      <article class="cuk-card"><span class="cuk-card__shape">4</span><span><h3>Add shape evidence</h3><p>For a bay, record each section width; no angles are needed for curtain pricing. Specialist shapes also need clear photographs.</p></span></article>
    </div>
    <div class="cuk-notice">Values that appear to be millimetres entered as centimetres, or mathematically inconsistent specialist geometry, are rejected or routed to review.</div>
  </div>
</section>
{% endif %}

{% schema %}
{ "name": "CurtainsUK measure guide", "tag": "section", "class": "section", "settings": [], "presets": [{ "name": "CurtainsUK measure guide" }] }
{% endschema %}
