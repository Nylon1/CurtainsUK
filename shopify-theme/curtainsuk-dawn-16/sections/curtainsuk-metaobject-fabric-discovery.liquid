{%- assign canonical = metaobject.canonical_url.value -%}
{%- assign image = metaobject.image_url.value -%}
{%- assign sample_price = metaobject.sample_price.value | default: '2.50' -%}
{%- assign colour = metaobject.knowledge_colour.value -%}
{%- assign pattern = metaobject.knowledge_pattern.value -%}
{%- assign activity = metaobject.knowledge_activity.value -%}
{%- assign surface = metaobject.knowledge_surface.value -%}
{%- assign finish = metaobject.knowledge_finish.value -%}
{%- assign weight = metaobject.knowledge_weight.value -%}
{%- assign character = metaobject.knowledge_character.value -%}
{%- assign activity_display = activity | downcase -%}
{%- if activity_display contains 'busy' -%}{%- assign activity_display = 'Expressive' -%}{%- elsif activity_display contains 'quiet' -%}{%- assign activity_display = 'Quiet' -%}{%- else -%}{%- assign activity_display = 'Balanced' -%}{%- endif -%}
<section class="cuk-profile" data-cuk-canonical-fabric-detail data-fabric-master-id="{{ metaobject.fabric_master_id.value | escape }}" data-purchase-controls-enabled="{{ settings.curtainsuk_purchase_controls_enabled }}" data-engine-base="/apps/curtainsuk-decision">
  <div class="cuk-profile__wrap">
    <nav class="cuk-profile__crumb" aria-label="Breadcrumb"><a href="/pages/fabric-library?view=browse-fabrics">Fabrics</a><span>/</span><span>{{ metaobject.brand.value | escape }}</span><span>/</span><span>{{ metaobject.design.value | escape }}</span></nav>
    <header class="cuk-profile__hero">
      <figure class="cuk-profile__hero-image"><img src="{{ image | escape }}" alt="{{ metaobject.image_alt.value | escape }}" width="1200" height="1200" fetchpriority="high"><figcaption>Actual supplier fabric image</figcaption></figure>
      <div class="cuk-profile__hero-copy"><p class="cuk-profile__eyebrow">{{ metaobject.brand.value | escape }}</p><h1>{{ metaobject.design.value | escape }} — {{ metaobject.colourway.value | escape }}</h1>{%- if character != blank -%}<p class="cuk-profile__character">{{ character | remove: 'Character:' | replace: ',', '. ' | escape }}.</p>{%- endif -%}<div class="cuk-profile__offer"><p>Fabric sample — £{{ sample_price | escape }}</p><small>Free UK mainland delivery</small><div class="cuk-profile__actions"><button type="button" class="cuk-profile__button cuk-profile__button--primary" data-sample>Order sample</button><a class="cuk-profile__button" href="/pages/curtain-visualiser?fabric={{ metaobject.fabric_master_id.value | url_encode }}">Make curtains</a></div><small class="cuk-profile__fine">One physical fabric sample.</small></div><a class="cuk-profile__intelligence-link" href="/apps/curtainsuk-decision/consultation?experience=premium&amp;entry=match">Explore this fabric with Fabric Intelligence <span>↗</span></a></div>
    </header>
    <nav class="cuk-profile__jump" aria-label="Fabric profile sections">{%- if colour != blank or pattern != blank or activity != blank or surface != blank or finish != blank or weight != blank or metaobject.knowledge_advice.value != blank or character != blank -%}<span>Inside this fabric</span>{%- endif -%}{%- if colour != blank -%}<a href="#cuk-colour">Colour</a>{%- endif -%}{%- if pattern != blank or activity != blank -%}<a href="#cuk-pattern">Pattern</a>{%- endif -%}{%- if surface != blank or finish != blank or weight != blank -%}<a href="#cuk-material">Surface &amp; feel</a>{%- endif -%}{%- if metaobject.knowledge_advice.value != blank or character != blank -%}<a href="#cuk-room">In the room</a>{%- endif -%}{%- if metaobject.supplier_facts.value != blank -%}<a href="#cuk-facts">Facts</a>{%- endif -%}</nav>
    {%- if colour != blank -%}<section class="cuk-profile__colour" id="cuk-colour" aria-labelledby="cuk-colour-title"><header><p class="cuk-profile__eyebrow">Inside this fabric</p><h2 id="cuk-colour-title">The colour story.</h2></header><div class="cuk-profile__colour-grid"><figure><img src="{{ image | escape }}" alt="Detail of {{ metaobject.design.value | escape }} in {{ metaobject.colourway.value | escape }}"></figure><div><h3>{{ metaobject.colourway.value | escape }} at the heart of the scheme.</h3><p class="cuk-profile__knowledge">{{ colour | remove: 'Colour:' | replace: ',', ' · ' | newline_to_br }}</p><p>See the colour and surface in your own light before deciding how it will sit with the rest of the room.</p></div></div></section>{%- endif -%}
    {%- if pattern != blank or activity != blank -%}<section class="cuk-profile__pattern" id="cuk-pattern" aria-labelledby="cuk-pattern-title"><div><p class="cuk-profile__eyebrow">Pattern &amp; movement</p><h2 id="cuk-pattern-title">{%- if pattern != blank -%}{{ pattern | remove: 'Pattern:' | split: ',' | first | strip | capitalize | escape }}{%- else -%}A considered surface.{%- endif -%}</h2>{%- if pattern != blank -%}<p class="cuk-profile__motifs">{{ pattern | remove: 'Pattern:' | replace: ',', ' · ' | escape }}</p>{%- endif -%}{%- if activity != blank -%}<div class="cuk-profile__activity"><div><span>Visual activity</span><strong>{{ activity_display }}</strong></div><div class="cuk-profile__track cuk-profile__track--{{ activity_display | downcase }}" aria-hidden="true"></div><div class="cuk-profile__track-labels"><span>Quiet</span><span>Balanced</span><span>Expressive</span></div><span class="visually-hidden">{{ activity | escape }}</span></div>{%- endif -%}</div><figure><img src="{{ image | escape }}" alt="Close crop of {{ metaobject.design.value | escape }} pattern"></figure></section>{%- endif -%}
    {%- if surface != blank or finish != blank or weight != blank -%}<section class="cuk-profile__material" id="cuk-material" aria-label="Surface, finish and visual presence">{%- if surface != blank -%}<article><p>Texture / surface</p><h3>{{ surface | remove: 'Texture / surface:' | remove: 'Texture:' | escape }}</h3></article>{%- endif -%}{%- if finish != blank -%}<article><p>Finish / sheen</p><h3>{{ finish | remove: 'Finish / sheen:' | remove: 'Finish:' | escape }}</h3></article>{%- endif -%}{%- if weight != blank -%}<article><p>Visual presence</p><h3>{{ weight | remove: 'Visual weight / presence:' | remove: 'Visual weight:' | escape }}</h3></article>{%- endif -%}</section>{%- endif -%}
  </div>
  {%- if metaobject.knowledge_advice.value != blank or character != blank -%}<section class="cuk-profile__room" id="cuk-room" aria-labelledby="cuk-room-title"><div class="cuk-profile__wrap cuk-profile__room-grid"><header><p class="cuk-profile__eyebrow">CurtainsUK interior interpretation</p><h2 id="cuk-room-title">In the room.</h2>{%- if character != blank -%}<p>{{ character | remove: 'Character:' | replace: ',', '. ' | escape }}.</p>{%- endif -%}</header><div class="cuk-profile__guidance">{%- assign advice_lines = metaobject.knowledge_advice.value | split: '\n' -%}{%- for line in advice_lines -%}{%- assign text = line | strip -%}{%- if text != blank -%}{%- assign label = text | split: ':' | first | strip -%}{%- assign body = text | remove: label | remove_first: ':' | strip -%}<article><h3>{{ label | escape }}</h3><p>{{ body | escape }}</p></article>{%- endif -%}{%- endfor -%}</div></div></section>{%- endif -%}
  {%- if metaobject.supplier_facts.value != blank -%}<section class="cuk-profile__facts cuk-profile__wrap" id="cuk-facts" aria-labelledby="cuk-facts-title"><header><p class="cuk-profile__eyebrow">Supplier facts</p><h2 id="cuk-facts-title">The fabric,<br>precisely.</h2><p>Specifications for this exact supplier colourway, separate from CurtainsUK’s interior interpretation.</p></header><dl>{%- assign facts = metaobject.supplier_facts.value | split: '\n' -%}{%- for fact in facts -%}{%- assign item = fact | strip -%}{%- if item != blank -%}{%- assign label = item | split: ':' | first | strip -%}{%- assign value = item | remove: label | remove_first: ':' | strip -%}<div><dt>{{ label | escape }}</dt><dd>{{ value | escape }}</dd></div>{%- endif -%}{%- endfor -%}</dl></section>{%- endif -%}
  <section class="cuk-profile__closing cuk-profile__wrap"><div><p class="cuk-profile__eyebrow">From screen to space</p><h2>See it in your own light.</h2><p>Check the colour and surface alongside the furnishings you already love.</p></div><div class="cuk-profile__actions"><button type="button" class="cuk-profile__button cuk-profile__button--primary" data-sample>Order sample — £{{ sample_price | escape }}</button><a class="cuk-profile__button" href="/apps/curtainsuk-decision/consultation?experience=premium&amp;entry=match">Fabric Intelligence ↗</a></div></section>
</section>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Product","name":{{ metaobject.display_title.value | append: ' Curtain Fabric Sample' | json }},"sku":{{ 'cuk-sample:' | append: metaobject.fabric_master_id.value | json }},"brand":{"@type":"Brand","name":{{ metaobject.brand.value | json }}},"color":{{ metaobject.colourway.value | json }},"image":[{{ image | json }}],"description":{{ metaobject.sample_offer_label.value | append: '. This offer is for one physical fabric sample only, not fabric by the metre or made-to-measure curtains.' | json }},"url":{{ canonical | json }},"offers":{"@type":"Offer","url":{{ canonical | json }},"priceCurrency":"GBP","price":{{ sample_price | json }},"availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition"}}</script>
<script src="{{ 'curtainsuk-sample-checkout.js' | asset_url }}" defer="defer"></script>
<script>document.querySelectorAll('[data-cuk-canonical-fabric-detail] [data-sample]').forEach(function(button){button.addEventListener('click',function(){const root=document.querySelector('[data-cuk-canonical-fabric-detail]');let consultationContext=null;try{const saved=JSON.parse(window.localStorage.getItem('curtainsuk:hci:commerce')||'null');if(saved?.fabricMasterId===root?.dataset.fabricMasterId)consultationContext=saved}catch(_){}window.dispatchEvent(new CustomEvent('curtainsuk:sample-add',{detail:{root,sample:{fabricId:root?.dataset.fabricMasterId,design:{{ metaobject.design.value | json }},colour:{{ metaobject.colourway.value | json }},consultationContext:consultationContext},button:this}}))})});</script>
{% stylesheet %}
.cuk-profile{--p:#fcfaf5;--c:#f7f4eb;--f:#193f35;--m:#66716a;--l:#d9ddce;--s:#e6e8dc;background:var(--c);color:var(--f);font:15px/1.6 Arial,Helvetica,sans-serif;padding:1px 0}.cuk-profile *{box-sizing:border-box}.cuk-profile h1,.cuk-profile h2,.cuk-profile h3{font-family:Georgia,'Times New Roman',serif;font-weight:400;letter-spacing:-.04em;line-height:1.08}.cuk-profile h1{font-size:clamp(42px,4.4vw,68px);margin:0}.cuk-profile h2{font-size:clamp(35px,3.3vw,50px);margin:10px 0}.cuk-profile h3{font-size:30px;margin:0}.cuk-profile__wrap{width:min(1280px,calc(100% - 112px));margin:auto}.cuk-profile__crumb{display:flex;gap:10px;margin:24px 0;font-size:11px;color:var(--m)}.cuk-profile__crumb a,.cuk-profile__jump a,.cuk-profile__intelligence-link{color:inherit;text-decoration:none}.cuk-profile__hero{display:grid;grid-template-columns:1.2fr 1fr;gap:72px;align-items:center}.cuk-profile__hero-image{margin:0}.cuk-profile__hero-image img{width:100%;aspect-ratio:1.05;object-fit:cover;display:block}.cuk-profile__hero-image figcaption{font-size:10px;color:var(--m);margin-top:8px}.cuk-profile__eyebrow{margin:0;text-transform:uppercase;letter-spacing:.18em;font-size:10px;font-weight:bold}.cuk-profile__hero-copy h1{margin:18px 0}.cuk-profile__character{font:23px/1.5 Georgia,serif;color:#627160;margin:0 0 38px}.cuk-profile__offer{border-top:1px solid var(--l);padding-top:23px}.cuk-profile__offer>p{font-size:18px;margin:0}.cuk-profile__offer small{font-size:11px;color:var(--m)}.cuk-profile__actions{display:flex;gap:12px;margin-top:17px}.cuk-profile__button{display:inline-flex;align-items:center;justify-content:center;min-height:50px;border:1px solid var(--f);padding:12px 23px;background:transparent;color:var(--f);font-size:12px;text-decoration:none;flex:1}.cuk-profile__button--primary{background:var(--f);color:var(--p)}.cuk-profile__fine{display:block;margin-top:8px;text-align:center}.cuk-profile__intelligence-link{display:flex;justify-content:space-between;margin-top:28px;padding-bottom:5px;border-bottom:1px solid #aeb8a7;font-size:12px}.cuk-profile__jump{display:flex;justify-content:center;gap:28px;border-block:1px solid var(--l);margin-top:48px;padding:16px 0;font-size:11px}.cuk-profile__jump span{letter-spacing:.15em;text-transform:uppercase;color:var(--m);font-size:10px}.cuk-profile__colour{padding:76px 0 70px}.cuk-profile__colour header,.cuk-profile__colour-grid,.cuk-profile__pattern,.cuk-profile__material{width:min(1280px,calc(100% - 112px));margin:auto}.cuk-profile__colour-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:72px;align-items:center;margin-top:38px}.cuk-profile__colour-grid figure{margin:0;height:405px;overflow:hidden}.cuk-profile__colour-grid img{width:100%;height:100%;object-fit:cover;transform:scale(1.55)}.cuk-profile__colour-grid h3{font-size:34px}.cuk-profile__knowledge{font:20px/1.5 Georgia,serif;margin:24px 0}.cuk-profile__colour-grid>div>p:last-child{font-size:12px;line-height:1.8}.cuk-profile__pattern{display:grid;grid-template-columns:1fr 1.05fr;gap:84px;align-items:center;padding:74px 0 64px;border-bottom:1px solid var(--l)}.cuk-profile__pattern figure{height:305px;margin:0;overflow:hidden}.cuk-profile__pattern img{width:100%;height:100%;object-fit:cover;transform:scale(2.3)}.cuk-profile__motifs{font-size:12px;margin:22px 0 30px}.cuk-profile__activity{max-width:400px}.cuk-profile__activity>div:first-child{display:flex;justify-content:space-between;font-size:11px}.cuk-profile__activity strong{font:21px Georgia,serif}.cuk-profile__track{height:2px;background:#b5bfae;position:relative;margin-top:16px}.cuk-profile__track:before{content:'';display:block;height:2px;background:var(--f);width:50%}.cuk-profile__track--expressive:before{width:86%}.cuk-profile__track--quiet:before{width:17%}.cuk-profile__track:after{content:'';position:absolute;top:-4px;left:calc(50% - 5px);width:10px;height:10px;border-radius:50%;background:var(--f);border:2px solid var(--c);outline:1px solid var(--f)}.cuk-profile__track--expressive:after{left:calc(86% - 5px)}.cuk-profile__track--quiet:after{left:calc(17% - 5px)}.cuk-profile__track-labels{display:flex;justify-content:space-between;font-size:10px;color:var(--m);margin-top:10px}.cuk-profile__material{display:grid;grid-template-columns:repeat(3,1fr);gap:55px;padding:48px 0 58px}.cuk-profile__material article p{margin:0 0 8px;text-transform:uppercase;letter-spacing:.15em;font-size:10px;color:var(--m)}.cuk-profile__material h3{font-size:25px}.cuk-profile__room{background:var(--s);padding:68px 0}.cuk-profile__room-grid{display:grid;grid-template-columns:.8fr 1.4fr;gap:84px}.cuk-profile__room header>p:last-child{font:24px/1.45 Georgia,serif;color:#63735e;margin:20px 0}.cuk-profile__guidance{display:grid;grid-template-columns:1fr 1fr;gap:40px 36px}.cuk-profile__guidance article{border-top:1px solid #bac3b0;padding-top:17px}.cuk-profile__guidance h3{font-size:25px;margin:0 0 12px}.cuk-profile__guidance p{font-size:12px;line-height:1.9;margin:0}.cuk-profile__facts{display:grid;grid-template-columns:1fr 1.3fr;gap:110px;padding-block:78px}.cuk-profile__facts header>p:last-child{font-size:12px;color:var(--m);margin-top:18px}.cuk-profile__facts dl{margin:0}.cuk-profile__facts dl>div{display:grid;grid-template-columns:1fr 1.25fr;gap:20px;border-bottom:1px solid var(--l);padding:11px 0;font-size:11px}.cuk-profile__facts dt{color:var(--m)}.cuk-profile__facts dd{margin:0}.cuk-profile__closing{display:flex;align-items:center;justify-content:space-between;gap:60px;border-top:1px solid var(--l);padding:43px 0 55px}.cuk-profile__closing h2{font-size:37px}.cuk-profile__closing>div>p:last-child{font-size:12px;color:var(--m)}.cuk-profile__closing .cuk-profile__actions{min-width:330px}.visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
@media(max-width:700px){.cuk-profile{font-size:14px}.cuk-profile__wrap,.cuk-profile__colour header,.cuk-profile__colour-grid,.cuk-profile__pattern,.cuk-profile__material{width:calc(100% - 40px)}.cuk-profile__crumb{margin:20px 0 18px;font-size:10px}.cuk-profile__hero{display:block}.cuk-profile__hero-image img{aspect-ratio:1.18}.cuk-profile__hero-image figcaption{display:none}.cuk-profile__hero-copy{padding-top:23px}.cuk-profile h1{font-size:39px}.cuk-profile__character{font-size:18px;margin-bottom:20px}.cuk-profile__offer{padding-top:18px}.cuk-profile__actions{display:grid;grid-template-columns:1fr;gap:10px}.cuk-profile__button{min-height:46px}.cuk-profile__offer .cuk-profile__button:not(.cuk-profile__button--primary){border:0;text-decoration:underline;text-underline-offset:5px;min-height:38px}.cuk-profile__intelligence-link{border-top:1px solid var(--l);border-bottom:0;padding:10px 0;margin-top:20px}.cuk-profile__jump{justify-content:space-between;gap:8px;margin-top:17px;padding:13px 0;font-size:9px}.cuk-profile__jump span{display:none}.cuk-profile__colour{padding:42px 0}.cuk-profile h2{font-size:34px}.cuk-profile__colour-grid{display:block;margin-top:22px}.cuk-profile__colour-grid figure{height:230px}.cuk-profile__colour-grid h3{font-size:28px;margin-top:22px}.cuk-profile__knowledge{font-size:18px}.cuk-profile__pattern{display:block;padding:43px 0 35px}.cuk-profile__pattern figure{height:170px;margin-top:25px}.cuk-profile__material{display:block;padding:18px 0 24px}.cuk-profile__material article{display:grid;grid-template-columns:1fr 1fr;padding:18px 0;border-bottom:1px solid var(--l)}.cuk-profile__material article:last-child{border:0}.cuk-profile__material h3{text-align:right;font-size:20px}.cuk-profile__room{padding:40px 0}.cuk-profile__room-grid{display:block}.cuk-profile__guidance{display:block;margin-top:26px}.cuk-profile__guidance article{margin-top:23px}.cuk-profile__facts{display:block;padding-block:43px}.cuk-profile__facts dl{margin-top:24px}.cuk-profile__facts dl>div{font-size:10px;grid-template-columns:.95fr 1.15fr}.cuk-profile__closing{display:block;padding:29px 0 36px}.cuk-profile__closing h2{font-size:31px}.cuk-profile__closing .cuk-profile__actions{min-width:0}.cuk-profile__closing .cuk-profile__button:not(.cuk-profile__button--primary){border:0;text-decoration:underline;text-underline-offset:5px;min-height:38px}}
{% endstylesheet %}
{% schema %}{"name":"Fabric discovery","tag":"section","class":"section","settings":[]}{% endschema %}
