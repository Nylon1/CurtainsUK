{%- assign canonical = metaobject.canonical_url.value -%}
{%- assign image = metaobject.image_url.value -%}
{%- assign sample_price = metaobject.sample_price.value | default: '2.50' -%}
{%- assign colour = metaobject.knowledge_colour.value -%}
{%- assign pattern = metaobject.knowledge_pattern.value -%}
{%- assign activity = metaobject.knowledge_activity.value -%}
{%- assign surface = metaobject.knowledge_surface.value -%}
{%- assign finish = metaobject.knowledge_finish.value -%}
{%- assign weight = metaobject.knowledge_weight.value -%}
{%- assign character = metaobject.knowledge_character.value -%}
{%- assign activity_display = activity | downcase -%}
{%- if activity_display contains 'busy' -%}{%- assign activity_display = 'Expressive' -%}{%- elsif activity_display contains 'quiet' -%}{%- assign activity_display = 'Quiet' -%}{%- else -%}{%- assign activity_display = 'Balanced' -%}{%- endif -%}
{%- assign pattern_display = pattern | remove: 'Pattern:' | split: ',' | first | strip -%}
{%- assign colour_display = colour | remove: 'Colour:' | strip -%}
{%- assign surface_display = surface | remove: 'Texture / surface:' | remove: 'Texture:' | strip -%}
{%- assign finish_display = finish | remove: 'Finish / sheen:' | remove: 'Finish:' | strip -%}
{%- assign weight_display = weight | remove: 'Visual weight / presence:' | remove: 'Visual weight:' | remove: 'Presence:' | strip -%}
{%- assign character_display = character | remove: 'Character:' | strip -%}
{%- assign make_curtains_url = '/pages/curtain-visualiser?fabric=' | append: metaobject.fabric_master_id.value -%}

<section class="cuk-profile" data-cuk-canonical-fabric-detail data-fabric-master-id="{{ metaobject.fabric_master_id.value | escape }}" data-purchase-controls-enabled="{{ settings.curtainsuk_purchase_controls_enabled }}" data-engine-base="/apps/curtainsuk-decision">
  <div class="cuk-profile__wrap">
    <nav class="cuk-profile__crumb" aria-label="Breadcrumb"><a href="/pages/fabric-library?view=browse-fabrics">Fabric collection</a><span aria-hidden="true">/</span><span>{{ metaobject.brand.value | escape }}</span></nav>
    <header class="cuk-profile__hero" data-cuk-profile-hero>
      <figure class="cuk-profile__hero-image"><img src="{{ image | escape }}" alt="{{ metaobject.image_alt.value | escape }}" width="1200" height="1200" fetchpriority="high"><figcaption>Original supplier fabric photography</figcaption></figure>
      <div class="cuk-profile__hero-copy">
        <p class="cuk-profile__eyebrow">{{ metaobject.brand.value | escape }} <span>Fabric collection</span></p>
        <h1>{{ metaobject.design.value | escape }}</h1>
        <p class="cuk-profile__colourway">{{ metaobject.colourway.value | escape }}</p>
        <div class="cuk-profile__chips" aria-label="Fabric at a glance">
          {%- if pattern_display != blank -%}<span>{{ pattern_display | capitalize | escape }}</span>{%- endif -%}
          {%- if surface_display != blank -%}<span>{{ surface_display | replace: '-', ' ' | escape }}</span>{%- endif -%}
          {%- if activity != blank -%}<span>{{ activity_display | escape }} character</span>{%- endif -%}
        </div>
        {%- if character_display != blank -%}<p class="cuk-profile__hero-description">{{ character_display | escape }}</p>{%- endif -%}
        <div class="cuk-profile__purchase">
          <div class="cuk-profile__purchase-heading"><div><span>Experience the fabric</span><strong>Sample £{{ sample_price | escape }}</strong></div><span class="cuk-profile__purchase-marker" aria-hidden="true">01 / 02</span></div>
          <p>See the real colour and texture in your own light. Free UK mainland sample delivery.</p>
          <div class="cuk-profile__actions"><button type="button" class="cuk-profile__button cuk-profile__button--primary" data-sample>Order sample · £{{ sample_price | escape }}</button><a class="cuk-profile__button cuk-profile__button--secondary" href="{{ make_curtains_url | escape }}">Make curtains with this fabric</a></div>
          <p class="cuk-profile__status" data-cuk-sample-status role="status" aria-live="polite"></p>
          <p class="cuk-profile__lead">Typical made-to-measure lead time: 4–5 weeks</p>
        </div>
        <a class="cuk-profile__hero-fi" href="#cuk-intelligence">Explore this fabric with Fabric Intelligence <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <div class="cuk-profile__trust" aria-label="Why CurtainsUK"><span>Made to measure</span><span>Sample before you decide</span><span>Typical 4–5 week lead time</span><span>UK service</span></div>
    <section class="cuk-profile__proposition" aria-labelledby="cuk-proposition-title"><div><p class="cuk-profile__eyebrow">Made to measure offer</p><h2 id="cuk-proposition-title">Save up to 50%<br><em>on selected made-to-measure curtains.</em></h2></div><div><p>Explore eligible styles, then choose the heading, lining and measurements that make this fabric feel at home. Offer applies to selected curtains.</p><a href="{{ make_curtains_url | escape }}">Make curtains with this fabric <span aria-hidden="true">↗</span></a></div></section>
    <section class="cuk-profile__styles" aria-labelledby="cuk-styles-title"><div class="cuk-profile__section-head"><p class="cuk-profile__eyebrow">Made to measure</p><h2 id="cuk-styles-title">Choose the way it falls.</h2><p>{{ 'curtainsuk_headings.subtitle' | t }}</p></div><div class="cuk-profile__style-grid">
      <article class="cuk-profile__style-card"><div class="cuk-profile__style-art">{% render 'curtainsuk-heading-preview', image_url: image, heading: 'wave', preview_id: section.id %}</div><span class="cuk-profile__style-number">01</span><h3>Wave</h3><p>Clean, contemporary folds with a consistent flowing shape.</p><a href="{{ make_curtains_url | escape }}">Explore Wave <span aria-hidden="true">↗</span></a></article>
      <article class="cuk-profile__style-card"><div class="cuk-profile__style-art">{% render 'curtainsuk-heading-preview', image_url: image, heading: 'pinch', preview_id: section.id %}</div><span class="cuk-profile__style-number">02</span><h3>Pinch Pleat</h3><p>Tailored and structured with a more luxurious traditional finish.</p><a href="{{ make_curtains_url | escape }}">Explore Pinch Pleat <span aria-hidden="true">↗</span></a></article>
      <article class="cuk-profile__style-card"><div class="cuk-profile__style-art">{% render 'curtainsuk-heading-preview', image_url: image, heading: 'pencil', preview_id: section.id %}</div><span class="cuk-profile__style-number">03</span><h3>Pencil Pleat</h3><p>Versatile, familiar and suited to a wide range of interiors.</p><a href="{{ make_curtains_url | escape }}">Explore Pencil Pleat <span aria-hidden="true">↗</span></a></article>
      <article class="cuk-profile__style-card"><div class="cuk-profile__style-art">{% render 'curtainsuk-heading-preview', image_url: image, heading: 'eyelet', preview_id: section.id %}</div><span class="cuk-profile__style-number">04</span><h3>{{ 'curtainsuk_headings.eyelet' | t }}</h3><p>{{ 'curtainsuk_headings.eyelet_description' | t }}</p><a href="{{ make_curtains_url | escape }}">{{ 'curtainsuk_headings.eyelet_link' | t }} <span aria-hidden="true">↗</span></a></article>
    </div></section>
  </div>

  <section class="cuk-profile__intelligence" id="cuk-intelligence" aria-labelledby="cuk-intelligence-title"><div class="cuk-profile__wrap cuk-profile__intelligence-grid"><div><p class="cuk-profile__eyebrow">A better way to choose</p><h2 id="cuk-intelligence-title">Fabric<br><em>Intelligence.</em></h2><p>Our AI-powered fabric intelligence analyses colour, pattern, visual weight, surface and character to help you understand how this fabric may work in a room.</p><a class="cuk-profile__button cuk-profile__button--light" href="/apps/curtainsuk-decision/consultation?experience=premium&amp;entry=match">Explore this fabric with Fabric Intelligence <span aria-hidden="true">↗</span></a></div><div class="cuk-profile__intelligence-cards">
    {%- if colour_display != blank -%}<article><span>Colour palette</span><strong>{{ colour_display | escape }}</strong></article>{%- endif -%}
    {%- if pattern_display != blank -%}<article><span>Pattern</span><strong>{{ pattern_display | capitalize | escape }}</strong></article>{%- endif -%}
    {%- if character_display != blank -%}<article><span>Character</span><strong>{{ character_display | escape }}</strong></article>{%- endif -%}
    {%- if surface_display != blank -%}<article><span>Surface</span><strong>{{ surface_display | replace: '-', ' ' | escape }}</strong></article>{%- endif -%}
    {%- if finish_display != blank -%}<article><span>Finish</span><strong>{{ finish_display | escape }}</strong></article>{%- endif -%}
    {%- if weight_display != blank -%}<article><span>Visual presence</span><strong>{{ weight_display | escape }}</strong></article>{%- endif -%}
    {%- if activity != blank -%}<article><span>Activity</span><strong>{{ activity_display | escape }}</strong></article>{%- endif -%}
  </div></div></section>

  <div class="cuk-profile__wrap">
    {%- if colour != blank -%}<section class="cuk-profile__story" id="cuk-colour" aria-labelledby="cuk-colour-title"><div class="cuk-profile__story-copy"><p class="cuk-profile__eyebrow">01 / Colour story</p><h2 id="cuk-colour-title">Colour that feels like it belongs.</h2><p class="cuk-profile__story-feature">{{ colour_display | escape }}</p><p>Take a sample home to see how this palette responds to your daylight, walls and furnishings.</p></div><figure class="cuk-profile__story-image"><img src="{{ image | escape }}" alt="Colour detail of {{ metaobject.design.value | escape }} in {{ metaobject.colourway.value | escape }}" width="1200" height="1200" loading="lazy"></figure></section>{%- endif -%}
    {%- if pattern != blank or activity != blank -%}<section class="cuk-profile__story cuk-profile__story--reverse" id="cuk-pattern" aria-labelledby="cuk-pattern-title"><figure class="cuk-profile__story-image cuk-profile__story-image--detail"><img src="{{ image | escape }}" alt="Pattern detail of {{ metaobject.design.value | escape }}" width="1200" height="1200" loading="lazy"></figure><div class="cuk-profile__story-copy"><p class="cuk-profile__eyebrow">02 / Pattern and movement</p><h2 id="cuk-pattern-title">A closer look at the design.</h2>{%- if pattern != blank -%}<p class="cuk-profile__story-feature">{{ pattern | remove: 'Pattern:' | strip | escape }}</p>{%- endif -%}{%- if activity != blank -%}<div class="cuk-profile__activity"><span>Visual activity</span><strong>{{ activity_display | escape }}</strong></div>{%- endif -%}</div></section>{%- endif -%}
    {%- if surface != blank or finish != blank or weight != blank -%}<section class="cuk-profile__material" id="cuk-material" aria-labelledby="cuk-material-title"><div class="cuk-profile__section-head"><p class="cuk-profile__eyebrow">03 / The finer details</p><h2 id="cuk-material-title">The feel behind the look.</h2></div><div class="cuk-profile__material-grid">{%- if surface_display != blank -%}<article><span>Surface</span><h3>{{ surface_display | replace: '-', ' ' | escape }}</h3></article>{%- endif -%}{%- if finish_display != blank -%}<article><span>Finish</span><h3>{{ finish_display | escape }}</h3></article>{%- endif -%}{%- if weight_display != blank -%}<article><span>Visual presence</span><h3>{{ weight_display | escape }}</h3></article>{%- endif -%}</div></section>{%- endif -%}
  </div>

  {%- if metaobject.knowledge_advice.value != blank or character_display != blank -%}<section class="cuk-profile__room" id="cuk-room" aria-labelledby="cuk-room-title"><div class="cuk-profile__wrap cuk-profile__room-grid"><header><p class="cuk-profile__eyebrow">For the room you live in</p><h2 id="cuk-room-title">Picture it at home.</h2>{%- if character_display != blank -%}<p>{{ character_display | escape }}</p>{%- endif -%}</header><div class="cuk-profile__guidance">{%- assign advice_lines = metaobject.knowledge_advice.value | newline_to_br | split: '<br />' -%}{%- for line in advice_lines -%}{%- assign text = line | strip -%}{%- if text != blank -%}{%- assign label = text | split: ':' | first | strip -%}{%- assign body = text | remove_first: label | remove_first: ':' | strip -%}<article><h3>{{ label | downcase | capitalize | escape }}</h3><p>{{ body | escape }}</p></article>{%- endif -%}{%- endfor -%}</div></div></section>{%- endif -%}
  {%- if metaobject.supplier_facts.value != blank -%}<section class="cuk-profile__facts cuk-profile__wrap" id="cuk-facts" aria-labelledby="cuk-facts-title"><header><p class="cuk-profile__eyebrow">The verified details</p><h2 id="cuk-facts-title">From the supplier.</h2><p>Specifications for this exact colourway, kept separate from our interior interpretation.</p></header><dl>{%- assign facts = metaobject.supplier_facts.value | newline_to_br | split: '<br />' -%}{%- for fact in facts -%}{%- assign item = fact | strip -%}{%- if item != blank -%}{%- assign label = item | split: ':' | first | strip -%}{%- assign value = item | remove_first: label | remove_first: ':' | strip -%}<div><dt>{{ label | escape }}</dt><dd>{{ value | escape }}</dd></div>{%- endif -%}{%- endfor -%}</dl></section>{%- endif -%}
  <section class="cuk-profile__closing cuk-profile__wrap" aria-labelledby="cuk-closing-title"><div><p class="cuk-profile__eyebrow">The best way to be sure</p><h2 id="cuk-closing-title">Love this fabric?<br><em>See it in your room first.</em></h2><p>Order a physical sample for £{{ sample_price | escape }} with free UK mainland delivery.</p></div><div class="cuk-profile__closing-actions"><button type="button" class="cuk-profile__button cuk-profile__button--primary" data-sample>Order sample · £{{ sample_price | escape }}</button><a class="cuk-profile__button cuk-profile__button--secondary" href="{{ make_curtains_url | escape }}">Make curtains with this fabric</a><a class="cuk-profile__closing-fi" href="/apps/curtainsuk-decision/consultation?experience=premium&amp;entry=match">Ask Fabric Intelligence <span aria-hidden="true">↗</span></a></div></section>
  <div class="cuk-profile__sticky" data-cuk-profile-sticky hidden><div class="cuk-profile__sticky-name"><span>{{ metaobject.design.value | escape }}</span><strong>{{ metaobject.colourway.value | escape }}</strong></div><span class="cuk-profile__sticky-price">Sample £{{ sample_price | escape }}</span><div class="cuk-profile__sticky-actions"><button type="button" class="cuk-profile__button cuk-profile__button--primary" data-sample>Order sample</button><a class="cuk-profile__button cuk-profile__button--secondary" href="{{ make_curtains_url | escape }}">Make curtains</a></div><p class="cuk-profile__sticky-status" data-cuk-sample-status role="status" aria-live="polite"></p></div>
</section>
{%- assign structured_colour = colour | remove: 'Colour:' | strip -%}
{%- assign structured_pattern = pattern | remove: 'Pattern:' | strip -%}
{%- assign structured_surface = surface | remove: 'Texture / surface:' | remove: 'Texture:' | strip -%}
{%- assign structured_finish = finish | remove: 'Finish / sheen:' | remove: 'Finish:' | strip -%}
{%- assign structured_weight = weight | remove: 'Visual weight / presence:' | remove: 'Visual weight:' | remove: 'Presence:' | strip -%}
{%- assign structured_character = character | remove: 'Character:' | strip -%}
{%- assign structured_material = '' -%}
{%- assign structured_usage = '' -%}
{%- if metaobject.supplier_facts.value != blank -%}
  {%- assign structured_fact_lines = metaobject.supplier_facts.value | newline_to_br | split: '<br />' -%}
  {%- for structured_fact in structured_fact_lines -%}
    {%- assign structured_item = structured_fact | strip -%}
    {%- assign structured_label = structured_item | split: ':' | first | strip -%}
    {%- assign structured_value = structured_item | remove: structured_label | remove_first: ':' | strip -%}
    {%- if structured_label == 'Composition' -%}{%- assign structured_material = structured_value -%}{%- endif -%}
    {%- if structured_label == 'Usage' -%}{%- assign structured_usage = structured_value -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- capture structured_description -%}
{{ metaobject.display_title.value }} curtain fabric sample.{% if structured_colour != blank %} Colour palette: {{ structured_colour }}.{% endif %}{% if structured_pattern != blank %} Pattern: {{ structured_pattern }}.{% endif %}{% if structured_surface != blank %} Surface: {{ structured_surface }}.{% endif %}{% if structured_finish != blank %} Finish: {{ structured_finish }}.{% endif %}{% if structured_weight != blank %} Visual presence: {{ structured_weight }}.{% endif %}{% if structured_character != blank %} Interior character: {{ structured_character }}.{% endif %}{% if structured_usage != blank %} Supplier usage: {{ structured_usage }}.{% endif %} Order one physical fabric sample for £{{ sample_price }} from CurtainsUK before choosing made-to-measure curtains.
{%- endcapture -%}
{%- assign structured_description = structured_description | strip_newlines | replace: '  ', ' ' | strip | truncate: 1000 -%}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Product","name":{{ metaobject.display_title.value | append: ' Curtain Fabric Sample' | json }},"sku":{{ 'cuk-sample:' | append: metaobject.fabric_master_id.value | json }},"brand":{"@type":"Brand","name":{{ metaobject.brand.value | json }}},"category":"Curtain Fabric Sample","color":{{ metaobject.colourway.value | json }}{% if structured_pattern != blank %},"pattern":{{ structured_pattern | json }}{% endif %}{% if structured_material != blank %},"material":{{ structured_material | json }}{% endif %},"image":[{{ image | json }}],"description":{{ structured_description | json }},"url":{{ canonical | json }},"offers":{"@type":"Offer","url":{{ canonical | json }},"priceCurrency":"GBP","price":{{ sample_price | json }},"availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition"}}</script>
<script src="{{ 'curtainsuk-sample-checkout.js' | asset_url }}" defer="defer"></script>
<script>
  (() => {
    const root = document.querySelector('[data-cuk-canonical-fabric-detail]');
    const purchaseButton = root?.querySelector('.cuk-profile__purchase [data-sample]');
    const bar = root?.querySelector('[data-cuk-profile-sticky]');
    if (!purchaseButton || !bar || !('IntersectionObserver' in window)) return;
    new IntersectionObserver(([entry]) => {
      const purchaseVisible = entry.intersectionRatio >= 0.99;
      bar.hidden = purchaseVisible;
      root.classList.toggle('cuk-profile--sticky-visible', !purchaseVisible);
    }, { threshold: [0, 0.99] }).observe(purchaseButton);
  })();
</script>
{% stylesheet %}
.cuk-profile{--ink:#153c34;--muted:#52655b;--paper:#f8f5ed;--cream:#f0eee5;--line:#d7dfd3;--gold:#a68a58;background:var(--paper);color:var(--ink);font:15px/1.6 Arial,Helvetica,sans-serif;overflow-x:clip}.cuk-profile *{box-sizing:border-box}.cuk-profile h1,.cuk-profile h2,.cuk-profile h3{font-family:Georgia,'Times New Roman',serif;font-weight:400;letter-spacing:-.045em;line-height:1.08}.cuk-profile h1,.cuk-profile h2,.cuk-profile h3,.cuk-profile p{margin-top:0}.cuk-profile__wrap{width:min(1320px,calc(100% - 96px));margin-inline:auto}.cuk-profile__crumb{display:flex;gap:10px;padding:24px 0 20px;color:var(--muted);font-size:11px}.cuk-profile__crumb a{color:inherit;text-decoration:none}.cuk-profile__hero{display:grid;grid-template-columns:minmax(0,1.06fr) minmax(0,.94fr);gap:clamp(32px,5vw,82px);align-items:start;padding-bottom:40px}.cuk-profile__hero-image{margin:0;position:relative;background:#e3e4d9}.cuk-profile__hero-image img{width:100%;aspect-ratio:1.1;max-height:690px;object-fit:cover;display:block}.cuk-profile__hero-image figcaption{position:absolute;bottom:18px;left:18px;background:#f8f5edef;padding:8px 12px;font-size:10px;letter-spacing:.06em}.cuk-profile__hero-copy{padding:14px 0}.cuk-profile__eyebrow{font-size:10px;letter-spacing:.2em;text-transform:uppercase;font-weight:700;color:#476458}.cuk-profile__eyebrow span{font-weight:400;margin-left:10px;color:var(--muted)}.cuk-profile h1{font-size:clamp(52px,5vw,72px);margin:11px 0 3px}.cuk-profile__colourway{font:clamp(29px,3vw,43px)/1.18 Georgia,serif;color:#657a68;margin-bottom:12px}.cuk-profile__chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}.cuk-profile__chips span{border:1px solid #c8d2c4;border-radius:999px;padding:5px 11px;font-size:11px;color:#314f42;background:#fffdf9}.cuk-profile__hero-description{font:17px/1.45 Georgia,serif;color:#354d40;margin-bottom:12px;max-width:54ch}.cuk-profile__purchase{border:1px solid #bdcabc;background:#fffdf9;padding:19px 24px;box-shadow:0 18px 45px #203d2b0a}.cuk-profile__purchase-heading{display:flex;justify-content:space-between;align-items:start;gap:16px}.cuk-profile__purchase-heading div{display:grid;gap:3px}.cuk-profile__purchase-heading span:first-child{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}.cuk-profile__purchase-heading strong{font:29px Georgia,serif;font-weight:400}.cuk-profile__purchase-marker{font-size:10px;color:#829287}.cuk-profile__purchase>p{font-size:12px;color:var(--muted);margin:8px 0 0}.cuk-profile__actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.cuk-profile__button{display:inline-flex;align-items:center;justify-content:center;text-align:center;min-height:52px;padding:11px 16px;border:1px solid var(--ink);border-radius:2px;color:var(--ink);background:transparent;text-decoration:none;font:700 11px/1.3 Arial,Helvetica,sans-serif;letter-spacing:.04em;cursor:pointer;transition:background .18s,color .18s,transform .18s}.cuk-profile__button:hover{transform:translateY(-2px)}.cuk-profile__button:focus-visible,.cuk-profile a:focus-visible{outline:3px solid #b89450;outline-offset:3px}.cuk-profile__button:disabled{opacity:.55;cursor:wait;transform:none}.cuk-profile__button--primary{background:var(--ink);color:#fff}.cuk-profile__button--primary:hover{background:#2b5a49}.cuk-profile__button--secondary:hover{background:#e7eee5}.cuk-profile__purchase .cuk-profile__status{min-height:0;margin-top:8px;font-size:11px;color:#7d3a24}.cuk-profile__status:empty{display:none}.cuk-profile__purchase .cuk-profile__lead{margin-top:9px;font-size:11px}.cuk-profile__hero-fi{display:flex;justify-content:space-between;gap:16px;margin-top:23px;padding-bottom:8px;border-bottom:1px solid #8ba497;color:var(--ink);font-size:12px;text-decoration:none}.cuk-profile__trust{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:19px 0;text-align:center}.cuk-profile__trust span{font-size:11px;color:#385448;border-right:1px solid var(--line)}.cuk-profile__trust span:last-child{border:0}.cuk-profile__proposition{display:grid;grid-template-columns:1.25fr .75fr;gap:80px;align-items:end;background:#e7ebe1;padding:58px clamp(28px,5vw,70px);margin:52px 0}.cuk-profile__proposition h2{font-size:clamp(36px,3.5vw,56px);margin:12px 0 0}.cuk-profile__proposition h2 em,.cuk-profile__closing h2 em,.cuk-profile__intelligence h2 em{font-weight:400;color:#6c846e}.cuk-profile__proposition>div:last-child{max-width:370px}.cuk-profile__proposition p:not(.cuk-profile__eyebrow){font-size:14px;color:#3d5549}.cuk-profile__proposition a,.cuk-profile__style-card a{color:var(--ink);font-size:12px;font-weight:700;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:5px}.cuk-profile__styles{padding:10px 0 84px}.cuk-profile__section-head{max-width:620px}.cuk-profile__section-head h2{font-size:clamp(38px,4vw,58px);margin:10px 0 14px}.cuk-profile__section-head>p:last-child{color:var(--muted)}.cuk-profile__style-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px;margin-top:30px}.cuk-profile__style-card{position:relative;min-height:350px;background:#fdfcf8;border:1px solid var(--line);padding:24px;display:flex;flex-direction:column}.cuk-profile__style-art{aspect-ratio:600/410;margin:-24px -24px 24px;overflow:hidden;background:#e8e3d9;border-bottom:1px solid var(--line)}.cuk-heading-preview{display:block;width:100%;height:auto}.cuk-heading-preview__cloth{filter:drop-shadow(0 7px 5px #29221630)}.cuk-profile__style-number{font-size:10px;color:var(--gold);letter-spacing:.15em}.cuk-profile__style-card h3{font-size:31px;margin:8px 0}.cuk-profile__style-card p{font-size:13px;color:var(--muted);max-width:32ch}.cuk-profile__style-card a{margin-top:auto;align-self:flex-start}.cuk-profile__intelligence{background:#173c33;color:#f7f6ec;padding:82px 0}.cuk-profile__intelligence-grid{display:grid;grid-template-columns:.78fr 1.22fr;gap:8vw;align-items:center}.cuk-profile__int