{{ 'curtainsuk-storefront.css' | asset_url | stylesheet_tag }}

{% if page.handle == 'shop-by-window' or page.handle == 'solve-my-window' %}
{% assign handles = 'standard-window|bay-window|apex-window|triangular-window|gable-end-window|extra-wide-window|tall-floor-to-ceiling-window|french-doors|patio-sliding-doors|bifold-doors|dormer-window|curved-bow-window|corner-window|awkward-unusual-window' | split: '|' %}
{% assign names = 'Standard Window|Bay Window|Apex Window|Triangular Window|Gable End Window|Extra-Wide Window|Tall / Floor-to-Ceiling|French Doors|Patio / Sliding Doors|Bifold Doors|Dormer Window|Curved / Bow Window|Corner Window|Awkward / Unusual' | split: '|' %}
{% assign descriptions = 'A clear route for everyday rectangular windows.|Bring several bay sections together as one made-to-measure curtain scheme.|A specialist route for dramatic peaked glazing.|Measurements and photographs for single-slope geometry.|Technical review for complete gable-end glazing.|Balanced curtains for spans beyond ordinary track widths.|Scale-aware decisions for tall architectural glazing.|Practical access with made-to-measure coverage.|Curtains planned around wide glazed door openings.|Curtains that work with folding door stacks.|Compact solutions shaped around dormer recesses.|Tracks and curtains considered together for an arc.|Plan the return and stack around a room corner.|Start with photographs and let the technical team guide the route.' | split: '|' %}

<section class="cuk-shell cuk-section cuk-section--tint">
  <div class="cuk-wrap">
    <div class="cuk-section__head">
      <div>
        <p class="cuk-eyebrow">Start with the architecture</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <p>{{ section.settings.intro }}</p>
    </div>
    <div class="cuk-grid">
      {% for handle in handles %}
        <a class="cuk-card" href="/pages/curtain-visualiser?window={{ handle | url_encode }}">
          <span class="cuk-card__shape" aria-hidden="true">⌑</span>
          <span>
            <h3>{{ names[forloop.index0] }}</h3>
            <p>{{ descriptions[forloop.index0] }}</p>
            <small>Start my curtains →</small>
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Shop by Window grid",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What are you dressing?" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Choose the closest window shape. Measurements, fabric and the correct pricing or review route follow from there." }
  ],
  "presets": [{ "name": "Shop by Window grid" }]
}
{% endschema %}
