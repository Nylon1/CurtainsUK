{% doc %}
  Renders the adviser waiting room and separately gated consultation panels.
  @param {string} section_id - The owning section identifier.
  @param {boolean} [jane_chat_private_preview] - Enables Jane's separately gated consultation composer.
  @param {boolean} [jane_chat_live] - Public copy for Jane.
  @param {boolean} [specialist_chat_private_preview] - Four-role private chat preview.
  @param {boolean} [specialist_chat_live] - Four-role public chat copy.
{% enddoc %}
{% assign jane_chat_enabled = jane_chat_private_preview %}
{% if jane_chat_live %}{% assign jane_chat_enabled = true %}{% endif %}
{{ 'curtainsuk-advisory-room.css' | asset_url | stylesheet_tag }}
<dialog class="cukad-room" data-advisory-dialog aria-labelledby="advisory-dialog-title-{{ section_id }}" aria-describedby="advisory-preview-notice-{{ section_id }}">
  <div class="cukad-room__header">
    <p id="advisory-preview-notice-{{ section_id }}">{% if specialist_chat_live %}Five AI advisers available{% elsif jane_chat_live %}{{ 'advisory_team.live.room_notice' | t }}{% else %}{{ 'advisory_team.room.preview' | t }}{% endif %}</p>
    <button type="button" class="cukad-room__close" data-advisory-close aria-label="{% if jane_chat_live %}{{ 'advisory_team.live.close' | t | escape }}{% else %}{{ 'advisory_team.room.close' | t | escape }}{% endif %}"><span aria-hidden="true">×</span></button>
  </div>
  <div class="cukad-room__identity">
    <div class="cukad-room__mark" data-advisory-mark aria-hidden="true">J</div>
    <div><h2 id="advisory-dialog-title-{{ section_id }}" data-advisory-name></h2><p data-advisory-title></p></div>
  </div>
  <div data-advisory-waiting class="cukad-room__waiting">
    <p class="cukad-room__eyebrow">{{ 'advisory_team.room.waiting' | t }}</p>
    <div class="cukad-room__clock"><span data-advisory-countdown aria-hidden="true">30</span><span>{{ 'advisory_team.room.seconds' | t }}</span></div>
    <progress data-advisory-progress value="0" max="30" aria-label="{{ 'advisory_team.room.progress' | t | escape }}"></progress>
    <p class="cukad-room__muted">{% if specialist_chat_live %}A 30-second welcome, not a queue. Your chosen adviser can chat after you enter.{% elsif jane_chat_live %}{{ 'advisory_team.live.waiting_copy' | t }}{% else %}{{ 'advisory_team.room.waiting_copy' | t }}{% endif %}</p>
    <div class="cukad-room__preparation"><h3>{{ 'advisory_team.room.preparation' | t }}</h3><p data-advisory-preparation></p></div>
    <button type="button" class="cukad-room__button cukad-room__button--outline" data-advisory-skip>{% if jane_chat_live %}{{ 'advisory_team.live.skip' | t }}{% else %}{{ 'advisory_team.room.skip' | t }}{% endif %} <span aria-hidden="true">→</span></button>
  </div>
  <div data-advisory-room hidden class="cukad-room__conversation">
    <h3 data-advisory-room-title tabindex="-1">{{ 'advisory_team.room.room_title' | t }}</h3>
    <div class="cukad-room__example"><p class="cukad-room__eyebrow">{{ 'advisory_team.room.example_label' | t }}</p><p data-advisory-example></p></div>
    <div class="cukad-room__format"><h4>{{ 'advisory_team.room.format' | t }}</h4><p>{{ 'advisory_team.room.format_copy' | t }}</p></div>
    <div class="cukad-room__composer" aria-disabled="true"><p>{{ 'advisory_team.room.composer' | t }}</p><button disabled type="button" aria-label="{{ 'advisory_team.room.send' | t | escape }}"><span aria-hidden="true">↑</span></button></div>
    {% if jane_chat_enabled %}
      <section class="cukad-room__jane" data-jane-chat hidden aria-label="AI consultation with Jane">
        <div class="cukad-room__jane-intro">
          <img src="{{ 'curtainsuk-adviser-jane.webp' | asset_url }}" width="80" height="96" alt="Illustrated portrait of Jane, AI interior design adviser" loading="lazy">
          <div><p class="cukad-room__eyebrow">{% if jane_chat_live %}Jane · AI interior design adviser{% else %}Jane · AI interior design adviser · private test{% endif %}</p><p class="cukad-room__jane-intro-title">Let's find what feels right for your room.</p></div>
          <span class="cukad-room__jane-spark" aria-hidden="true">✳</span>
        </div>
        <a data-jane-signin href="{{ routes.storefront_login_url }}" hidden>Sign in to speak with Jane</a>
        <p data-jane-signin-help hidden>After signing in, you will return to Jane. You can also find all advisers from your customer account menu.</p>
        <label class="cukad-room__jane-consent"><input type="checkbox" data-jane-consent> I agree to send my messages to OpenAI for Jane's AI advice and to save this encrypted consultation for up to 90 days so I can return to it.</label>
        <div class="cukad-room__jane-actions"><button type="button" data-jane-start>Start consultation</button></div>
        <div class="cukad-room__jane-fabric" data-jane-fabric hidden><p data-jane-fabric-description></p><p data-jane-fabric-hint></p><label><input type="checkbox" data-jane-fabric-consent> Share this exact fabric with Jane</label><button type="button" data-jane-fabric-share disabled>Discuss selected fabric</button></div>
        <div class="cukad-room__jane-log" data-jane-log role="log" aria-label="Conversation with Jane" aria-live="polite" aria-relevant="additions"></div>
        <div class="cukad-room__jane-thinking" data-jane-thinking hidden aria-hidden="true"><span></span><span></span><span></span><p>Jane is considering your room</p></div>
        <div class="cukad-room__jane-starters" data-jane-starters hidden aria-label="Design conversation starters"><p>Where shall we begin?</p><div>
          <button type="button" data-jane-prompt="My room needs a calmer colour palette. Can you help me find a direction?">Find my palette <span aria-hidden="true">↗</span></button>
          <button type="button" data-jane-prompt="I am choosing between curtain headings. How would they change the feel of my room?">Compare headings <span aria-hidden="true">↗</span></button>
          <button type="button" data-jane-prompt="I would like to see how curtains could work with my room and furnishings. Where should I start?">Explore my room <span aria-hidden="true">↗</span></button>
        </div></div>
        <form data-jane-form hidden><label for="jane-message-{{ section_id }}">Your message to Jane</label><textarea id="jane-message-{{ section_id }}" data-jane-input rows="3" maxlength="2000" required></textarea><button type="submit" data-jane-send>Send to Jane</button></form>
        <nav class="cukad-room__jane-tools" data-jane-tools hidden aria-label="CurtainsUK design tools"><a href="/pages/fabric-library?view=browse-fabrics" target="_blank" rel="noopener noreferrer">Browse Fabrics <span class="visually-hidden">(opens in a new tab)</span></a><a href="/apps/curtainsuk-decision/consultation?experience=premium&amp;entry=guided" target="_blank" rel="noopener noreferrer">Fabric Intelligence <span class="visually-hidden">(opens in a new tab)</span></a><a href="/pages/room-visualiser" target="_blank" rel="noopener noreferrer">Room Visualiser <span class="visually-hidden">(opens in a new tab)</span></a><a href="/pages/fabric-library?view=curtain-style" target="_blank" rel="noopener noreferrer">Curtain Style <span class="visually-hidden">(opens in a new tab)</span></a></nav>
        <div class="cukad-room__jane-manage" data-jane-manage hidden><button type="button" data-jane-delete hidden>Delete consultation</button></div>
        <p data-jane-status role="status" aria-live="polite"></p>
        <p data-jane-error role="alert" hidden></p>
        <footer class="cukad-room__jane-fine-print">
          <p>{% if jane_chat_live %}Jane is an AI adviser and may make mistakes. Check product availability and prices on the live product page.{% else %}Private review: please use invented details only. Automatic expiry cleanup is still under review.{% endif %}</p>
          <p>With your consent, messages are sent to OpenAI and saved encrypted for up to 90 days. You can delete your consultation here. Please avoid sharing sensitive details. <a href="/policies/privacy-policy" target="_blank" rel="noopener noreferrer">Privacy policy <span class="visually-hidden">(opens in a new tab)</span></a>.</p>
        </footer>
      </section>
    {% endif %}
    {% if specialist_chat_private_preview or specialist_chat_live %}
      {% render 'curtainsuk-specialist-chat', section_id: section_id, specialist_chat_live: specialist_chat_live %}
    {% endif %}
    <p class="cukad-room__privacy">{% if specialist_chat_live %}Your adviser saves a consultation only with your consent. You can delete it here.{% elsif jane_chat_live %}{{ 'advisory_team.live.room_privacy' | t }}{% else %}{{ 'advisory_team.room.privacy' | t }}{% endif %}</p>
    <button type="button" class="cukad-room__button" data-advisory-close>{{ 'advisory_team.room.return' | t }} <span aria-hidden="true">↗</span></button>
  </div>
  <p class="cukad-room__status" role="status" aria-live="polite" data-advisory-status></p>
</dialog>
