{% doc %}
  Direct customer destinations, with optional consultation and guide details.
  @param {string} location - Desktop, mobile or fallback scope
  @param {string} section_id - Parent section ID
{% enddoc %}
<ul class="cuknav__list">
  <li class="cuknav__item"><a href="/pages/fabric-library?view=browse-fabrics">Browse Fabrics</a></li>
  <li class="cuknav__item"><a href="/pages/fabric/sdg-f1325-02-abeja-ivory#cuk-making-studio">{{ 'making_studio.navigation' | t }}</a></li>
  <li class="cuknav__item"><a href="/pages/room-visualiser">Room Visualiser</a></li>
  <li class="cuknav__item"><a href="/pages/hotel-design-studio">Hotel Design Studio</a></li>
  <li class="cuknav__item"><a href="/pages/cushion-studio">Cushion Studio</a></li>
  {% if settings.curtainsuk_smart_track_enabled %}
    <li class="cuknav__item"><a href="/pages/smart-track-studio"{% if request.path == '/pages/smart-track-studio' %} aria-current="page"{% endif %}>Motorised Curtain Tracks</a></li>
  {% endif %}
  <li class="cuknav__item"><a href="/pages/solve-my-window">Shop by Window</a></li>
  <li class="cuknav__item"><a href="/pages/fabric-library?view=curtain-style">{{ 'curtain_style.navigation' | t }}</a></li>
  <li class="cuknav__item cuknav__item--split">
    <a href="/apps/curtainsuk-decision/consultation?experience=premium&amp;entry=match">Fabric Intelligence™</a>
    <details class="cuknav__disclosure">
      <summary aria-label="More Fabric Intelligence options" aria-expanded="false" aria-controls="CukIntelligence-{{ location }}-{{ section_id }}"><span class="cuknav__caret" aria-hidden="true">{{ 'icon-caret.svg' | inline_asset_content }}</span></summary>
      <div class="cuknav__dropdown" id="CukIntelligence-{{ location }}-{{ section_id }}">
        <p class="cuknav__overline">A considered fabric direction</p>
        <ul>
          <li><a href="/apps/curtainsuk-decision/consultation?experience=premium&amp;entry=match#your-reference">Upload my Photo <span aria-hidden="true">→</span></a></li>
          <li><a href="/apps/curtainsuk-decision/consultation?experience=premium&amp;entry=guided">Help me choose</a></li>
          <li><a href="{{ routes.root_url }}#what-we-consider">How Fabric Intelligence works</a></li>
          <li><a href="{{ routes.root_url }}#colour-intelligence">Colour Intelligence</a></li>
        </ul>
      </div>
    </details>
  </li>
  <li class="cuknav__item">
    <details class="cuknav__disclosure">
      <summary aria-expanded="false" aria-controls="CukGuides-{{ location }}-{{ section_id }}">Guide <span class="cuknav__caret" aria-hidden="true">{{ 'icon-caret.svg' | inline_asset_content }}</span></summary>
      <div class="cuknav__dropdown" id="CukGuides-{{ location }}-{{ section_id }}"><ul>
        <li><a href="/pages/how-to-use">How to use CurtainsUK</a></li>
        <li><a href="/apps/curtainsuk-decision/hotel-studio/how-to-use.html">How to use the Hotel Studio</a></li>
        <li><a href="/pages/how-to-measure">How to Measure</a></li>
        <li><a href="/pages/how-to-fit">How to Fit</a></li>
      </ul></div>
    </details>
  </li>
  {% if settings.curtainsuk_rooms_enabled %}
    <li class="cuknav__item"><a href="/pages/build-my-rooms" data-cuk-house-nav aria-label="Design My Home">Design My Home</a></li>
  {% endif %}
</ul>
{% if location == 'mobile' or location == 'fallback' %}
  <ul class="cuknav__secondary" aria-label="More from CurtainsUK">
    {% render 'curtainsuk-advisory-navigation' %}
    <li class="cuknav__item"><a href="{{ routes.root_url }}#curtainsuk-help">Contact</a></li>
  </ul>
{% endif %}
