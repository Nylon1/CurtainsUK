{% doc %}
  Renders a curtain heading using the selected Fabric Profile photograph.
  @param {string} image_url - Selected fabric image URL.
  @param {string} heading - wave, pinch, or pencil.
  @param {string} preview_id - Unique identifier for this instance.
{% enddoc %}
{%- assign uid = preview_id | append: '-' | append: heading | handleize -%}
<svg class="cuk-heading-preview" viewBox="0 0 600 410" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="{{ uid }}-wall" x2="0" y2="1"><stop stop-color="#eeeae2"/><stop offset="1" stop-color="#d6d0c5"/></linearGradient>
    <linearGradient id="{{ uid }}-shade"><stop stop-color="#181711" stop-opacity=".38"/><stop offset=".12" stop-color="#fff" stop-opacity=".12"/><stop offset=".3" stop-color="#fff" stop-opacity=".3"/><stop offset=".48" stop-color="#fff" stop-opacity=".06"/><stop offset=".72" stop-color="#211e17" stop-opacity=".3"/><stop offset=".88" stop-color="#17150f" stop-opacity=".57"/><stop offset="1" stop-color="#17150f" stop-opacity=".38"/></linearGradient>
    <linearGradient id="{{ uid }}-pleat"><stop stop-color="#17150f" stop-opacity=".42"/><stop offset=".28" stop-color="#fff" stop-opacity=".32"/><stop offset=".48" stop-color="#fff" stop-opacity=".07"/><stop offset="1" stop-color="#17150f" stop-opacity=".5"/></linearGradient>
    <linearGradient id="{{ uid }}-vertical" x2="0" y2="1"><stop stop-color="#20190e" stop-opacity=".2"/><stop offset=".22" stop-color="#fff" stop-opacity=".03"/><stop offset=".8" stop-color="#fff" stop-opacity="0"/><stop offset="1" stop-color="#211b14" stop-opacity=".15"/></linearGradient>
    <linearGradient id="{{ uid }}-rail" x2="0" y2="1"><stop stop-color="#c3bcae"/><stop offset=".35" stop-color="#f6f2e9"/><stop offset=".7" stop-color="#a29a8a"/><stop offset="1" stop-color="#807868"/></linearGradient>
    <pattern id="{{ uid }}-wide" width="76" height="410" patternUnits="userSpaceOnUse" x="34"><rect width="76" height="410" fill="url(#{{ uid }}-shade)"/></pattern>
    <pattern id="{{ uid }}-soft" width="44" height="410" patternUnits="userSpaceOnUse" x="36"><rect width="44" height="410" fill="url(#{{ uid }}-shade)" opacity=".72"/></pattern>
    <pattern id="{{ uid }}-gather" width="17.6" height="410" patternUnits="userSpaceOnUse" x="36"><rect width="17.6" height="410" fill="url(#{{ uid }}-pleat)"/></pattern>
    <image id="{{ uid }}-fabric" href="{{ image_url | escape }}" x="20" y="48" width="560" height="350" preserveAspectRatio="xMidYMid slice"/>
    <clipPath id="{{ uid }}-cloth">
      {%- case heading -%}
        {%- when 'wave' -%}
          <path d="M34 65 Q53 45 72 58 T110 65 Q129 45 148 58 T186 65 Q205 45 224 58 T262 65 Q281 45 300 58 T338 65 Q357 45 376 58 T414 65 Q433 45 452 58 T490 65 Q509 45 528 58 T566 65 L570 380 Q551 391 532 383 T494 380 Q475 391 456 383 T418 380 Q399 391 380 383 T342 380 Q323 391 304 383 T266 380 Q247 391 228 383 T190 380 Q171 391 152 383 T114 380 Q95 391 76 383 T30 380 Z"/>
        {%- when 'pinch' -%}
          <path d="M44 62 Q80 50 116 62 Q135 69 154 62 Q190 50 226 62 Q245 69 264 62 Q300 50 336 62 Q355 69 374 62 Q410 50 446 62 Q465 69 484 62 Q520 50 556 62 L582 382 Q550 390 520 385 T465 382 Q435 390 410 385 T355 382 Q325 390 300 385 T245 382 Q215 390 190 385 T135 382 Q105 390 80 385 T18 382 Z"/>
        {%- else -%}
          <path d="M36 61 Q44 52 53.6 60 Q62 53 71.2 60 Q80 52 88.8 60 Q98 54 106.4 60 Q115 52 124 60 Q133 53 141.6 60 Q150 52 159.2 60 Q168 54 176.8 60 Q186 52 194.4 60 Q203 53 212 60 Q221 52 229.6 60 Q239 54 247.2 60 Q256 52 264.8 60 Q274 53 282.4 60 Q292 52 300 60 Q309 54 317.6 60 Q327 52 335.2 60 Q344 53 352.8 60 Q362 52 370.4 60 Q380 54 388 60 Q397 52 405.6 60 Q415 53 423.2 60 Q432 52 440.8 60 Q450 54 458.4 60 Q468 52 476 60 Q485 53 493.6 60 Q503 52 511.2 60 Q520 54 528.8 60 Q538 52 546.4 60 Q556 53 564 61 L577 382 Q550 387 533 382 T489 382 T445 382 T401 382 T357 382 T313 382 T269 382 T225 382 T181 382 T137 382 T93 382 T23 382 Z"/>
      {%- endcase -%}
    </clipPath>
  </defs>
  <rect width="600" height="410" fill="url(#{{ uid }}-wall)"/>
  <path d="M0 20H600M0 24H600" stroke="#fff" stroke-opacity=".45"/>
  <rect x="22" y="31" width="556" height="7" rx="3.5" fill="url(#{{ uid }}-rail)"/>
  {%- if heading == 'wave' -%}
    {%- for fold in (0..6) -%}{%- assign x = fold | times: 76 | plus: 55 -%}
      <path d="M{{ x }} 37V56" stroke="#8c8476" stroke-width="3"/>
    {%- endfor -%}
  {%- else -%}
    {%- for fold in (0..4) -%}{%- assign x = fold | times: 110 | plus: 80 -%}
      <path d="M{{ x }} 38V61" stroke="#8c8476" stroke-width="2"/>
    {%- endfor -%}
  {%- endif -%}
  <g class="cuk-heading-preview__cloth">
    <g clip-path="url(#{{ uid }}-cloth)">
      <rect x="18" y="48" width="564" height="350" fill="#c8c1b1"/>
      {%- if image_url != blank -%}<use href="#{{ uid }}-fabric"/>{%- endif -%}
      {%- case heading -%}
        {%- when 'wave' -%}
          <rect x="20" y="48" width="560" height="350" fill="url(#{{ uid }}-wide)"/>
          <path d="M34 65 Q53 45 72 58 T110 65 Q129 45 148 58 T186 65 Q205 45 224 58 T262 65 Q281 45 300 58 T338 65 Q357 45 376 58 T414 65 Q433 45 452 58 T490 65 Q509 45 528 58 T566 65" fill="none" stroke="#fff" stroke-opacity=".42" stroke-width="2.5"/>
          <path d="M34 73 Q53 53 72 66 T110 73 Q129 53 148 66 T186 73 Q205 53 224 66 T262 73 Q281 53 300 66 T338 73 Q357 53 376 66 T414 73 Q433 53 452 66 T490 73 Q509 53 528 66 T566 73" fill="none" stroke="#211b13" stroke-opacity=".14"/>
        {%- when 'pinch' -%}
          {%- for fold in (0..4) -%}{%- assign x = fold | times: 110 | plus: 80 -%}
            <g transform="translate({{ x }} 0)">
              <path d="M-5 109 C-15 172-49 276-62 390 H51 C31 265 13 171 4 109Z" fill="url(#{{ uid }}-shade)"/>
              <path d="M-7 109 C-13 166-33 272-43 388" fill="none" stroke="#fff" stroke-opacity=".21" stroke-width="2"/>
              <path d="M5 110 C11 169 33 278 40 388" fill="none" stroke="#17140e" stroke-opacity=".22" stroke-width="2.5"/>
              <path d="M-32 58 Q-27 86-6 112 L0 114 Q-10 87-11 54 Q-22 51-32 58Z" fill="url(#{{ uid }}-pleat)"/>
              <path d="M-10 54 Q-12 79-3 113 H4 Q12 80 10 54 Q0 49-10 54Z" fill="url(#{{ uid }}-pleat)"/>
              <path d="M11 54 Q10 86 0 114 L6 112 Q27 86 32 58 Q22 51 11 54Z" fill="url(#{{ uid }}-pleat)"/>
              <path d="M-29 59 Q-23 86-5 110 M-8 55 Q-8 86 0 111 M14 57 Q14 86 4 111" fill="none" stroke="#fff" stroke-opacity=".28" stroke-width="1.7"/>
              <path d="M-7 111 Q0 115 7 111 M-6 114 Q0 118 6 114" fill="none" stroke="#201a12" stroke-opacity=".52" stroke-width="1.5"/>
              <path d="M-4 110 Q0 112 4 110" fill="none" stroke="#fff" stroke-opacity=".4"/>
            </g>
          {%- endfor -%}
        {%- else -%}
          <rect x="18" y="110" width="564" height="288" fill="url(#{{ uid }}-soft)"/>
          <path d="M36 59H564V119 Q540 125 512 119 T459 119 T406 119 T353 119 T300 119 T247 119 T194 119 T141 119 T88 119 T36 119Z" fill="url(#{{ uid }}-gather)"/>
          {%- for fold in (0..29) -%}{%- assign x = fold | times: 17.6 | plus: 36 -%}
            <path d="M{{ x }} 62 q-2 18 1 32 t-1 25" fill="none" stroke="#201a12" stroke-opacity=".35" stroke-width="1.3"/>
            <path d="M{{ x | plus: 5 }} 61 q-2 20 1 33 t0 23" fill="none" stroke="#fff" stroke-opacity=".27" stroke-width="1.2"/>
          {%- endfor -%}
          <path d="M36 77H564M36 94H564M36 111H564" fill="none" stroke="#271f17" stroke-opacity=".19" stroke-width="1" stroke-dasharray="2 3"/>
          <path d="M36 120 Q61 125 88 119 T141 119 T194 119 T247 119 T300 119 T353 119 T406 119 T459 119 T512 119 T564 119" fill="none" stroke="#20190f" stroke-opacity=".16" stroke-width="2"/>
      {%- endcase -%}
      <rect x="18" y="48" width="564" height="350" fill="url(#{{ uid }}-vertical)"/>
      <path d="M20 377 Q300 390 580 377" fill="none" stroke="#fff" stroke-opacity=".17" stroke-width="1.2"/>
    </g>
  </g>
</svg>
