{% doc %}
  Renders the four home-page made-to-measure benefits directly beneath the main navigation.

  @example
    {% render 'curtainsuk-home-trust-strip' %}
{% enddoc %}

<section class="cuk-home-trust" aria-label="CurtainsUK made-to-measure benefits">
  <div class="cuk-home-trust__viewport">
    <ul class="cuk-home-trust__list" role="list">
      <li class="cuk-home-trust__item">
        <span class="cuk-home-trust__title">COMPLIMENTARY MATCHING TIEBACKS</span>
        <span class="cuk-home-trust__copy">Included with every made-to-measure curtain order</span>
      </li>
      <li class="cuk-home-trust__item">
        <span class="cuk-home-trust__title">MADE TO MEASURE IN THE UK</span>
        <span class="cuk-home-trust__copy">Made for your windows</span>
      </li>
      <li class="cuk-home-trust__item">
        <span class="cuk-home-trust__title">4–5 WEEK LEAD TIME</span>
        <span class="cuk-home-trust__copy">Made to order</span>
      </li>
      <li class="cuk-home-trust__item">
        <span class="cuk-home-trust__title">REAL HOMES. ROOM BY ROOM.</span>
        <span class="cuk-home-trust__copy">Designed around the way you live</span>
      </li>
    </ul>
  </div>
</section>