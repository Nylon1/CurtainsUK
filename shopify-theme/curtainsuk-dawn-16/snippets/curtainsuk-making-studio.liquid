{% doc %}
  An illustrative, single-width making sequence for the exact catalogue fabric.
  Ordering and measurements remain with the existing curtain configurator.
  @param {string} fabric_id - Canonical Fabric Master identity.
  @param {string} fabric_name - Customer-facing fabric and colourway.
  @param {string} make_curtains_url - Availability-guarded configurator destination.
{% enddoc %}
<section class="cuk-making" id="cuk-making-studio" data-cuk-making-studio data-fabric-id="{{ fabric_id | escape }}" aria-labelledby="cuk-making-title">
  <div class="cuk-making__intro">
    <div><p class="cuk-profile__eyebrow">Making Studio · {{ fabric_name | escape }}</p><h2 id="cuk-making-title">Watch your curtains take shape.</h2><p>Press each step to see how a lined pencil-pleat pair is made from your chosen fabric.</p></div>
    <p class="cuk-making__example">Illustrative one-width make-up. Enter your actual measurements when you order.</p>
  </div>
  <div class="cuk-making__layout">
    <div class="cuk-making__table" data-making-stage="0" role="img" aria-label="Illustrated curtain-making worktable">
      <div class="cuk-making__roll" aria-hidden="true"><span></span></div>
      <div class="cuk-making__cloth" aria-hidden="true"><img alt="" width="640" height="390" loading="lazy"></div>
      <div class="cuk-making__pieces" aria-hidden="true"><div class="cuk-making__piece"><img alt="" width="320" height="390" loading="lazy"><span>Left</span></div><div class="cuk-making__piece"><img alt="" width="320" height="390" loading="lazy"><span>Right</span></div></div>
      <div class="cuk-making__ruler" aria-hidden="true"><span>Fabric width</span><i></i></div>
      <div class="cuk-making__pattern" aria-hidden="true"><i></i><i></i></div>
      <div class="cuk-making__cut" aria-hidden="true"><span>✂</span></div>
      <div class="cuk-making__lining" aria-hidden="true"><div class="cuk-making__lining-roll"></div><div class="cuk-making__lining-cloth">Standard lining</div><div class="cuk-making__lining-panels"><i></i><i></i></div><div class="cuk-making__lining-cut"><span>✂</span></div></div>
      <div class="cuk-making__hems" aria-hidden="true"></div>
      <div class="cuk-making__heading" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><div class="cuk-making__heading-cords"><i></i><i></i></div></div>
      <div class="cuk-making__threads" aria-hidden="true"><i></i><i></i><span>✂</span></div>
      <div class="cuk-making__finish" aria-hidden="true">✓</div>
      <div class="cuk-making__table-label">Your chosen fabric · illustrative making sequence</div>
    </div>
    <div class="cuk-making__panel">
      <p class="cuk-making__counter" data-making-counter>Ready to begin</p>
      <h3 data-making-title>From fabric to finished curtain.</h3>
      <p data-making-description aria-live="polite">Follow a fabric width through the workroom, then see the curtain hanging in the preview below.</p>
      <ol class="cuk-making__progress" data-making-progress aria-label="Making progress"></ol>
      <p class="cuk-making__status" data-making-status role="status">Checking the approved fabric render…</p>
      <button type="button" class="cuk-making__retry" data-making-retry hidden>Try loading the preview again</button>
      <div class="cuk-making__controls">
        <button type="button" class="cuk-making__next" data-making-next disabled>Start making <span aria-hidden="true">→</span></button>
        <button type="button" data-making-back disabled>Back</button>
        <button type="button" data-making-replay disabled>Replay step</button>
        <button type="button" data-making-detail aria-pressed="false" disabled>View detail</button>
        <button type="button" data-making-skip disabled>Skip to finished curtains</button>
      </div>
      <a class="cuk-making__order" data-cuk-make-curtains data-href="{{ make_curtains_url | escape }}" aria-disabled="true" tabindex="-1">Make curtains to my measurements <span aria-hidden="true">↗</span></a>
      <p class="cuk-making__note">Your real size, construction, availability and price are checked in the curtain configurator. This demonstration is not a cutting sheet or quotation.</p>
      <p class="cuk-making__note">For wider windows, fabric widths are joined with a sewn seam. This one-width demonstration does not show that step.</p>
    </div>
  </div>
</section>
