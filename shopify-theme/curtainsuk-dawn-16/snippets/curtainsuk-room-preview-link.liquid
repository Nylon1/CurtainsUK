{% doc %}
  Shows a visualiser link only when the production catalogue confirms this exact fabric is preview-ready.
  @param {string} fabric_id - Fabric Master ID from the existing catalogue.
{% enddoc %}
{%- if fabric_id != blank -%}
  <span data-cuk-room-preview data-fabric-id="{{ fabric_id | escape }}">
    <a class="cuk-profile__button cuk-profile__button--secondary" data-cuk-room-preview-link href="/pages/room-visualiser?fabric={{ fabric_id | url_encode }}" hidden style="display:none">See in room</a>
    <span class="cuk-hint" data-cuk-room-preview-status role="status">Checking room preview…</span>
  </span>
{%- endif -%}
