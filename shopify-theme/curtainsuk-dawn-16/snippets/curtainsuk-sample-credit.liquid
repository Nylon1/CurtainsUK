{% doc %}
  Explains paid sample credit without changing sample prices or checkout controls.
{% enddoc %}
<details class="cuk-sample-credit" style="margin:1rem 0;padding:1rem 1.2rem;border:1px solid #d7dfd5;border-radius:12px;background:#f4f5ed;color:#193e32;font-size:14px;line-height:1.5">
  <summary style="cursor:pointer;font-weight:600">{{ 'curtainsuk_sample_credit.title' | t }}</summary>
  <p>{{ 'curtainsuk_sample_credit.offer' | t }}</p>
  <p>{{ 'curtainsuk_sample_credit.how' | t }}</p>
  <small>{{ 'curtainsuk_sample_credit.terms' | t }}</small>
</details>
