{% doc %}
  Four-role signed consultation. Requires the owning section setting and
  the server's exact-release gate.
  @param {string} section_id - Owning section identifier for unique controls.
  @param {boolean} [specialist_chat_live] - Public copy after release approval.
{% enddoc %}
<section class="cukad-specialist" data-specialist-chat data-specialist-public="{% if specialist_chat_live %}true{% else %}false{% endif %}" hidden aria-label="{% if specialist_chat_live %}Specialist AI consultation{% else %}Private specialist AI consultation preview{% endif %}">
  <p class="cukad-room__eyebrow">{% if specialist_chat_live %}AI adviser{% else %}Private test · AI adviser{% endif %}</p>
  <h3 data-specialist-heading tabindex="-1"></h3>
  <p data-specialist-opening class="cukad-specialist__opening"></p>
  <p class="cukad-specialist__hints"><strong>For example:</strong> <span data-specialist-examples></span></p>
  <div class="cukad-specialist__log" data-specialist-log role="log" aria-live="polite" aria-relevant="additions" aria-label="Specialist consultation"></div>
  <div class="cukad-specialist__thinking" data-specialist-thinking hidden aria-hidden="true"><span></span><span></span><span></span><p>Considering your question</p></div>
  <form data-specialist-form hidden><label for="specialist-message-{{ section_id }}">Your question</label><textarea id="specialist-message-{{ section_id }}" data-specialist-input rows="3" maxlength="2000" required></textarea><button type="submit" data-specialist-send>Send</button></form>
  <div class="cukad-specialist__entry" data-specialist-entry>
    <a data-specialist-signin hidden href="{{ routes.storefront_login_url }}">Sign in to continue</a>
    <label class="cukad-specialist__consent"><input type="checkbox" data-specialist-consent> I agree to send my messages to OpenAI for AI advice and save this encrypted consultation for up to 90 days.</label>
    <div class="cukad-specialist__actions"><button type="button" data-specialist-start>Start consultation</button></div>
  </div>
  <details class="cukad-specialist__tools" data-specialist-tools hidden>
    <summary>Save, recover or delete a conversation</summary>
    <div class="cukad-specialist__actions"><button type="button" data-specialist-save hidden>Create recovery code</button><button type="button" data-specialist-delete hidden>Delete consultation</button></div>
    <div class="cukad-specialist__confirm" data-specialist-delete-confirm hidden role="group" aria-label="Confirm deletion"><p>Delete this consultation permanently? It cannot be recovered.</p><button type="button" data-specialist-delete-yes>Delete permanently</button><button type="button" data-specialist-delete-cancel>Keep consultation</button></div>
    <div class="cukad-specialist__recovery" data-specialist-recovery hidden><label for="specialist-recovery-{{ section_id }}">Recovery code</label><input id="specialist-recovery-{{ section_id }}" data-specialist-recovery-input autocomplete="off" spellcheck="false"><button type="button" data-specialist-recover>Recover saved conversation</button><p data-specialist-recovery-output hidden></p></div>
  </details>
  <p data-specialist-status role="status" aria-live="polite"></p><p data-specialist-error role="alert" hidden></p>
  <footer class="cukad-specialist__fine-print">
    <p class="cukad-specialist__notice">{% if specialist_chat_live %}AI advice may be mistaken. Check exact specifications against a linked source or with a professional.{% else %}Private preview. Use invented details only. Check exact specifications against a linked source or with a professional.{% endif %}</p>
    <p class="cukad-specialist__privacy">Messages are sent to OpenAI with your consent and saved encrypted for up to 90 days. You can delete your consultation here. <a href="/policies/privacy-policy" target="_blank" rel="noopener noreferrer">Privacy policy <span class="visually-hidden">(opens in a new tab)</span></a>.</p>
  </footer>
</section>
