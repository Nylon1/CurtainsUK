{% stylesheet %}
.cuktrust{background:#f8f6ef;color:#173d35;font-family:var(--font-body-family,Arial,sans-serif);padding:clamp(36px,4vw,56px) 0 24px;font-size:14px;line-height:1.6}
.cuktrust *{box-sizing:border-box}.cuktrust__wrap{max-width:1500px;padding-inline:clamp(24px,5vw,74px);margin:auto}.cuktrust__eyebrow{font-size:11px;font-weight:700;letter-spacing:.18em;color:#52614b;margin:0 0 12px}.cuktrust h2{font-family:var(--font-heading-family,Georgia,serif);font-size:clamp(28px,3vw,42px);line-height:1.15;letter-spacing:-.025em;font-weight:400;margin:0;max-width:900px;text-wrap:balance}.cuktrust a,.cuktrust button{color:inherit}.cuktrust a{text-decoration:none}.cuktrust a:hover,.cuktrust button:hover{text-decoration:underline;text-underline-offset:5px}.cuktrust :is(a,button,summary):focus-visible{outline:2px solid #173d35;outline-offset:4px}.cuktrust__service{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:clamp(20px,3vw,40px);margin-top:28px}.cuktrust__service a{display:flex;flex-direction:column;justify-content:center;gap:7px;min-height:80px;padding:14px 0;border-top:1px solid #c7cbbd}.cuktrust__service small{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#52614b}.cuktrust__service strong{font-size:14px;font-weight:600}.cuktrust__groups{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:32px;margin-top:42px;padding-top:30px;border-top:1px solid #c7cbbd}.cuktrust__groups details{min-width:0}.cuktrust__groups summary{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.12em;cursor:pointer;min-height:44px;display:flex;align-items:center;justify-content:space-between;gap:10px}.cuktrust__groups summary:after{content:'−'}.cuktrust__groups details:not([open]) summary:after{content:'+'}.cuktrust__groups summary::-webkit-details-marker{display:none}.cuktrust__groups ul{list-style:none;margin:0;padding:0}.cuktrust__groups li{margin:0}.cuktrust__groups a,.cuktrust__groups button{display:inline-flex;align-items:center;min-height:44px;text-align:left;overflow-wrap:anywhere}.cuktrust__groups button{border:0;background:none;padding:0;font:inherit;cursor:pointer}.cuktrust__contact{display:flex;flex-wrap:wrap;gap:18px 48px;margin-top:30px;padding-top:22px;border-top:1px solid #c7cbbd}.cuktrust__contact p{margin:0;flex:1 1 220px}.cuktrust__contact strong{display:block;font-size:11px;letter-spacing:.08em;text-transform:uppercase}.cuktrust__contact a{min-height:44px;display:inline-flex;align-items:center;overflow-wrap:anywhere}.cuktrust__business{font-size:12px;color:#40534d;border-top:1px solid #d4d8cd;margin-top:20px;padding-top:20px;max-width:950px}.cuktrust__business p{margin:4px 0}.cuktrust__status{font-size:14px;max-width:720px}.cuktrust__status:empty{display:none}
@media(max-width:749px){.cuktrust__service{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 24px;margin-top:24px}.cuktrust__service a:last-child{grid-column:1/-1}.cuktrust__groups{display:block;margin-top:28px;padding-top:8px}.cuktrust__groups details{border-bottom:1px solid #d4d8cd;padding:8px 0}.cuktrust__groups summary{min-height:52px}.cuktrust__groups ul{padding-bottom:14px}.cuktrust__groups a,.cuktrust__groups button{min-height:44px;width:100%}.cuktrust__contact{gap:12px}.cuktrust__contact p{flex-basis:100%}}
{% endstylesheet %}
{% javascript %}
(() => {
  document.querySelectorAll('[data-cuk-trust-footer]').forEach(root => {
    if (root.dataset.ready) return;
    root.dataset.ready = 'true';
    const media = matchMedia('(min-width:750px)');
    const adapt = () => root.querySelectorAll('[data-trust-group]').forEach(group => { group.open = media.matches; });
    adapt();
    media.addEventListener('change', adapt);
    root.querySelector('[data-cookie-settings]')?.addEventListener('click', async () => {
      const status = root.querySelector('[data-cookie-status]');
      status.textContent = '';
      try {
        if (typeof window.privacyBanner?.showPreferences !== 'function') throw new Error('UNAVAILABLE');
        await window.privacyBanner.showPreferences();
      } catch {
        status.textContent = root.dataset.cookieUnavailable;
      }
    });
  });
})();
{% endjavascript %}
