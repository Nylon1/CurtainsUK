{% doc %}
  Compact newsletter signup and sample offer entry point for storefront and Design My Home cart.
{% enddoc %}
<dialog class="cuk-welcome" id="cuk-welcome" aria-labelledby="cuk-welcome-title" data-cuk-welcome>
  <button class="cuk-welcome__close" type="button" data-welcome-close aria-label="Close welcome offer">×</button>
  <div class="cuk-welcome__art">
    <img src="{{ 'cuk-home-room-inspiration.webp' | asset_url }}" alt="Soft full-length curtains in a sunlit living room" width="1400" height="700" loading="eager" decoding="async">
    <span>Find your fabric. Feel at home.</span>
  </div>
  <div class="cuk-welcome__body">
    <p class="cuk-welcome__eyebrow">A warm welcome</p>
    <h2 id="cuk-welcome-title"><em>5% off</em> your first order</h2>
    <div data-welcome-form-panel>
      <p class="cuk-welcome__intro">Sign up for your code. Use it on curtains, Roman blinds, cushions and motorised tracks in Design My Home.</p>
      {% form 'customer', id: 'ContactWelcome' %}
        <input type="hidden" name="contact[tags]" value="newsletter,welcome5">
        <label for="cuk-welcome-email">Email address</label>
        <input id="cuk-welcome-email" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" required {% if form.errors %}aria-invalid="true" aria-describedby="cuk-welcome-error"{% endif %}>
        {% if form.errors %}<p class="cuk-welcome__error" id="cuk-welcome-error" role="alert">Please check your email address and try again.</p>{% endif %}
        <button class="cuk-welcome__primary" type="submit">Get my 5% code <span aria-hidden="true">→</span></button>
        {% if form.posted_successfully? %}<span data-welcome-success hidden></span>{% endif %}
      {% endform %}
      <small>By signing up, you agree to receive our emails. Unsubscribe any time. <a href="/policies/privacy-policy">Privacy policy</a>.</small>
    </div>
    <div data-welcome-code-panel hidden>
      <p class="cuk-welcome__intro">Your code is ready. We’ll apply it to your Design My Home cart on this device if no other promotion is in use.</p>
      <div class="cuk-welcome__code"><strong>WELCOME5</strong><button type="button" data-welcome-copy>Copy code</button></div>
      <a class="cuk-welcome__primary" href="/pages/build-my-rooms">Go to my cart <span aria-hidden="true">→</span></a>
    </div>
    <div class="cuk-welcome__samples">
      <span class="cuk-welcome__samples-icon" aria-hidden="true">✦</span>
      <div>
        <strong>Want to feel the fabric first?</strong>
        <p>Order samples for a personal <strong>10% code</strong>. Eligible sample costs can also be credited towards made-to-measure curtains.</p>
        <a href="/pages/fabric-library?view=browse-fabrics">Explore fabrics and samples <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <details class="cuk-welcome__details"><summary>Offer details</summary><p>Use one percentage code per order: WELCOME5 or your personal sample 10% code. The personal offer needs a £150 product order and is sent after eligible samples are delivered. Sample credit has separate rules, applies to curtains only, and can be used with either code. Delivery is excluded from discounts.</p></details>
  </div>
</dialog>
