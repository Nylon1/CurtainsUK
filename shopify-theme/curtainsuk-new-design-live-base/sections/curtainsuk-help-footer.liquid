{% stylesheet %}
.cukservice { background:#f8f6ef; color:#173d35; font-family:var(--font-body-family); padding:clamp(36px,4vw,56px) 0 16px; }
.cukservice *, .cukservice *::before, .cukservice *::after { box-sizing:border-box; }
.cukservice__wrap { max-width:1500px; padding-inline:clamp(24px,5vw,74px); margin-inline:auto; }
.cukservice__eyebrow { font-size:11px; font-weight:700; line-height:1.6; letter-spacing:.18em; color:#52614b; margin:0 0 12px; }
.cukservice h2 { font-family:var(--font-heading-family); font-size:clamp(28px,3vw,42px); line-height:1.15; letter-spacing:-.025em; font-weight:400; color:#173d35; margin:0; text-wrap:balance; }
.cukservice__routes { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:clamp(20px,3vw,40px); margin-top:28px; }
.cukservice__routes a { display:flex; flex-direction:column; justify-content:center; gap:7px; min-height:80px; padding:14px 0; border-top:1px solid #c7cbbd; text-decoration:none; color:inherit; }
.cukservice__routes span { font-size:11px; line-height:1.5; letter-spacing:.12em; text-transform:uppercase; color:#52614b; }
.cukservice__routes strong { font-size:14px; font-weight:600; line-height:1.6; }
.cukservice__routes i { font-style:normal; margin-left:6px; }
.cukservice a:hover { text-decoration:underline; text-underline-offset:5px; }
.cukservice a:focus-visible { outline:2px solid #173d35; outline-offset:4px; }
.cukservice__contact { border-top:1px solid #d4d8cd; margin-top:22px; padding-top:12px; display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:8px 28px; color:#40534d; font-size:13px; line-height:1.65; }
.cukservice__contact p { margin:0; }
.cukservice__contact p span { display:block; }
.cukservice__contact a { display:inline-flex; align-items:center; min-height:48px; color:inherit; text-underline-offset:4px; overflow-wrap:anywhere; }
@media(max-width:749px) {
  .cukservice__routes { grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px 24px; margin-top:24px; }
  .cukservice__routes a:last-child { grid-column:1/-1; }
  .cukservice__contact { margin-top:16px; gap:4px; }
  .cukservice__contact a { width:100%; }
}
{% endstylesheet %}
