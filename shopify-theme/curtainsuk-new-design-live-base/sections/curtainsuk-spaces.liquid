{{ 'curtainsuk-home-editorial.css' | asset_url | stylesheet_tag }}
{{ 'curtainsuk-spaces.css' | asset_url | stylesheet_tag }}

{%- assign intelligence_url = '/apps/curtainsuk-decision/consultation?experience=premium&entry=match' -%}
<div class="cukfi cukspace">
  <header class="cukspace__hero cukfi__wrap">
    <div class="cukspace__hero-copy">
      <p class="cukfi__eyebrow">Space. Light. Colour.</p>
      <h1>Curtains for<br><em>your space.</em></h1>
      <p class="cukspace__intro">Start with the room. The way the light falls. The colours you live with. Find a curtain direction that brings it all together.</p>
      <a class="cukfi__btn cukspace__button" href="#your-space">Find your space <span aria-hidden="true">↓</span></a>
      <p class="cukspace__hero-note">Considered interiors. Made personal.</p>
    </div>
    <figure class="cukspace__hero-image">
      {{ images['curtainsuk-luxury-sheer-living-room.jpg'] | image_url: width: 1600 | image_tag: widths: '400, 650, 900, 1200, 1600', sizes: '(min-width: 1000px) 52vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: 'Daylight softened by full-height sheer curtains in a pale, textured sitting room' }}
      <figcaption>Light changes everything.</figcaption>
    </figure>
  </header>

  <nav class="cukspace__nav cukfi__wrap" id="your-space" aria-label="Explore your space">
    {% for block in section.blocks %}
      <a href="#space-{{ block.settings.anchor }}"><span class="cukspace__number" aria-hidden="true">0{{ forloop.index }}</span>{{ block.settings.title }}<span aria-hidden="true">↗</span></a>
    {% endfor %}
  </nav>

  <div class="cukfi__wrap cukspace__chapters">
    {% for block in section.blocks %}
      <section id="space-{{ block.settings.anchor }}" class="cukspace__chapter{% cycle '', ' cukspace__chapter--reverse' %}" aria-labelledby="space-title-{{ block.id }}" {{ block.shopify_attributes }}>
        <figure class="cukspace__photo">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1500 | image_tag: widths: '400, 650, 900, 1200, 1500', sizes: '(min-width: 1000px) 52vw, calc(100vw - 48px)', loading: 'lazy', alt: block.settings.image_alt }}
          {% endif %}
          <figcaption><span class="cukspace__number">0{{ forloop.index }}</span>{{ block.settings.caption }}</figcaption>
        </figure>
        <div class="cukspace__chapter-copy">
          <p class="cukfi__eyebrow">{{ block.settings.eyebrow }}</p>
          <h2 id="space-title-{{ block.id }}">{{ block.settings.title }}</h2>
          <p class="cukspace__standfirst">{{ block.settings.lead }}</p>
          <p>{{ block.settings.thinking }}</p>
          <div class="cukspace__consider"><span class="cukfi__eyebrow">A detail to consider</span><p>{{ block.settings.consider }}</p></div>
          <a class="cukspace__link" href="{{ intelligence_url }}">{{ block.settings.cta }} <span aria-hidden="true">→</span></a>
        </div>
      </section>

      {% if forloop.index == 2 %}
        <section class="cukspace__palette" aria-labelledby="space-palette-title">
          <div class="cukspace__palette-heading"><p class="cukfi__eyebrow">A little interior thinking</p><h2 id="space-palette-title">One room.<br><em>More than one direction.</em></h2><p>Your curtains can echo a room, connect its colours, introduce a lighter note or bring deliberate contrast. There is more than one way to belong.</p></div>
          <div class="cukspace__palette-board">
            <p class="cukspace__board-label">An illustrative room palette</p>
            <div class="cukspace__room-colours">
              <div><span class="cukspace__swatch cukspace__swatch--cream"></span><span class="cukfi__eyebrow">Primary</span><strong>Warm cream</strong><small>The foundation</small></div>
              <div><span class="cukspace__swatch cukspace__swatch--olive"></span><span class="cukfi__eyebrow">Secondary</span><strong>Olive</strong><small>A supporting colour</small></div>
              <div><span class="cukspace__swatch cukspace__swatch--ochre"></span><span class="cukfi__eyebrow">Accent</span><strong>Soft ochre</strong><small>A smaller detail</small></div>
            </div>
            <p class="cukspace__board-label cukspace__board-label--next">Four possible curtain relationships</p>
            <div class="cukspace__relationships">
              <div><span class="cukspace__curtain-colour cukspace__swatch--cream" aria-hidden="true"></span><h3>Blend</h3><p>Warm cream echoes the foundation for a quieter, tonal effect.</p></div>
              <div><span class="cukspace__curtain-colour cukspace__swatch--olive" aria-hidden="true"></span><h3>Coordinate</h3><p>Olive carries a supporting colour across the room.</p></div>
              <div><span class="cukspace__curtain-colour cukspace__swatch--ivory" aria-hidden="true"></span><h3>Lift</h3><p>Pale ivory brings a lighter note to the window.</p></div>
              <div><span class="cukspace__curtain-colour cukspace__swatch--plum" aria-hidden="true"></span><h3>Contrast</h3><p>Deep plum introduces a distinct, more expressive focal point.</p></div>
            </div>
            <p class="cukspace__palette-note">Illustrative colours, not a fabric match. Light, texture and finish change how a colour feels in your room.</p>
          </div>
        </section>
      {% endif %}
    {% endfor %}
  </div>

  <section class="cukspace__invitation" aria-labelledby="space-invitation-title">
    <div class="cukfi__wrap cukspace__invitation-inner">
      <div><p class="cukfi__eyebrow">CurtainsUK Fabric Intelligence™</p><h2 id="space-invitation-title">The thinking is here.<br><em>The next room is yours.</em></h2></div>
      <div><p>Fabric Intelligence reads your room’s palette, learns what you’re drawn to and brings it together into your Interior Fabric Brief.</p><p class="cukspace__invitation-small">We find the colours. You tell us what they mean.</p><a class="cukfi__btn cukfi__btn--light" href="{{ intelligence_url }}">Let us read your room <span aria-hidden="true">→</span></a></div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Curtains for your space",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["page"] },
  "max_blocks": 5,
  "settings": [],
  "blocks": [{
    "type": "space",
    "name": "Space",
    "settings": [
      { "type": "text", "id": "anchor", "label": "Section anchor" },
      { "type": "text", "id": "title", "label": "Space title" },
      { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
      { "type": "image_picker", "id": "image", "label": "Interior photograph" },
      { "type": "text", "id": "image_alt", "label": "Image description" },
      { "type": "text", "id": "caption", "label": "Image caption" },
      { "type": "textarea", "id": "lead", "label": "Opening thought" },
      { "type": "textarea", "id": "thinking", "label": "Design thinking" },
      { "type": "textarea", "id": "consider", "label": "Detail to consider" },
      { "type": "text", "id": "cta", "label": "Fabric Intelligence link label" }
    ]
  }]
}
{% endschema %}
