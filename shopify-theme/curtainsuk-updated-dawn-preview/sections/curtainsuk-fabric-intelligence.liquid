{% style %}
.cukfi{--ink:#1d2623;--forest:#18372f;--cream:#f5f1e9;--paper:#fbfaf7;--gold:#a87a46;--line:rgba(29,38,35,.13);background:var(--paper);color:var(--ink);font-family:var(--font-body-family)}
.cukfi *{box-sizing:border-box}.cukfi a{text-decoration:none;color:inherit}.cukfi img{display:block;width:100%;height:100%;object-fit:cover}.cukfi__wrap{max-width:1500px;margin:0 auto;padding:0 clamp(20px,5vw,74px)}.cukfi__eyebrow{font-size:10px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)}.cukfi h1,.cukfi h2,.cukfi h3,.cukfi p{margin:0}.cukfi h1,.cukfi h2{font-family:var(--font-heading-family);font-weight:400}
.cukfi__hero{min-height:690px;display:grid;grid-template-columns:.82fr 1.18fr;background:#2d261e;color:#fff}.cukfi__hero-copy{padding:clamp(70px,8vw,110px) clamp(24px,5vw,72px);display:flex;flex-direction:column;justify-content:center;background:linear-gradient(135deg,#2e261e,#18372f)}.cukfi__hero .cukfi__eyebrow{color:#e2c18d}.cukfi h1{font-size:clamp(54px,6.5vw,96px);line-height:.94;letter-spacing:-.05em;margin-top:18px}.cukfi__hero p{font-size:clamp(17px,1.8vw,21px);line-height:1.62;color:rgba(255,255,255,.86);max-width:650px;margin-top:24px}.cukfi__hero-media{position:relative;overflow:hidden;background:#d8cdbd}.cukfi__hero-media img{object-position:center}.cukfi__hero-tag{position:absolute;right:5%;top:9%;max-width:160px;font-family:var(--font-heading-family);font-size:28px;line-height:1.06;color:#fff;text-shadow:0 2px 24px rgba(0,0,0,.25)}
.cukfi__buttons{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}.cukfi__btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:13px 24px;border-radius:999px;font-size:13px;font-weight:700}.cukfi__btn--light{background:#f7f2e9;color:var(--forest)!important}.cukfi__btn--outline{border:1px solid rgba(255,255,255,.5);color:#fff!important}.cukfi__promise{background:#f4f0e8;border-bottom:1px solid var(--line)}.cukfi__promise-grid{display:grid;grid-template-columns:repeat(4,1fr)}.cukfi__promise article{padding:24px 20px;border-right:1px solid var(--line)}.cukfi__promise article:last-child{border-right:0}.cukfi__promise strong{font-size:13px}.cukfi__promise p{font-size:11px;line-height:1.5;color:#6b7771;margin-top:5px}
.cukfi__section{padding:clamp(72px,8vw,116px) 0}.cukfi__split{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}.cukfi__copy h2,.cukfi__head h2,.cukfi__cta h2{font-size:clamp(40px,5vw,68px);line-height:1;letter-spacing:-.04em;margin-top:14px}.cukfi__copy p,.cukfi__head p,.cukfi__cta p{font-size:16px;line-height:1.75;color:#62706a;margin-top:20px;max-width:700px}.cukfi__fabric-stack{min-height:430px;position:relative;background:#ded2c1}.cukfi__fabric-stack img{object-position:center}.cukfi__fabric-note{position:absolute;right:4%;bottom:5%;background:rgba(250,247,241,.92);padding:22px 24px;max-width:190px;font-family:var(--font-heading-family);font-size:26px;line-height:1.12}
.cukfi__head{text-align:center;max-width:900px;margin:0 auto}.cukfi__head p{margin-left:auto;margin-right:auto}.cukfi__aspects{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;margin:42px auto 0}.cukfi__aspect{min-width:0;display:flex;flex-direction:column}.cukfi__aspect-media{height:188px;flex-shrink:0;overflow:hidden;background:#e8e1d5}.cukfi__aspect-body{padding-top:14px;display:flex;flex-direction:column;flex:1}.cukfi__aspect h3{font-size:16px;font-weight:650}.cukfi__aspect p{font-size:12px;line-height:1.55;color:#68766f;margin-top:6px}.cukfi__aspect-link{display:inline-block;align-self:flex-start;margin-top:auto;padding-top:10px;font-size:10px;font-weight:700;border-bottom:1px solid currentColor}.cukfi__palette{display:flex;gap:5px;margin-top:9px}.cukfi__dot{width:18px;height:18px;border-radius:50%;border:1px solid rgba(29,38,35,.16)}.c1{background:#d9c8ac}.c2{background:#b7ae9d}.c3{background:#6d6558}.c4{background:#c9ccb7}.c5{background:#8e957c}.c6{background:#4d5d4c}.c7{background:#a65f47}.c8{background:#37484c}
.cukfi__dark{background:var(--forest);color:#fff}.cukfi__dark .cukfi__eyebrow{color:#e4bd83}.cukfi__dark .cukfi__head p{color:rgba(255,255,255,.68)}.cukfi__directions{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-top:40px}.cukfi__direction-media{height:260px;overflow:hidden;background:#29473e}.cukfi__direction-body{padding-top:15px}.cukfi__direction h3{font-family:var(--font-heading-family);font-size:24px;font-weight:400}.cukfi__direction p{font-size:12px;line-height:1.55;color:rgba(255,255,255,.68);margin-top:7px}
.cukfi__system{background:#ebe4d9}.cukfi__system-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}.cukfi__panel{background:#f8f5ef;padding:34px}.cukfi__panel h3{font-family:var(--font-heading-family);font-size:31px;font-weight:400}.cukfi__panel>p{font-size:13px;line-height:1.6;color:#66746e;margin-top:9px}.cukfi__signal{display:grid;grid-template-columns:110px 1fr;gap:18px;align-items:center;padding:18px 0;border-bottom:1px solid var(--line)}.cukfi__signal:first-of-type{margin-top:16px}.cukfi__signal strong{font-size:11px;text-transform:uppercase;letter-spacing:.1em}.cukfi__chips{display:flex;gap:6px;flex-wrap:wrap}.cukfi__chip{font-size:10px;padding:7px 10px;border:1px solid var(--line);border-radius:999px;background:#fff}.cukfi__system-copy h2{font-size:clamp(42px,5vw,68px);line-height:1;letter-spacing:-.04em}.cukfi__system-copy p{font-size:16px;line-height:1.75;color:#5e7068;margin-top:20px}.cukfi__flow{display:grid;grid-template-columns:repeat(4,1fr);margin-top:35px;border-top:1px solid var(--line)}.cukfi__flow article{padding:20px 12px 0 0}.cukfi__flow span{font-size:9px;letter-spacing:.14em;color:var(--gold)}.cukfi__flow strong{display:block;font-size:12px;margin-top:6px}
.cukfi__cta{position:relative;background:#193a31;color:#fff;overflow:hidden}.cukfi__cta-grid{display:grid;grid-template-columns:.8fr 1.2fr;min-height:410px}.cukfi__cta-copy{padding:clamp(55px,7vw,90px) clamp(24px,5vw,72px);display:flex;flex-direction:column;justify-content:center}.cukfi__cta .cukfi__eyebrow{color:#e3be85}.cukfi__cta p{color:rgba(255,255,255,.76)}.cukfi__cta-media{min-height:340px}.cukfi__cta .cukfi__btn{margin-top:24px;background:#f7f2e9;color:var(--forest)!important;width:max-content}.cukfi__no-apex{display:none}
@media(max-width:1050px){.cukfi__hero,.cukfi__split,.cukfi__system-grid,.cukfi__cta-grid{grid-template-columns:1fr}.cukfi__hero-media{min-height:520px}.cukfi__aspects{grid-template-columns:repeat(5,minmax(0,1fr))}.cukfi__directions{grid-template-columns:repeat(2,1fr)}.cukfi__direction:first-child{grid-column:1/3}.cukfi__promise-grid{grid-template-columns:repeat(2,1fr)}.cukfi__cta-media{order:-1}}
@media(max-width:640px){.cukfi__hero{min-height:auto}.cukfi h1{font-size:52px}.cukfi__hero-media{min-height:430px}.cukfi__hero-tag{font-size:22px}.cukfi__promise-grid{grid-template-columns:1fr 1fr}.cukfi__promise article:nth-child(2){border-right:0}.cukfi__aspects{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;margin-left:-20px;margin-right:-20px;padding:0 20px}.cukfi__aspect{flex:0 0 68vw;scroll-snap-align:center}.cukfi__aspect-media{height:230px}.cukfi__directions{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;margin-left:-20px;margin-right:-20px;padding:0 20px}.cukfi__direction{flex:0 0 80vw;scroll-snap-align:center}.cukfi__direction:first-child{grid-column:auto}.cukfi__signal{grid-template-columns:1fr}.cukfi__flow{grid-template-columns:1fr 1fr}.cukfi__fabric-stack{min-height:340px}}
{% endstyle %}
<section class="cukfi" id="fabric-intelligence">
  <div class="cukfi__hero">
    <div class="cukfi__hero-copy"><div class="cukfi__eyebrow">CurtainsUK Fabric Intelligence™</div><h1>Beautiful curtains for real homes.</h1><p>Share your room and our intelligence brings together colour, light, furnishings, pattern, texture and architecture to create a considered fabric edit — made for your space.</p><div class="cukfi__buttons"><a class="cukfi__btn cukfi__btn--light" href="/apps/curtainsuk-decision/consultation?entry=match">Let’s read my room →</a><a class="cukfi__btn cukfi__btn--outline" href="/collections/all">Explore fabrics</a></div></div>
    <div class="cukfi__hero-media"><img src="https://cdn.shopify.com/s/files/1/0256/4551/4861/files/cukfi-hero-room.jpg" alt="Elegant living room with made-to-measure curtains"><div class="cukfi__hero-tag">More than curtains. A more beautiful room.</div></div>
  </div>
  <div class="cukfi__promise"><div class="cukfi__wrap cukfi__promise-grid"><article><strong>Share your room</strong><p>A simple photo is enough.</p></article><article><strong>We read the details</strong><p>Colour, light, furnishings and more.</p></article><article><strong>Your curated edit</strong><p>Fabrics that belong in your room.</p></article><article><strong>Made for your home</strong><p>Sample, measure and move to made to measure.</p></article></div></div>
  <div class="cukfi__section"><div class="cukfi__wrap cukfi__split"><div class="cukfi__copy"><div class="cukfi__eyebrow">Interiors led. Intelligence powered.</div><h2>A more intelligent way to choose your curtains.</h2><p>Curtains don’t sit in isolation. They work with your colours, furniture, flooring, lighting and the architecture of your space. Fabric Intelligence helps us understand the full picture before suggesting fabrics that truly belong.</p><div class="cukfi__buttons"><a class="cukfi__btn" style="border:1px solid var(--line)" href="#what-we-consider">How it works →</a></div></div><div class="cukfi__fabric-stack"><img src="https://cdn.shopify.com/s/files/1/0256/4551/4861/files/curtainsuk-fabric-moodboard.jpg?v=1789452157" alt="Interior fabric and colour moodboard"><div class="cukfi__fabric-note">Right fabric. Brighter rooms.</div></div></div></div>
  {% render 'curtainsuk-three-ways' %}
  <div class="cukfi__section" id="what-we-consider"><div class="cukfi__wrap"><div class="cukfi__head"><div class="cukfi__eyebrow">What we consider in your room</div><h2>Every detail shapes the perfect curtain.</h2><p>Our Fabric Intelligence looks at the key elements of your space, so your curtains feel like a natural part of your home.</p></div><div class="cukfi__aspects">
    <article class="cukfi__aspect"><div class="cukfi__aspect-media"><img src="https://cdn.shopify.com/s/files/1/0256/4551/4861/files/cukfi-primary.jpg" alt="Primary colour palette"></div><div class="cukfi__aspect-body"><h3>Primary colour</h3><p>The dominant tones in your room.</p><div class="cukfi__palette"><i class="cukfi__dot c1"></i><i class="cukfi__dot c2"></i><i class="cukfi__dot c3"></i></div><a class="cukfi__aspect-link" href="/apps/curtainsuk-decision/consultation?entry=match">Use my room →</a></div></article>
    <article class="cukfi__aspect"><div class="cukfi__aspect-media"><img src="https://cdn.shopify.com/s/files/1/0256/4551/4861/files/cukfi-secondary.jpg" alt="Secondary fabric colour"></div><div class="cukfi__aspect-body"><h3>Secondary colour</h3><p>The supporting shades that balance the space.</p><div class="cukfi__palette"><i class="cukfi__dot c4"></i><i class="cukfi__dot c5"></i><i class="cukfi__dot c6"></i></div><a class="cukfi__aspect-link" href="/apps/curtainsuk-decision/consultation?entry=match">Use my room →</a></div></article>
    <article class="cukfi__aspect"><div class="cukfi__aspect-media"><img src="https://cdn.shopify.com/s/files/1/0256/4551/4861/files/cukfi-accent.jpg" alt="Accent colour in furnishings"></div><div class="cukfi__aspect-body"><h3>Accent colour</h3><p>The details that add depth and interest.</p><div class="cukfi__palette"><i class="cukfi__dot c7"></i><i class="cukfi__dot c8"></i><i class="cukfi__dot c6"></i></div><a class="cukfi__aspect-link" href="/apps/curtainsuk-decision/consultation?entry=match">Use my room →</a></div></article>
    <article class="cukfi__aspect"><div class="cukfi__aspect-media"><img src="https://cdn.shopify.com/s/files/1/0256/4551/4861/files/cukfi-light.jpg" alt="Natural light through curtains"></div><div class="cukfi__aspect-body"><h3>Natural light</h3><p>How daylight changes the mood and colour.</p><a class="cukfi__aspect-link" href="/apps/curtainsuk-decision/consultation?entry=match">Use my room →</a></div></article>
    <article class="cukfi__aspect"><div class="cukfi__aspect-media"><img src="https://cdn.shopify.com/s/files/1/0256/4551/4861/files/curtainsuk-card5-replacement.jpg?v=1789454219" alt="Blue patterned curtains beside a window seat" width="1536" height="1536"></div><div class="cukfi__aspect-body"><h3>Pattern &amp; texture</h3><p>We balance pattern, texture and scale against the rest of your interior, so the finished room feels considered rather than busy.</p><a class="cukfi__aspect-link" href="/apps/curtainsuk-decision/consultation?entry=match">Use my room →</a></div></article>
  </div></div></div>
  {% render 'curtainsuk-colour-intelligence' %}
</section>
